                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/system"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/depolyedOnPlatform"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/platform"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/ssn/deploymentRelatedProcess -->

    <owl:Class rdf:about="http://www.w3.org/ns/ssn/deploymentRelatedProcess">
