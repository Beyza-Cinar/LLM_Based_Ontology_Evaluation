        <rdfs:seeAlso>MedDRA: 10001052</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0035222</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000261 -->

