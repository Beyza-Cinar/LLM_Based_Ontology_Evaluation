                                <swrl:propertyPredicate rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/Meal.correctionInsulinUnits"/>
                                <swrl:argument1 rdf:resource="urn:swrl#meal"/>
                                <swrl:argument2 rdf:resource="urn:swrl#n1"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
