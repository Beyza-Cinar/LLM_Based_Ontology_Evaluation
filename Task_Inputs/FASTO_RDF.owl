    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>a vascular disorder AE that results in a condition affecting the aorta and aortic valves</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
