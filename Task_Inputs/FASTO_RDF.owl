        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that results in the outcome of a tumor.</purl:Definition>
        <obo1:IAO_0000118>mass AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>nodule AE</obo1:IAO_0000118>
