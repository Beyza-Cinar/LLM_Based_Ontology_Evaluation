    <!-- http://purl.obolibrary.org/obo/OAE_0000281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002122"/>
