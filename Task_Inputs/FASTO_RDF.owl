    <!-- http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#granularity -->

    <owl:Class rdf:about="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#granularity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2006/time#TIME:0000002"/>
    </owl:Class>
    


    <!-- http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validInstant -->

    <owl:Class rdf:about="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validInstant">
        <rdfs:subClassOf rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validTime"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasDay"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasHour"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasMinute"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasMonth"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasYear"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validPeriod -->

    <owl:Class rdf:about="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validPeriod">
        <rdfs:subClassOf rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#validTime"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasFinishTime"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://swrl.stanford.edu/ontologies/built-ins/3.3/temporal.owl#hasStartTime"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


