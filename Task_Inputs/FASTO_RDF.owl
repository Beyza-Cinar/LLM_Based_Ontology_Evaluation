        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>neurotoxicity</obo1:IAO_0000118>
        <rdfs:label>drug-induced neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000166 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Tremor AE is a behavior and neurological AE that has an outcome of an involuntary trembling or quivering, and muscle contraction and relaxation.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/tremor.html</obo1:IAO_0000119>
        <rdfs:label>tremor AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001337</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10044565</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0040822</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000167 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000167">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>a neuropathy AE which shows symptoms due to the damage to the autonomic nerves. This damage disrupts signals between the brain and portions of the autonomic nervous system, such as the heart, blood vessels and sweat glands. This can cause decreased or abnormal performance of one or more involuntary body functions.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/autonomic-neuropathy/basics/definition/con-20029053</obo1:IAO_0000119>
        <rdfs:label>autonomic neuropathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002270</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10061666</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0259749</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000168 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>a peripheral neuropathy AE which is caused by a damage to motor neurons</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>motor neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000169">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>A peripheral neuropathy AE which is characterized by damage to more than one nerve</purl:Definition>
        <obo1:IAO_0000117>AG, YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merckmanuals.com/home/brain_spinal_cord_and_nerve_disorders/peripheral_nerve_disorders/polyneuropathy.html</obo1:IAO_0000119>
        <rdfs:label>polyneuropathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001271</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10036105</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0152025</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>a neuropathy AE which is characterized by isolated damage of a single nerve</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>mononeuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10062203</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <purl:Definition>a peripheral neuropathy AE which affects extremities, such as, toes, fingers, hand and feet.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>axonal neuropathy AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.livestrong.com/article/184686-distal-neuropathy-symptoms/</obo1:IAO_0000119>
        <rdfs:label>distal neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE that affects the neuronal cell body</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3922643/</obo1:IAO_0000119>
        <rdfs:label>neuronopathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <purl:Definition>A neuritis AE which has an outcome of mononeuritis characterized by isolated inflammation of one nerve.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>mononeuritis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10027910</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <purl:Definition>A neuritis AE  which has an outcome of polyneuritis characterized by isolated inflammation of many nerves.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>polyneuritis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000173"/>
        <purl:Definition>a mononeuritis AE which has an outcome of mononeuritis multiplex which  involves damage to at least two seperate unrelated nerve area.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>mononeuritis multiplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE which has an outcome of acute sensory neuropathy  that is characterized by rapid onset</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>acute sensory neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000179">
