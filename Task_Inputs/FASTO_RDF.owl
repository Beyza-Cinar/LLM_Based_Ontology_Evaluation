        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.owl-ontologies.com/GI_Low">
        <swrla:isRuleEnabled rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</swrla:isRuleEnabled>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.owl-ontologies.com/GI_Medium">
