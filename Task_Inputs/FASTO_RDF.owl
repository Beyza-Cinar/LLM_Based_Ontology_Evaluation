            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.code"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.dataAbsentReason"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.interpretation"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.referenceRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/ObservationReferenceRangeComponent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueCodeableConcept"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueDateTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valuePeriod"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueQuantity"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001719"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/range"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueRatio"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/ratio"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueString"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.component.valueTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/time"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/ObservationReferenceRangeComponent -->

    <owl:Class rdf:about="http://hl7.org/fhir/ObservationReferenceRangeComponent">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/observationValueQuality"/>
