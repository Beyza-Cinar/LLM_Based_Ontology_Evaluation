        <rdfs:seeAlso>MedDRA: 10005739</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0277889</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001740 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <purl:Definition>a hypertension AE that has an outcome of an increase in the amount of pressure the heart generates when pumping blood through arteries to the rest of the body</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/hypertension-high-blood-pressure/guide/diastolic-and-systolic-blood-pressure-know-your-numbers</obo1:IAO_0000119>
