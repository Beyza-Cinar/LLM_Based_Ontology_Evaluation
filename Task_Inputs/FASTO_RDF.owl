        <purl:Definition>Short-time increased blood sugar AE is a blood glucose level increased AE that shows a short-time increased glucose level in blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>短暂血糖升高</obo1:OAE_0001849>
        <rdfs:label>short-time increased blood sugar AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002318">
