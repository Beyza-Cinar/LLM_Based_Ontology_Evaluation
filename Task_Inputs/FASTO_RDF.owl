        <obo1:OAE_0001849>持续头痛</obo1:OAE_0001849>
        <rdfs:label>persistent headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002330 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Proarrhythmic effect AE is an arrhythmia AE that is a new or more frequent occurrence of pre-existing arrhythmias, paradoxically precipitated by antiarrhythmic therapy, which means it is a side effect associated with the administration of some existing antiarrhythmic drugs, as well as drugs for other indications. In other words, it is a tendency of antiarrhythmic drugs to facilitate emergence of new arrhythmias.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>arhythmia auxo-action AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Proarrhythmia</obo1:IAO_0000119>
        <obo1:OAE_0001849>致心律失常</obo1:OAE_0001849>
        <rdfs:label>proarrhythmic effect AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036766</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000069"/>
        <purl:Definition>a metabolism, endocrine, and exocrine system AE that has an outcome of acidosis, i.e.,  too much acid in the body fluids. </purl:Definition>
        <obo1:IAO_0000118>Blood pH Decreased </obo1:IAO_0000118>
        <obo1:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/001181.htm</obo1:IAO_0000119>
        <dc:creator>YH, SJ</dc:creator>
        <rdfs:label xml:lang="en">acidosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10000486</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005706</rdfs:seeAlso>
    </owl:Class>
    


