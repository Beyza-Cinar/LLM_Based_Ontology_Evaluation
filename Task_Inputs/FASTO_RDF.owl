    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/carePlanQuality"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/exerciseContradicteWithDrug"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000011"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/physicalExercise.code"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#exerciseContradicteWithDisease"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/physicalExerciseType"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:oneOf>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                        <rdf:first>notPlanned</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
                                                <rdf:first>planned</rdf:first>
                                                <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </owl:oneOf>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasCompendiumCode"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasDescription"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
