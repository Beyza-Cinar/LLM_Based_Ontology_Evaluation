                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.location.location"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/ssn/location"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.location.period"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
