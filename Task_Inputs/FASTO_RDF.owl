                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Attachment.creation"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Attachment.data"/>
