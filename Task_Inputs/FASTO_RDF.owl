                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/ssn/bloodGlucose"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/hasProperty"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/ssn/bloodPressure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>At least four blood glucose readings per day</rdfs:comment>
    </owl:Class>
    


