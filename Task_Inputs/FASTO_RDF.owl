        <rdfs:seeAlso>MedDRA: 10001029</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0155919</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <purl:Definition>a respiratory distress AE that has an outcome of a life-threatening lung condition that prevents enough oxygen from getting to the lungs and into the blood</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001164/</obo1:IAO_0000119>
