                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.activity.detail"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/carePlanActivityDetailComponent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.activity.outcomeCodeableConcept"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.activity.reference"/>
