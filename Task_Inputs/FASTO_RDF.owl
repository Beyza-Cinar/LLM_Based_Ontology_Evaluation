    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
