        <rdfs:domain rdf:resource="http://www.w3.org/ns/ssn/observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/sensingDevice"/>
        <rdfs:comment>points to a sensor which produced the observation (an instance of the class ssn:Sensor).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/observedProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/observedProperty">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/sensor_related_property"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/ssn/observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/observableProperty"/>
        <rdfs:comment>points to the specific quality (properties in the ontology are qualities that can be observed by a sensor; qualities, on the other hand, can also abstract, qualities of abstract things, or in some other way not able to be sensed) of the feature of interest which was observed (e.g., temperature, acceleration, or speed).</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/observes -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/observes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/sensor_related_property"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/ssn/sensor"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/observableProperty"/>
        <rdfs:comment>points to a property observed by a sensor (e.g., temperature, acceleration, wind speed). An object of this property must be an instance of the class ssn:Property</rdfs:comment>
    </owl:ObjectProperty>
    


