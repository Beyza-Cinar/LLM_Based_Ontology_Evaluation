    <!-- http://purl.obolibrary.org/obo/OAE_0002084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a behavior and neurological AE which has an outcome of impaired driving ability</purl:Definition>
