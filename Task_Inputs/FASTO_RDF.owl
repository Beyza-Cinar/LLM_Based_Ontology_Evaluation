                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.assertedDate"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.category"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.clinicalStatus"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/clinicalStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.code"/>
