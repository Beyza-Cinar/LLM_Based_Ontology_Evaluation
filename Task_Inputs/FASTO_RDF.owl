        <purl:Definition>Significant and persistent rise of serum transaminase AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase significantly and persistently.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血清氨基转移酶显著和持续性升高</obo1:OAE_0001849>
        <rdfs:label>significant and persistent rise of serum transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002320 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002320">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001467"/>
        <purl:Definition>Elevated serum transaminase reversibility AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase reversibly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血清氨基转移酶可逆性升高</obo1:OAE_0001849>
        <rdfs:label>elevated serum transaminase reversibility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002321 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000529"/>
        <purl:Definition>Reversible increased creatine phosphokinase AE is a blood creatine phosphokinase level increased AE that  is characterized by an reversible increased level of creatine phosphokinase or phosphocreatine kinase.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>肌酸磷酸激酶可逆性升高</obo1:OAE_0001849>
        <rdfs:label>reversible increased creatine phosphokinase AE</rdfs:label>
    </owl:Class>
    


