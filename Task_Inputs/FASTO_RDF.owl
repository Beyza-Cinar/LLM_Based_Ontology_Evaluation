        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>skin warm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000048 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000048">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Nystagmus AE is an eye AE that is a condition of involuntary eye movement, acquired in infancy or later in life, that may result in reduced or limited vision. Due to the involuntary movement of the eye, it is often called &quot;dancing eyes&quot;.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nystagmus</obo1:IAO_0000119>
        <rdfs:label>nystagmus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029864</rdfs:seeAlso>
        <rdfs:seeAlso>眼球震颤</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000049 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000049">
