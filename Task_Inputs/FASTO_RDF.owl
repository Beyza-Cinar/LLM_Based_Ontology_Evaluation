        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/OGMS_0000031"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#OGMS_0000020"/>
        <obo1:IAO_0000115>A relation that holds between a disease or an organism and a phenotype</obo1:IAO_0000115>
