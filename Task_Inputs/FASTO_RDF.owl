        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0000087"/>
        <obo1:IAO_0000115>a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence</obo1:IAO_0000115>
        <rdfs:label>role_of</rdfs:label>
    </owl:ObjectProperty>
    


