        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.status"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/planStatus"/>
