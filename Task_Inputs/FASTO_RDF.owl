    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001467"/>
        <purl:Definition>Persistent and significant increase of serum transaminase AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase significantly and persistently.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血清转氨酶显著和持续性升高</obo1:OAE_0001849>
        <rdfs:label>persistent and significant increase of serum transaminase AE</rdfs:label>
    </owl:Class>
    


