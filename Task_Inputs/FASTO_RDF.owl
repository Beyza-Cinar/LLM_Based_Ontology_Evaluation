        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000552"/>
        <purl:Definition>Heart beat skip AE is a irregular heartbeat AE which is sometimes called as either heart palpitation, or premature atrial or ventricular contraction are very common occurrences. They may or may not be accompanied by heart conditions or heart problems.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://ehealthwall.com/heart-skips-a-beat-causes-symptoms-treatment/</obo1:IAO_0000119>
        <obo1:OAE_0001849>漏跳</obo1:OAE_0001849>
        <rdfs:label>heart beat skip AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002192 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002192">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001030"/>
        <purl:Definition>Fatal liver cell necrosis AE is a hepatic necrosis AE that has an outcome of fatal liver cell necrosis.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>致命性肝细胞坏死</obo1:OAE_0001849>
        <rdfs:label>fatal liver cell necrosis AE</rdfs:label>
    </owl:Class>
    


