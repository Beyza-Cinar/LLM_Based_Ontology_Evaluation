                                        <swrl:propertyPredicate rdf:resource="http://hl7.org/fhir/hasValue"/>
                                        <swrl:argument1 rdf:resource="urn:swrl#supp_type_coding_display"/>
                                        <swrl:argument2>basal metabolic rate (observable entity)</swrl:argument2>
                                    </rdf:Description>
                                </rdf:first>
