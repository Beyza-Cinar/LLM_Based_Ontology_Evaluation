                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.subject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                    </owl:Restriction>
