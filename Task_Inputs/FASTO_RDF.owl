        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <purl:Definition>Pulmonary tuberculosis AE is a lung disorder AE that is a contagious bacterial infection that involves the lungs. It may spread to other organs.</purl:Definition>
