    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>A tumor AE that shows a tumor occuring in the gastrointestinal tract.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
