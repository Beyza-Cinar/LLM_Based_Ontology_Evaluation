    <!-- http://purl.obolibrary.org/obo/OAE_0002092 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002092">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a behavior and neurological AE which has an outcome of decreased grip strength, or a reduction in the force applied by the hand to pull on or suspend from objects</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.krepublishers.com/02-Journals/JLS/JLS-01-0-000-09-Web/JLS-01-1-000-09-Abst-PDF/JLS-01-01-057-09-020-Koley-S/JLS-01-01-057-09-020-Koley-S-Tt.pdf</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">grip strength decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062556</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002093 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002093">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <purl:Definition>an eye AE with the outcome of eyelid margin crusting</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">eyelid margin crusting AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10052132</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002094 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition xml:lang="en">an ear AE with the outcome of ear discomfort, an uncomfortable or painful feeling in the ear</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/discomfort</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">ear discomfort AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10052137</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <purl:Definition xml:lang="en">an abnormal defecation AE that has an outcome of fecal incontinence, the accidental passing of solid or liquid stool or mucus from the rectum</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://digestive.niddk.nih.gov/ddiseases/pubs/fecalincontinence/#what</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">fecal incontinence AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016092</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002096 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002096">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of fear, which is to be afraid and/or worried</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/fear</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">fear AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016275</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002097 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of pain in gums</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/gingival</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">gingival pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018286</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <purl:Definition>a tongue disorder with the outcome of glossitis, a condition in which the tongue is swollen and changes color, which may make the tongue appear smooth</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001053.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">glossitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018386</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <purl:Definition>an injury AE which has an outcome of muscle injury</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">muscle injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028314</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of sensory disturbance</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">sensory disturbance AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040026</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002101 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002101">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE with an outcome of tracheal edema, which is the swelling of the airway between the throat and the lungs</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://firstaidcalgary.ca/causes-of-tracheal-edema/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">tracheal edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044296</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Allergic eruption AE is a skin AE that is most drug-induced cutaneous reactions, especially found in younger adults. Sometimes also be diagnosed with eczema.</purl:Definition>
        <obo1:IAO_0000116>This term appears to be a synonym to the &apos;eczema AE&apos;.</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>过敏性皮疹</obo1:OAE_0001849>
        <rdfs:label>allergic eruption AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Erythrodermia AE is a skin AE that is an inflammatory skin disease with erythema and scaling that affects nearly the entire cutaneous surface.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>dermatitis exfoliativa AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>exfoliative dermatitis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>red man syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythroderma</obo1:IAO_0000119>
        <obo1:OAE_0001849>红皮病</obo1:OAE_0001849>
        <rdfs:label>erythrodermia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037165</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <purl:Definition>Mycotic dermatitis is a dermatitis AE that is a inflammation of skin which induced by mycetes.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>真菌性皮炎</obo1:OAE_0001849>
        <rdfs:label>mycotic dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Peritendinitis symptom AE is an inflammation AE that has an outcome of inflammation of the synovial lining of a tendon sheath. Causes include trauma, tendon stress, bacterial disease (gonorrhea, tuberculosis), rheumatic disease, and gout. Common sites are the hand, wrist, shoulder capsule, hip capsule, hamstring muscles, and Achilles tendon. The tendon sheaths become inflamed and painful, and accumulate fluid. Joint mobility is usually reduced.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>腱鞘炎样症状</obo1:OAE_0001849>
        <rdfs:label>peritendinitis symptom AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Orthostatic hypotension AE is a hypotension AE that is a form of hypotension in which a person&apos;s blood pressure falls when suddenly standing up or stretching. In medical terms, it is defined as a fall in systolic blood pressure of at least 20 mm Hg or diastolic blood pressure of at least 10 mm Hg when a person assumes a standing position.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>orthostasis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>postural hypotension AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Orthostatic_hypotension</obo1:IAO_0000119>
        <obo1:OAE_0001849>直立性低血压</obo1:OAE_0001849>
        <rdfs:label>orthostatic hypotension AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031127</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>chromatopsia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://ghr.nlm.nih.gov/condition/color-vision-deficiency</obo1:IAO_0000119>
        <obo1:OAE_0001849>色视力缺乏</obo1:OAE_0001849>
        <rdfs:comment>Color vision deficiency AE is an abnormal vision AE that is a group of conditions that affect the perception of color. They cause a range of changes in color vision, from mild difficulty with distinguishing shades to a total inability to detect color. These conditions are divided into three major categories: red-green color vision defects, blue-yellow color vision defects, and a complete absence of color vision.</rdfs:comment>
        <rdfs:label>color vision deficiency AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002108 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>Carcinogenesis AE is a tumor AE that is literally the &apos;creation&apos; of cancer. It is a process by which normal cells are transformed into cancer cells.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>oncogenesis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>tumorigenesis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Carcinogenesis</obo1:IAO_0000119>
        <obo1:OAE_0001849>致癌</obo1:OAE_0001849>
        <rdfs:label>carcinogenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002109 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002109">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002118"/>
        <purl:Definition>an anaphylaxis AE that is associated with systemic vasodilation that causes low blood pressure which is by definition 30% lower than the person&apos;s baseline or below standard values.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Anaphylaxis</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://smschile.cl/documentos/cursos2010/MedicalClinicsNorthAmerica/Acute%20Symptoms%20of%20Drug%20Hypersensitivity%20%28Urticaria,%20Angioedema,%20Anaphylaxis,%20Anaphylactic%20Shock%29.pdf</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=10092</obo1:IAO_0000119>
        <obo1:OAE_0001849>过敏性休克</obo1:OAE_0001849>
        <rdfs:label>anaphylactic shock AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002199</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002110 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>Pituitary adenomas AE is a tumor AE that is a tumor which occur in the pituitary gland. Pituitary adenomas are generally divided into three categories dependent upon their biological functioning: benign adenoma, invasive adenoma, and carcinomas, with carcinomas accounting for 0.1% to 0.2%, approximately 35% being invasive adenomas and most being benign adenomas. Pituitary adenomas represent from 10% to 25% of all intracranial neoplasms and the estimated prevalence rate in the general population is approximately 17%.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pituitary_adenoma</obo1:IAO_0000119>
        <rdfs:label>pituitary adenomas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002111 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>Fatty infiltration AE is an embolism AE that shows the abnormal accumulation of fat droplets in the cytoplasm of cells.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://dictionary.reference.com/browse/fatty+infiltration</obo1:IAO_0000119>
        <obo1:OAE_0001849>脂肪侵润</obo1:OAE_0001849>
        <rdfs:label>fatty infiltration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <purl:Definition>Epigastric discomfort is a discomfort AE that shows discomfort in the upper central region of the abdomen.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>upper Abdominal discomfort AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/epigastric_discomfort.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>上腹部不适</obo1:OAE_0001849>
        <rdfs:label>epigastric discomfort AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053155</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>Acute intravascular hemolysis AE is a cardiovascular AE that has an outcome of disruption of red blood cells occurs while they are within blood vessels.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>急性血管内溶血</obo1:OAE_0001849>
        <rdfs:label>acute intravascular hemolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000210"/>
        <purl:Definition>Allergic hepatitis AE is a hepatitis AE that is a tissue-specific inflammatory diease caused by hepersensitivity to a particular drug, accomopanied by a systemic allergic reaction such as eosinophilia.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/viral+hepatitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>过敏性肝炎</obo1:OAE_0001849>
        <rdfs:label>allergic hepatitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10071198</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002115 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002115">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000300"/>
        <purl:Definition>Paranoid anxiety AE is a anxiety AE that is a term used in object relations theory, particularity in discussions about the Paranoid-schizoid and depressive positions. The term was frequently used by Melanie Klein, especially to refer to a pre-depressive and persecutory sense of anxiety characterised by the psychological splitting of objects.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Paranoid_anxiety</obo1:IAO_0000119>
        <obo1:OAE_0001849>偏执性焦虑</obo1:OAE_0001849>
        <rdfs:label>paranoid anxietas AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000480"/>
        <purl:Definition>Thrombotic thrombocytopenic purpura AE is a thrombocytopenic purpura AE that is a rare disorder of the blood-coagulation system, causing extensive microscopic clots to form in the small blood vessels throughout the body.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>moschcowitz syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Thrombotic_thrombocytopenic_purpura</obo1:IAO_0000119>
        <obo1:OAE_0001849>血栓性血小板减少性紫癜</obo1:OAE_0001849>
        <rdfs:label>thrombotic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043648</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002117 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002117">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Glaucoma AE is an eye AE that is a term describing a group of ocular (eye) disorders resulting in optic nerve damage or loss to the field of vision, in many patients caused by a clinically characterized pressure buildup in regards to the fluid of the eye (intraocular pressure-associated optic neuropathy).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glaucoma</obo1:IAO_0000119>
        <obo1:OAE_0001849>青光眼</obo1:OAE_0001849>
        <rdfs:label>glaucoma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018304</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <purl:Definition>an allergy AE that shows a serious allergic reaction that is rapid in onset and may cause death. It typically causes a number of symptoms including an itchy rash, throat swelling, and low blood pressure. Common causes include insect bites and stings, foods, and medications.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Anaphylaxis</obo1:IAO_0000119>
        <obo1:OAE_0001849>过敏症</obo1:OAE_0001849>
        <rdfs:label>anaphylaxis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002218</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002119 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002119">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <purl:Definition>an allergy AE which occur during certain times of the year, usually when outdoor molds release their spores, and trees, grasses, and weeds release tiny pollen particles into the air to fertilize other plants.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://kidshealth.org/parent/medical/allergies/seasonal_allergies.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>季节性变态反应</obo1:OAE_0001849>
        <rdfs:label>seasonal allergy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048908</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002121 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002121">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <purl:Definition>Skin redness AE is an erythema AE that is abnormal redness of the skin, often signaling a pathological condition, such as inflammation, infection, or sunburn.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/skin-redness</obo1:IAO_0000119>
        <obo1:OAE_0001849>皮肤发红</obo1:OAE_0001849>
        <rdfs:label>skin redness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE that shows the symptom of a chest pain.</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>chest pain AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>tight chest AE</obo1:IAO_0000118>
