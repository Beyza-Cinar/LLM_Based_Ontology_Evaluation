        <obo1:IAO_0000117>SZ, SS, YH</obo1:IAO_0000117>
        <rdfs:label>senile dementia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039966</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
