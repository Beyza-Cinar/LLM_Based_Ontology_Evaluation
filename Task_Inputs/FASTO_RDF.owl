        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/hasMeasurementCapability"/>
                        <owl:hasValue rdf:resource="https://bioportal.bioontology.org/ontologies/fhir.owl#glucoseLevelMeasurementCapability_1"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/ns/ssn/observes"/>
                        <owl:hasValue rdf:resource="http://www.w3.org/ns/ssn/glucoseProperty_1"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#bloodPressureSensor"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#bodyTempratureSensor"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#distanceSensor"/>
                </owl:unionOf>
            </owl:Class>
        </owl:disjointWith>
    </owl:Class>
    


