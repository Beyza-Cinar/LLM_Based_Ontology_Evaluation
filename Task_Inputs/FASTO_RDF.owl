                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.detailCodeableConcept"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.detailQuantity"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001719"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.detailRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/range"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.dueDate"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/date"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.dueDuration"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/duration"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target.measure"/>
                <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


