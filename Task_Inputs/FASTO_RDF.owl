        <rdfs:seeAlso>MedDRA: 10020947</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020598</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE in which the levels of carbon dioxide in the blood is lower than normal</purl:Definition>
