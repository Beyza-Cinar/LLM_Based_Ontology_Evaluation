    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <purl:Definition>a congenital abnormality AE with an outcome of defective development or congenital absense of an organ or tissue</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/737831</obo1:IAO_0000119>
