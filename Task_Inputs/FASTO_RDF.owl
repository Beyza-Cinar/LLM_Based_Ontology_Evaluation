    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#patientProfile -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#patientProfile">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#PATO:0001995"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasEncounter"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/encounter"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasObservationValue"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/observationValue"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#hasPatientMedication"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/medicationStatement"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#hasSymptom"/>
                        <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/ssn/condition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasAdverseEvent"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/adverseEvent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasPreviousCarePlan"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasRecommendedDrug"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000011"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/hasTiming"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/timing"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasForbiddenExercise"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasNotPreferredExercise"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasPreferredExercise"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/hasRecommendedExercise"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#physicalExercise"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#hasComplication"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/condition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#hasForbiddenDrug"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000011"/>
                    </owl:Restriction>
