        <rdfs:domain rdf:resource="http://www.w3.org/ns/ssn/sensorOutput"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/ssn/sensingDevice"/>
        <rdfs:comment>points to a sensor which produced the output (an instance of the class ssn:Sensor).</rdfs:comment>
    </owl:ObjectProperty>
    


