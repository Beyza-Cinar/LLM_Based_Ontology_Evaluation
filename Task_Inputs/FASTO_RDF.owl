                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Medication.ingredient.itemReference"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000011"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
