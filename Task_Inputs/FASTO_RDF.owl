        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0002502"/>
        <rdfs:label>inheres_in_part_of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0002452 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#RO_0002452">
