    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <purl:Definition>Increased tendency of biliary calculus AE is a liver, biliary, and pancreatic AE that shows an increased tendency of biliary calculus.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>胆石增加的趋势</obo1:OAE_0001849>
