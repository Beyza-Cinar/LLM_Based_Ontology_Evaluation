                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Identifier.system"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/uri"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Identifier.type"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Identifier.use"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/code"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Identifier.value"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
