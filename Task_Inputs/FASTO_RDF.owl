    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abasia</obo1:IAO_0000119>
        <rdfs:comment>a movement disorder AE that has an outcome of abasia, a movement disorder that results in and inability to walk due to impaired muscle coordination</rdfs:comment>
