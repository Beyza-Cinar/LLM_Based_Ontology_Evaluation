        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>chills and fever AE</obo1:IAO_0000118>
        <rdfs:label>fever with chills AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016559</rdfs:seeAlso>
    </owl:Class>
    


