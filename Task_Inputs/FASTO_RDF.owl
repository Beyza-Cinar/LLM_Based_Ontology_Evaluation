                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.lastOccurrence"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.reaction.exposureRoute"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.reaction.manifestation"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.reaction.onset"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.reaction.severity"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/severityCode"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.reaction.substance"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.recorder"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/practitioner"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.type"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/allergyIntoleranceType"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.onsetAge"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.onsetDateTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.onsetPeriod"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.onsetRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/range"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/AllergyIntolerance.onsetString"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>AllergyIntolerance.verificationStatus= confirmed</rdfs:comment>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/allergyIntoleranceCategory -->

