    <!-- http://purl.obolibrary.org/obo/OAE_0002070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE that has an outcome of spinal column stenosis, or narrowing of spaces in the spine that results in pressure on the spinal cord and/or nerve roots</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.niams.nih.gov/Health_Info/Spinal_Stenosis/</obo1:IAO_0000119>
