        <obo1:IAO_0000117>SZ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/wound+dehiscence</obo1:IAO_0000119>
        <rdfs:label>wound dehiscence AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048031</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001519 -->

