        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000402"/>
        <purl:Definition>an abdominal pain AE that is observed in lower stomach</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
