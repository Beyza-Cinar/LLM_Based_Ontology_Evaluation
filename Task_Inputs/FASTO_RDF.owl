    <!-- http://purl.obolibrary.org/obo/DDO.owl#DDO_0009987 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009987">
        <rdfs:subPropertyOf rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#FASTOOntologyProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000031"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000045"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <obo1:IAO_0000115>The &quot;finding site&quot; specifies the body site affected by a condition.</obo1:IAO_0000115>
        <rdfs:label>finding_site</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#DDO_0009988 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009988">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009996"/>
        <obo1:IAO_0000115>The &quot;Due to&quot; relates a disease or disorder directly to a cause such as another disease or disorder</obo1:IAO_0000115>
        <rdfs:label>due_to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#DDO_0009989 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009989">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009996"/>
        <obo1:IAO_0000115>The &quot;Causative agent&quot; relationship identifies the direct cause of the disorder. The causative agent is the bacterium, virus, toxin or environmental agent that causes the disorder.</obo1:IAO_0000115>
        <rdfs:label>causative_agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#DDO_0009996 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009996">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000031"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000045"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000031"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OGMS_0000045"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo1:IAO_0000115>The &quot;Associated with&quot; represents a clinically relevant association between concepts without either asserting or excluding a causal or sequential relationship between the two.</obo1:IAO_0000115>
        <rdfs:label>associated_with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#DDO_0009997 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009997">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009996"/>
        <obo1:IAO_0000115>The &quot;After&quot; represents a sequence of events where a disease or disorder occurs after another one.</obo1:IAO_0000115>
        <rdfs:label>after</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0000052 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#RO_0000052">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0002314"/>
        <obo1:IAO_0000115>a relation between a specifically dependent continuant (the dependent) and an independent continuant (the bearer), in which the dependent specifically depends on the bearer for its existence</obo1:IAO_0000115>
        <rdfs:label>inheres_in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0000053 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#RO_0000053">
        <obo1:IAO_0000115>a relation between an independent continuant (the bearer) and a specifically dependent continuant (the dependent), in which the dependent specifically depends on the bearer for its existence</obo1:IAO_0000115>
        <rdfs:label>bearer_of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0000085 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#RO_0000085">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0000053"/>
        <obo1:IAO_0000115>a relation between an independent continuant (the bearer) and a function, in which the function specifically depends on the bearer for its existence</obo1:IAO_0000115>
        <rdfs:label>has_function</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0000086 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/DDO.owl#RO_0000086">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0000053"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/DDO_0006288"/>
