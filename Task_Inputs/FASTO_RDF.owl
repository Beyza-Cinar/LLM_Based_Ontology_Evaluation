                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.careTeam"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#careTeam"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.category"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.context"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#patientProfile"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.dailyPerMealGlucoseLevel.goal"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.goal"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.partOf"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.period"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.replaces"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                    </owl:Restriction>
