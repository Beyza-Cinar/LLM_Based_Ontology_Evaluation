    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#familyMemberHistory -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#familyMemberHistory">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000182"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.age"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.bornDate"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/date"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.condition.code"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.condition.outcome"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.date"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.deceasedBoolean"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/boolean"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.gender"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/genderCode"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.name"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.notDone"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/boolean"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.patient"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.relationship"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.condition.onsetAge"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.condition.onsetPeriod"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/FamilyMemberHistory.condition.onsetRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/range"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>This class records significant health events and conditions for a particular individual related to the subject. This information can be known to different levels of accuracy. Sometimes the exact condition (&apos;asthma&apos;) is known, and sometimes it is less precise (&apos;some sort of cancer&apos;). Equally, sometimes the person can be identified (&apos;my aunt Agatha&apos;) and sometimes all that is known is that the person was an uncle.</rdfs:comment>
    </owl:Class>
    


