        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>muscle AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in liver, biliary, and pancreatic areas.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>liver, biliary, and pancreatic AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition>a liver/biliary system AE which has an outcome of an enlarged liver, or larger than average size of the liver</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;hepatomegaly&apos; was mentioned in 106 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>enlarged liver AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000599</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE which has an outcome of meningitis, a medical condition caused by inflammation of the protective membranes covering the brain and spinal cord, known collectively as the meninges. The inflammation is caused by infection with viruses, bacteria, or other microorganisms, and less commonly by certain drugs or diseases.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>meningitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001287</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10027199</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0025289</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in digestive system.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>digestive system AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <purl:Definition>a paralysis AE that has an outcome of paralysis in face</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;facial paralysis&apos; was mentioned in 580 VAERS reports (0.5%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>facial paralysis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007209</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015469</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of confusion, which is a mild form of delirium.</purl:Definition>
        <obo1:IAO_0000117>YH, KM</obo1:IAO_0000117>
        <obo1:IAO_0000118>confused state</obo1:IAO_0000118>
        <obo1:IAO_0000118>mental confusion</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/mental+confusion</obo1:IAO_0000119>
        <rdfs:label>confusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010305</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000442 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000442">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE which has an outcome of joint disorder</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>joint disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in eye.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>eye disorder AE</obo1:IAO_0000118>
        <rdfs:label>eye AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000496</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015916</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015397</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of autism</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Autism is a brain development disorder characterized by impaired social interaction and communication, and by restricted and repetitive behavior.</obo1:IAO_0000118>
        <rdfs:label>autism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE which has an outcome of sedimentation rate increased</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;sedimentation rate increased&apos; is an adverse event that was mentioned in 530 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000116>This term should be inferred to lab test abnormal.</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>ESR</obo1:IAO_0000118>
        <obo1:IAO_0000118>erythrocyte sedimentation rate</obo1:IAO_0000118>
        <obo1:IAO_0000118>red blood cell sedimentation rate increased AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>sedrate</obo1:IAO_0000118>
        <rdfs:comment>Sedimentation rate is a diagnostic test for inflammation. The test measures the rate at which red blood cells fall to the bottom of a tube over time. An increased sedimentation rate corresponds to increased non-specific inflammation in the body. It is often called &quot;sedrate&quot; for short.</rdfs:comment>
        <rdfs:comment>red blood cell sedimentation rate increased AE is an AE: sedimentation rate increased that has an increase in rate at which red blood cells precipitate in a period of 1 hour.</rdfs:comment>
        <rdfs:label>sedimentation rate increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>an arthritis AE that has an outcome of arthritis due to an infection in another part of the body</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/16822921</obo1:IAO_0000119>
        <rdfs:label>arthritis reactive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003267</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <purl:Definition>an abnormal vision AE which has an outcome of amblyopia</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>amblyopia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000646</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10001906</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002418</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>a mental disorder AE that has an outcome of mental retardation</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>mental retardation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001249</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0025362</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE which has an outcome of erythema multiforme, which is local accumulation of fluid, plasma proteins, and leukocytes in the brain</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>brain inflammation</obo1:IAO_0000118>
        <rdfs:label>erythema multiforme AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010783</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015218</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0014742</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001694"/>
        <purl:Definition>a lab test abnormal AE that has an outcome of SGOT increased</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;SGOT increased&apos; is an adverse event that was mentioned in 477 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>SGOT respresents serum glutamic oxaloacetic transaminase, an enzyme that is normally present in liver and heart cells. SGOT is released into blood when the liver or heart is damaged. The blood SGOT levels are thus elevated with liver damage (for example, from viral hepatitis) or with an insult to the heart (for example, from a heart attack). Some medications can also raise SGOT levels. SGOT is also called aspartate aminotransferase (AST).</rdfs:comment>
        <rdfs:label>SGOT increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001694"/>
        <purl:Definition>a lab test abnormal AE that has an outcome of SGPT increased</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;SGPT increased&apos; is an adverse event that was mentioned in 459 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>SGPT represents serum glutamic pyruvic transaminase, an enzyme that is normally present in liver and heart cells. SGPT is released into blood when the liver or heart are damaged. The blood SGPT levels are thus elevated with liver damage (for example, from viral hepatitis) or with an insult to the heart (for example, from a heart attack). Some medications can also raise SGPT levels. SGPT is also called alanine aminotransferase (ALT).</rdfs:comment>
        <rdfs:label>SGPT increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of thinking abnormality</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;thinking abnormality&apos; is an adverse event that was mentioned in 457 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>thinking abnormality AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043431</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000554"/>
        <purl:Definition>an abnormal digestion AE which has an outcome of dyspepsia</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;dyspepsia&apos; is an adverse event that was mentioned in 454 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Dyspepsia is popularly known as indigestion, meaning hard or difficult digestion. It is a medical condition characterized by chronic or recurrent pain in the upper abdomen, upper abdominal fullness and feeling full earlier than expected when eating.</rdfs:comment>
        <rdfs:label>dyspepsia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002577</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10013946</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10013946</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013395</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <purl:Definition>an allergy AE which has an outcome of anaphylactoid reaction AE is an acute systemic (multi-system) and very severe Type I Hypersensitivity allergic reaction in humans and other mammals. Minute amounts of allergens may cause a life-threatening anaphylactic reaction.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;anaphylactoid reaction&apos; was mentioned in 452 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/22293078</obo1:IAO_0000119>
        <rdfs:label>anaphylactoid reaction AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100845</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10002216</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002198</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0340865</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of a gastrointestinal disorder</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;gastrointestinal disorder&apos; is an adverse event that was mentioned in 449 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>gastrointestinal disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011024</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0017178</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE that has an outcome of accumulation of fluid in the peritoneal cavity</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/23296107</obo1:IAO_0000119>
        <rdfs:label>ascites AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001541</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003445</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003962</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <purl:Definition>a hypersensitivity AE which has an outcome of serum sickness</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;serum sickness&apos; is an adverse event that was mentioned in 428 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Serum sickness is a reaction to proteins in antiserum derived from an animal source. It is a type of hypersensitivity, specifically immune complex hypersensitivity (type III).</rdfs:comment>
        <rdfs:label>serum sickness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000458 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000458">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <purl:Definition>an abscess AE which has an outcome of injection-site abscess</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>injection-site abscess AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001643"/>
        <purl:Definition>a neurological, special senses and psychiatric investigation result abnormal AE that is the abnormal result of a procedure that uses small, flat metal discs (electrodes) attached to your scalp to detect electrical activity in your brain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;abnormal electroencephalogram&apos; is an adverse event that was mentioned in 420 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.com/health/eeg/MY00296</obo1:IAO_0000119>
        <rdfs:label>abnormal electroencephalogram result AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10000130</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000460 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <purl:Definition>a dizziness AE that has an outcome of vertigo</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;vertigo&apos; was mentioned in 412 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Vertigo is a specific type of dizziness, a major symptom of a balance disorder. It is the sensation of spinning or swaying while the body is actually stationary with respect to the surroundings. The effects of vertigo may be slight. It can cause nausea and vomiting and, in severe cases, it may give rise to difficulties with standing and walking.</rdfs:comment>
        <rdfs:label>vertigo AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002321</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10047340</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042571</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000461 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE that has an outcome of heartarrest. Heart arrest is the abrupt cessation of normal circulation of the blood due to failure of the heart to contract effectively during systole.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>asystole</obo1:IAO_0000118>
        <obo1:IAO_0000118>cardiac arrest</obo1:IAO_0000118>
        <obo1:IAO_0000118>cardiopulmonary arrest</obo1:IAO_0000118>
        <obo1:IAO_0000118>circulatory arrest</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Myocardial_infarction</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/cardiac+arrest</obo1:IAO_0000119>
        <rdfs:label>heart arrest AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007515</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10007617</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10028596</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000564"/>
        <purl:Definition>a respiratory system inflammation AE which has an outcome of bronchitis</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Bronchitis is an inflammation of the air passages within the lungs. It occurs when the trachea (windpipe) and the large and small bronchi (airways) within the lungs become inflamed because of infection or other causes.</rdfs:comment>
        <rdfs:label>bronchitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002837</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0006277</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>a seizure AE that has an outcome of grand malconvulsion</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>A generalized seizure disorder characterized by recurrent major motor seizures. The initial brief tonic phase is marked by trunk flexion followed by diffuse extension of the trunk and extremities. The clonic phase features rhythmic flexor contractions of the trunk and limbs, pupillary dilation, elevations of blood pressure and pulse, urinary incontinence, and tongue biting. This is followed by a profound state of depressed consciousness (post-ictal state) which gradually improves over minutes to hours. The disorder may be cryptogenic, familial, or symptomatic (caused by an identified disease process).</rdfs:comment>
        <rdfs:label>grand malconvulsion AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition xml:lang="en">a liver/biliary system AE which has an outcome of liver function tests abnormal, which is aberrant function of this bile-secreting exocrine gland, which is important for detoxification; for fat, carbohydrate, and protein metabolism; and for glycogen storage</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;liver function tests abnormal&apos; was mentioned in 717 VAERS reports (0.6%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hepatic+function</obo1:IAO_0000119>
        <rdfs:label>liver function tests abnormal AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000609</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10019670</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10024690</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in ear.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>ear disorder AE</obo1:IAO_0000118>
        <rdfs:label>ear  AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000598</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013447</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection AE that results in detrimental colonization of a host organism by virus</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>viral infection</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Viral_infection</obo1:IAO_0000119>
        <rdfs:label>viral infection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005364</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042769</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000467 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of lacrimation disorder</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;lacrimation disorder&apos; was mentioned in 334 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Lacrimation is the production, secretion, and shedding of tears.</rdfs:comment>
        <rdfs:label>lacrimation disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition>a liver/biliary system AE which has an outcome of jaundice, which is the clinical manifestation of hyperbilirubinemia, with deposition of bile pigments in the skin, resulting in yellowish staining of the skin and mucous membranes</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;jaundice&apos; is an adverse event that was mentioned in 317 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>icterus AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Jaundice</obo1:IAO_0000119>
        <rdfs:label>jaundice AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000952</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000611</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10023126</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10023126</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0022346</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>an immune system disorder AE which shows an enclosed collection of liquefied tissue, known as pus, somewhere in the body. Abscess is the result of the body&apos;s defensive reaction to foreign material.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>abscessus</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/abscess</obo1:IAO_0000119>
        <rdfs:comment>An abscess is a collection of pus (dead neutrophils) that has accumulated in a cavity formed by the tissue on the basis of an infectious process (usually caused by bacteria or parasites) or other foreign materials (e.g. splinters, bullet wounds, or injecting needles). It is a defensive reaction of the tissue to prevent the spread of infectious materials to other parts of the body.</rdfs:comment>
        <rdfs:label>abscess AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002722</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000269</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0000833</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of eye pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;eye pain&apos; is an adverse event that was mentioned in 316 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>eye pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0200025</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015958</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151827</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of palpitation</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Palpitations</obo1:IAO_0000119>
        <rdfs:comment>A palpitation is an abnormal awareness of the beating of the heart, whether it is too slow, too fast, irregular, or at its normal frequency.</rdfs:comment>
        <rdfs:label>palpitation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10033557</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE which has an outcome of tongue edema</purl:Definition>
        <obo1:IAO_0000117>YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000118>tongue oedema AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>tongue swelling AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medterms.com/script/main/art.asp?articlekey=97582</obo1:IAO_0000119>
        <rdfs:label>tongue edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10042727</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of ear pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;ear pain&apos; was mentioned in 302 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>ear pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010833</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013456</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE which has an outcome of angioedema</purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>angioneurotic edema </obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/hives-and-angioedema/basics/definition/con-20014815
</obo1:IAO_0000119>
        <rdfs:comment>Angioedema is the rapid swelling (edema) of the dermis, subcutaneous tissue, mucosa and submucosal tissues often around the eyes and lips. It is very similar to urticaria, but urticaria, commonly known as hives, occurs in the upper dermis.</rdfs:comment>
        <rdfs:label>angioedema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002473</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>An arthritis AE that has the outcome of rheumatoid arthritis. Rheumatoid arthritis is an autoimmune disease that causes chronic inflammation of the joints and may also cause inflammation of the tissue around the joints, as well as other organs in the body.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>rheumatoid arthritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005681</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003873</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000476 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000476">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in immune system.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;immune system disorder&apos; was mentioned in 292 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>immune system disorder AE</obo1:IAO_0000118>
        <rdfs:label>immune system AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002715</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0021053</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>an immune system disorder AE which has an outcome of antinuclear antibody present</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;antinuclear antibody present&apos;; is an adverse event that was mentioned in 288 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>anti-nuclear factor present</obo1:IAO_0000118>
        <rdfs:comment>The presence of anti-nuclear antibodies (ANAs) that are antibodies directed against contents of the cell nucleus. ANAs are present in higher than normal numbers in autoimmune disease. The ANA test measures the pattern and amount of autoantibody which can attack the body&apos;s tissues as if they were foreign material. Autoantibodies are present in low titers in the general population, but in about 5% of the population, their concentration is increased, and about half of this 5% have an autoimmune disease.</rdfs:comment>
        <rdfs:label>antinuclear antibody present AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000478 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE which involves inflammation of the spinal cord, which disrupts central nervous system functions linking the brain and limbs.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>myelitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <purl:Definition>a headache AE that has an outcome of migraine</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;migraine&apos;; is an adverse event that was mentioned in 267 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>migraine headache</obo1:IAO_0000118>
        <rdfs:comment>A migraine is a very painful type of headache. People who get migraines often describe the pain as pulsing or throbbing in one area of the head. During migraines, people are very sensitive to light and sound. They may also become nauseated and vomit.</rdfs:comment>
        <rdfs:label>migraine AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002076</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0149931</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <purl:Definition>Thrombocytopenic purpura AE are purpura AE associated with a reduction in circulating blood platelets which can result from a variety of causes.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;thrombocytopenic purpura&apos;; is an adverse event that was mentioned in 267 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004829</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10043561</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0857305</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>multiple sclerosis AE is an immune system disorder AE, or an autoimmune condition in which the immune system attacks the central nervous system, leading to demyelination.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>MS</obo1:IAO_0000118>
        <obo1:IAO_0000118>disseminated sclerosis</obo1:IAO_0000118>
        <obo1:IAO_0000118>encephalomyelitis disseminata</obo1:IAO_0000118>
        <rdfs:label>multiple sclerosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10028245</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of amnesia in a patient</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Amnesia is a short term memory condition in which memory is disturbed. In simple terms it is the loss of memory.</rdfs:comment>
        <rdfs:label>amnesia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002354</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10001949</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002622</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000483 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of incoordination</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;incoordination&apos; was mentioned in 261 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>a lack of normal adjustment of muscular action so that the intended movement of the limb or other part is not made smoothly and harmoniously, and does not accurately achieve its objective. If the abnormality is hypermetric, the condition is referred to as ataxia. If it is inclined to weakness, e.g. knuckling at the turn, stumbling, failure to flex limbs properly, or to misdirection as in a proprioceptive deficit, it is called incoordination.</rdfs:comment>
        <rdfs:label>incoordination AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000484 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <purl:Definition>a speech disorder that has an outcome of voice alteration</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>voice alteration AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <purl:Definition>a pregnancy AE that is the termination of a pregnancyby the removal or expulsion from the uterus of a fetus or embryo, resulting in or caused by its death.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;abortion&apos;; is an adverse event that was mentioned in 257 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abortion</obo1:IAO_0000119>
        <rdfs:label>abortion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10000210</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>a mental disorder AE that has an outcome of shock</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute stress disorder AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>acute stress reaction AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>mental shock AE</obo1:IAO_0000118>
        <rdfs:comment>Mental shock (or shock) is a psychological condition arising in response to a terrifying event. It should not be confused with the unrelated circulatory condition of shock.</rdfs:comment>
        <rdfs:comment>There are two types of shocks. Another is circulatory shock which is physiological with MedDRA ID of 10040560.</rdfs:comment>
        <rdfs:label>psychological shock AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10001084</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition>a skin discoloration AE which has an outcome of purpura</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;purpura&apos;; is an adverse event that was mentioned in 251 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Purpura is the appearance of red or purple discolorations on the skin that do not blanch on applying pressure. They are caused by bleeding underneath the skin. This is common with typhus and can be present with meningitis caused by meningococcal meningitis or septicaemia. Reference: http://en.wikipedia.org/wiki/Purpura.</rdfs:comment>
        <rdfs:label>purpura AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000979</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10037549</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0034150</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection AE that results in detrimental colonization of a host organism by bacteria</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>bacterial infection AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bacterial_infection</obo1:IAO_0000119>
        <rdfs:label>bacterial infection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002718</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10060945</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004623</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event that has an outcome of skin striae that displays irregular areas of skin that look like bands, stripes, or lines. Striae are seen when a person grows or gains weight rapidly or has certain diseases or conditions.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;skin striae&apos;; is an adverse event that was mentioned in 247 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>stretch marks</obo1:IAO_0000118>
        <obo1:IAO_0000118>striae distensae</obo1:IAO_0000118>
        <rdfs:label>skin striae AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001065</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0152459</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>a syndrome AE that has an outcome of an acute brain syndrome AE and occurs after a medical intervention.  </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>acute brain syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of coma</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Coma is a profound state of unconsciousness. A comatose person cannot be awakened, fails to respond normally to pain or light, does not have sleep-wake cycles, and does not take voluntary actions.</rdfs:comment>
        <rdfs:label>coma AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001259</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10010071</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0009421</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>a muscle adverse event which has an outcome of hyperkinesia, an abnormal increase in muscular activity.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>hyperkinesia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002487</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10020651</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0424295</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in cardiovascular system.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cardiovascular disorder AE</obo1:IAO_0000118>
        <rdfs:label>cardiovascular AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001626</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10007649</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007222</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE which has an outcome of encephalopathy, which is disorder or disease of the brain.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>encephalopathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007239</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10014625</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085584</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000495 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000495">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition>a urinary system AE that has an outcome of urine abnormality AE</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>urine abnormality AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011036</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0235639</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <purl:Definition>a gastrointestinal disorder AE which has an outcome of gastroenteritis, an inflammation occuring in the gastrointestinal tract that involves both the stomach and the small intestine, often results in diarrhea, vomiting and abdominal pain and cramping</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;gastroenteritis&apos; was mentioned in 218 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/gastroenteritis</obo1:IAO_0000119>
        <rdfs:label>gastroenteritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004386</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10017888</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0017160</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that has an outcome of peripheral vascular disorder</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>peripheral vascular disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005299</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085096</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition>a urinary system AE that has an outcome of urnary tract infection AE</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>urinary tract infection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000094</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042029</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000511"/>
        <purl:Definition>an abnormal salivary gland physiology AE which has an outcome of increased salivation, meaning greater than normal amounts of flowing saliva</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;increased salivation&apos; is an adverse event that was mentioned in 336 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>increased salivation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000622</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of depression. Depression causes a persistent feeling of sadness and loss of interest. </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/depression/basics/definition/con-20032977</obo1:IAO_0000119>
        <rdfs:label>depression AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000716</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10012378</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011570</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000583"/>
        <purl:Definition>a glucose homeostasis AE which has an outcome of diabetes mellitus</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>diabetes AE</obo1:IAO_0000118>
        <rdfs:comment>Diabetes mellitus, often referred to simply as diabetes, is a syndrome of disordered metabolism, usually due to a combination of hereditary and environmental causes, resulting in abnormally high blood sugar levels (hyperglycemia).</rdfs:comment>
        <rdfs:label>diabetes mellitus AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000819</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10012601</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011849</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000564"/>
        <purl:Definition>a respiratory system inflammation AE which has an outcome of laryngitis</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;laryngitis&apos;; is an adverse event that was mentioned in 190 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Laryngitis is an inflammation of the larynx. It causes hoarse voice or the complete loss of the voice because of irritation to the vocal folds (vocal cords).</rdfs:comment>
        <rdfs:label>laryngitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001600</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0023067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000503 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <purl:Definition>a muscle spasm AE which has an outcome of generalized spasm, which is an involuntary contraction of a muscle or group of muscles. Spasms may involve skeletal muscle (MUSCLE, SKELETAL) or smooth muscle (MUSCLE, SMOOTH).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>generalized spasm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;reflexes decreased&apos;; is an adverse event that was mentioned in 178 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hyporeflexia AE</obo1:IAO_0000118>
        <rdfs:comment>a movement disorder AE that has an outcome of reflexes decreased, an abnormal  decrease in an involuntary response to a peripheral stimulus</rdfs:comment>
        <rdfs:label>reflexes decreased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of dry mouth, which is dryness of the mouth resulting from reduced salivary secretion</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;dry mouth&apos;; is an adverse event that was mentioned in 171 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>xerostomia</obo1:IAO_0000118>
        <rdfs:label>dry mouth AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000217</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10013781</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0043352</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000625"/>
        <purl:Definition>a neuritis AE which has an outcome of optic neuritis</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>optic neuritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100653</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10030942</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0029134</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that has an outcome of thrombocythemia</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Thrombocythemia (primary thrombocythemia) is a disorder in which excess platelets are produced, leading to abnormal blood clotting or bleeding.</rdfs:comment>
        <rdfs:label>thrombocythemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of epistaxis</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>nosebleed</obo1:IAO_0000118>
        <rdfs:comment>Epistaxis is the relatively common occurrence of hemorrhage from the nose, usually noticed when the blood drains out through the nostrils.</rdfs:comment>
        <rdfs:label>epistaxis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000421</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015090</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10015090</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0014591</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000509 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>a syndrome AE that displays a lupus syndrome. Lupus is an autoimmune disease where the body&apos;s immune system becomes hyperactive and attacks normal, healthy tissue. This results in symptoms such as inflammation, swelling, and damage to joints, skin, kidneys, blood, the heart, and lungs.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>狼疮样综合征</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medicalnewstoday.com/info/lupus/</obo1:IAO_0000119>
        <rdfs:label>lupus syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye disorder AE which has an outcome of photophobia</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Photophobia is a symptom of excessive sensitivity to light and the aversion to sunlight or well-lit places. In medical terms it is not fear, but an experience of discomfort or pain to the eyes due to light exposure.</rdfs:comment>
        <rdfs:label>photophobia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000613</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10034960</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000511 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of abnormal salivary gland physiology, which is any functional anomaly of any of the glands in the mouth that secrete saliva</purl:Definition>
        <rdfs:label>abnormal salivary gland physiology AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005310</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000512 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of hallucination</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>A hallucination, in the broadest sense, is a perception in the absence of a stimulus. In a stricter sense, hallucinations are defined as perceptions in a conscious and awake state in the absence of external stimuli which have qualities of real perception, in that they are vivid, substantial, and located in external objective space.</rdfs:comment>
        <rdfs:label>hallucination AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000738</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10019063</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0018524</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000513 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of tongue disorder</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;tongue disorder&apos;; is an adverse event that was mentioned in 156 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>tongue disorder</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000157</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0040409</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of neuralgia</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;neuralgia&apos;; is an adverse event that was mentioned in 155 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Neuralgia or neuropathic pain can be defined most simply as non-nociceptive pain. Neuralgia is pain produced by a change in neurological structure or function. Unlike nociceptive pain, Neuralgia exists with no continuous nociceptive input. Neuralgia falls into two categories: central Neuralgia and peripheral Neuralgia.</rdfs:comment>
        <rdfs:label>neuralgia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003489</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10029223</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0027796</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE which has an outcome of lung edema</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>lung edema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <purl:Definition>a paresthesia AE that occurs around the mouth.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>circumoral paresthesia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003401</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151838</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000517 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000546"/>
        <purl:Definition>an abnormal fluid regulation AE which has an outcome of thirst</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Thirst is the craving for liquids, resulting in the basic instinct of humans or animals to drink. It is an essential mechanism involved in fluid balance.</rdfs:comment>
        <rdfs:label>thirst AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001959</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10043458</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0039971</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE which has an outcome of bone disorder</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>bone disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000924</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005956</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0005940</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000232"/>
        <purl:Definition>a perinatal AE that displays fetal disorder.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>fetal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of emotional liability</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>emotional liability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition xml:lang="en">a muscle adverse event which has an outcome of muscle spasm, which is an involuntary and often painful muscle contraction or cramps having a number of causes ranging from nutritional deficiency to serious nervous system conditions</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Spasm</obo1:IAO_0000119>
        <rdfs:label>muscle spasm AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000743</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10028334</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of tendon disorder</purl:Definition>
        <obo1:IAO_0000116>A tendon (or sinew) is a tough band of fibrous connective tissue that usually connects muscle to bone and is capable of withstanding tension.</obo1:IAO_0000116>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;tendon disorder&apos;; is an adverse event that was mentioned in 137 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Tendon disorder is a medical condition that results in a tendon not functioning normally.</rdfs:comment>
        <rdfs:label>tendon disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of hostility</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>hostility AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10020400</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000524 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye disorder AE which has an outcome of visual field defect</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>visual impairment AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Visual_impairment</obo1:IAO_0000119>
        <rdfs:label>visual field defect AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10047555</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047571</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition xml:lang="en">a muscle adverse event which has an outcome of myopathy AE, an abnormal condition or disease of the skeletal muscle</purl:Definition>
        <rdfs:label>myopathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003198</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000751</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028641</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10028641</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026848</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of apathy state</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>impassivity</obo1:IAO_0000118>
        <obo1:IAO_0000118>perfunctoriness</obo1:IAO_0000118>
        <rdfs:comment>Apathy is a state of indifference, or the suppression of emotions such as concern, excitement, motivation and passion. An apathetic individual has an absence of interest or concern to emotional, social, or physical life. They may also exhibit an insensibility or sluggishness.</rdfs:comment>
        <rdfs:label>apathy AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000741</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10002942</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085632</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <purl:Definition>a paralysis AE that has an outcome of hemiplegia</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;hemiplegia&apos;; is an adverse event that was mentioned in 129 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Hemiplegia is total paralysis of the arm, leg, and trunk on the same side of the body. Hemiplegia is more severe than hemiparesis, wherein one half of the body is weakened but not paralysed.</rdfs:comment>
        <rdfs:label>hemiplegia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002301</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10019468</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10019468</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0018991</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>Pastular rash AE is a rash AE that is composed of pustular lesions.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;pustular rash&apos;; is an adverse event that was mentioned in 128 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>pustular rash AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037888</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000728"/>
        <purl:Definition>a blood creatine phosphokinase level abnormal AE that is characterized by an increased level of creatine phosphokinase (CPK) or phosphocreatine kinase, an enzyme expressed by various tissue types that catalyses the conversion of creatine and consumes adenosine triphosphate (ATP) to create phosphocreatine and adenosine diphosphate (ADP)</purl:Definition>
        <obo1:IAO_0000117>YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000118>elevated serum creatine phosphate kinase AE</obo1:IAO_0000118>
        <rdfs:label>blood creatine phosphokinase level increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005470</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000530 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000403"/>
        <purl:Definition>a hypertension AE that has an outcome of elevated pressure in the skull.</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ihrfoundation.org/intracranial/hypertension/info/C16</obo1:IAO_0000119>
        <rdfs:label>intracranial hypertension AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049977</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE which shows a painful neuropathy characterized by damage to sensory and motor nerves</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>sensorimotor painful neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000532 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of abnormal stool</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;abnormal stools&apos; was mentioned in 111 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>abnormal stool AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of bone pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;bone pain&apos; was mentioned in 109 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>bone pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002653</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10006002</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10006002</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151825</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that comes with cerebrovascular accident</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>stroke</obo1:IAO_0000118>
        <rdfs:comment>Cerebrovascular accident: The sudden death of some brain cells due to lack of oxygen when the blood flow to the brain is impaired by blockage or rupture of an artery to the brain. A CVA is also referred to as a stroke.</rdfs:comment>
        <rdfs:label>cerebrovascular accident AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001297</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10008190</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0038454</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of parotid gland enlargement</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;parotid gland enlargement&apos; was mentioned in 103 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>parotid gland enlargement AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10034023</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of flatulence</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;flatulence&apos; was mentioned in 102 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Flatulence is the production of a mixture of gases in the digestive tract of mammals or other animals that are byproducts of the digestion process. Such a mixture of gases is known as flatus, and is expelled from the rectum in a process colloquially referred to as &quot;passing gas&quot; or &quot;farting&quot;.</rdfs:comment>
        <rdfs:label>flatulence AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011024</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10016766</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0016204</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000537 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition>a liver/biliary system AE which has an outcome of liver damage</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;liver damage&apos; was mentioned in 102 VAERS reports (&lt;0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>liver damage AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE which has an outcome of sore throat</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>sore throat AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000539 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of paralysis, the loss of power of voluntary movement in a muscle through injury or disease of its nerve supply</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;paralysis&apos; is an adverse event that was mentioned in 574 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hemiplegia, palsy, paraplegia, quadiplegia</obo1:IAO_0000118>
        <rdfs:label>paralysis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010549</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000753</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10033799</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0522224</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000540 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <purl:Definition>a bone disorder AE that has an outcome of cellular death of bone components due to interupption of blood supply</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/avascular+necrosis</obo1:IAO_0000119>
        <rdfs:label>aseptic necrosis bone AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003460</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001644"/>
        <purl:Definition>a physical examination result abnormal AE that has an outcome of weight loss, which is the progressive reduction of body weight below normal average for age</purl:Definition>
        <rdfs:label>weight loss AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001263</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047895</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;ataxia&apos; is an adverse event that was mentioned in 555 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:comment>a movement disorder AE that has an outcome of ataxia, inability to coordinate voluntary muscular movements</rdfs:comment>
        <rdfs:label>ataxia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001251</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001393</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003591</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003591</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004134</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>a hair, skin, and nail AE that occurs in skin.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.thefreedictionary.com/skin+disorder</obo1:IAO_0000119>
        <rdfs:label>skin AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040831</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of unusual or distinctive way of walking</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;abnormal gait&apos; is an adverse event that was mentioned in 998 VAERS reports (0.8%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>gait disturbance AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/21224774</obo1:IAO_0000119>
        <rdfs:label>abnormal gait AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001406</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10017577</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000546"/>
        <purl:Definition>an abnormal fluid regulation AE which has an outcome of dehydration, which is an excessive water loss from the body or from an organ or bodily part</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypohydration</obo1:IAO_0000118>
        <rdfs:label>dehydration AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001944</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001429</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10012174</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10012174</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011175</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition>a homeostasis AE which has an outcome of abnormal fluid regulation, which is any anomaly in the control of intracellular and/or extracellular fluid</purl:Definition>
        <rdfs:label>abnormal fluid regulation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001784</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000583"/>
        <purl:Definition>a glucose homeostasis AE which has an outcome of hyperglycemia, which is an abnormally high concentration of glucose in the blood; generally refers to a pathological state</purl:Definition>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hyperglycemia</obo1:IAO_0000119>
        <rdfs:label>hyperglycemia AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001559</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10020635</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition>a homeostasis AE which has an outcome of abnormal ciculating bilirubin level, which is aberrant concentration in the blood of this yellow heme breakdown product</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;bilirubinemia&apos;; is an adverse event that was mentioned in 221 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>abnormal circulating bilirubin level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001569</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000549 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event that has an outcome of cyanosis, a dark bluish or purple skin discoloration resulting from deficient oxygenation of the blood</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;cyanosis&apos; is an adverse event that was mentioned in 1,804 VAERS reports (1.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>cyanosis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000961</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001575</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10011703</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10011703</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0010520</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE which has an outcome of anemia, which is less than normal levels of red blood cells and/or hemoglobin within red blood cells, or volume of packed red blood cells in the bloodstream, resulting in insufficient oxygenation of tissues and organs</purl:Definition>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001586/</obo1:IAO_0000119>
        <rdfs:label>anemia AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001577</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002034</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000381"/>
        <purl:Definition>an abnormal blood pressure AE that has an outcome of sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states</purl:Definition>
        <obo1:IAO_0000118>blood pressure decreased, low blood pressure</obo1:IAO_0000118>
        <rdfs:label>hypotension AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002615</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001596</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10021097</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005734</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10021097</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020649</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>an arrhythmia AE that has an outcome of uneven timing of heart contraction</purl:Definition>
        <rdfs:label>irregular heartbeat AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of abnormal digestion, which is an altered ability of the mechanical, chemical, and enzymatic processes of the body to convert ingested food into material suitable for assimilation for synthesis of tissues or liberation of energy</purl:Definition>
        <rdfs:label>abnormal digestion AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001664</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in the homeostasis system.</purl:Definition>
        <rdfs:comment>anomaly in the processes involved in the maintenance of an internal equilibrium of various functions and chemical or protein composition of the fluids and tissues</rdfs:comment>
        <rdfs:label>homeostasis AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001764</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000546"/>
        <purl:Definition>an abnormal fluid regulation AE which has an outcome of edema, which is an accumulation of an excessive amount of watery fluid in cells or intercellular tissues</purl:Definition>
        <obo1:IAO_0000118>oedema, swelling, dropsy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Oedema</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Swelling_(medical)</obo1:IAO_0000119>
        <rdfs:label>edema AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001785</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10016807</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10030095</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10042674</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition xml:lang="en">an immune system disorder AE that results in complex biological response of vascular tissues to harmful stimuli, such as pathogens, damaged cells, or irritants. Inflammation is a protective attempt by the organism to remove the injurious stimuli as well as initiate the healing process for the tissue greater than expected response to injury, infection, or insult.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Inflammation</obo1:IAO_0000119>
        <rdfs:label>inflammation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007891</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001846</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10061218</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0021368</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE which has an outcome of brain inflammation, which is local accumulation of fluid, plasma proteins, and leukocytes in the brain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;encephalitis&apos; is an adverse event that was mentioned in 480 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>brain inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001847</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition>an ear disorder AE which has an outcome of increased susceptibility to otitis media, which is greater likelihood of middle ear inflammation, with an accumulation of a thick, mucous-like fluid; usually associated with a viral or bacterial respiratory infection</purl:Definition>
        <rdfs:label>increased susceptibility to otitis media AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001850</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye disorder AE which has an outcome of eye inflammation, which is local accumulation of fluid, plasma proteins, and leukocytes in the eye</purl:Definition>
        <rdfs:label>eye inflammation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100533</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001851</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015943</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0239429</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <purl:Definition>an eye inflammation AE which has an outcome of conjunctivitis, which is inflammation of the mucous membrane that lines the inner surface of the eyelids and the front of the eyeball</purl:Definition>
        <rdfs:label>conjunctivitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000509</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001852</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10010741</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10010741</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0009763</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>a liver/biliary system AE which has an outcome of liver inflammation, a local accumulation of fluid, plasma proteins, and leukocytes in the liver</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;hepatitis&apos; was mentioned in 387 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>liver inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001860</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000564"/>
        <purl:Definition>aa inflammation AE which has an outcome of lung inflammation, a  local accumulation of fluid, plasma proteins, and leukocytes in the lung</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;pneumonia&apos; was mentioned in 879 VAERS reports (0.7%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>lung inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001861</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000564 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE which has an outcome of respiratory system inflammation, the local accumulation of fluid, plasma proteins, and leukocytes in the respiratory system</purl:Definition>
        <rdfs:label>respiratory system inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002405</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE that has an outcome of vasculitis, which is an inflammation of a blood or lymph vessel</purl:Definition>
        <obo1:IAO_0000116>It&apos;s an inflammation.</obo1:IAO_0000116>
        <rdfs:label>vasculitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002633</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001864</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10047115</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042384</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000566 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition xml:lang="en">an inflammation AE which has an outcome of salivary gland inflammation, which is local accumulation of fluid, plasma proteins, and leukocytes in the salivary gland</purl:Definition>
        <rdfs:label>salivary gland inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001870</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000564"/>
        <purl:Definition xml:lang="en">a respiratory system inflammation AE which has an outcome of sinus inflammation, an inflammation of paranasal sinuses, which may be due to infection, allergy, or autoimmune issues.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;sinusitis&apos;; is an adverse event that was mentioned in 298 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS, YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000118>sinus inflammation AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinusitis</obo1:IAO_0000119>
        <rdfs:label>sinusitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000246</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001872</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0037199</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000568 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <purl:Definition xml:lang="en">a hypersensitivity AE which results in an allergic response showing a marked increase in reactivity to an antigen upon subsequent exposure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>allergic reaction AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>allergic response AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>anaphylactic reaction AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Allergy</obo1:IAO_0000119>
        <obo1:OAE_0001849>变态反应</obo1:OAE_0001849>
        <obo1:OAE_0001849>过敏反应</obo1:OAE_0001849>
        <rdfs:label>allergy AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001878</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10001738</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition xml:lang="en">a nervous system AE which has an outcome of abnormal cerebrospinal fluid production, an anomaly in the normal output of the fluid that fills the ventricles and other cavities of the brain and spinal cord</purl:Definition>
        <rdfs:label>abnormal cerebrospinal fluid production AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001911</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in nervous system.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>nervous system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0003633</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition xml:lang="en">a respiratory system AE which has an outcome of abnormal respiration, an anomaly in the movement of gases into and out of the lung</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;respiratory disorder&apos; is an adverse event that was mentioned in 556 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000116>Not sure if it is same as respiratory system disorder or abnormal respiration. --Oliver He</obo1:IAO_0000116>
        <rdfs:label>abnormal respiration AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001943</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000572 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000572">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <purl:Definition xml:lang="en">an abnormal respiration AE which has an outcome of apnea, temporary cessation of breathing; sometimes episodic</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;apnea&apos; is an adverse event that was mentioned in 1,618 VAERS reports (1.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>respiratory arrest AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/apnea</obo1:IAO_0000119>
        <rdfs:label>apnea AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001957</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002974</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition xml:lang="en">an ear disorder AE which has an outcome of deafness, which is an inability to hear</purl:Definition>
        <rdfs:label>deafness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000365</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0001967</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10011878</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011053</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000574 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000574">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition xml:lang="en">an adverse event that occurs in a gustatory system</purl:Definition>
        <rdfs:label>gustatory system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001985</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000575 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition xml:lang="en">a gustatory system AE which has an outcome of taste sensitivity, or changes in the ability to perceive a particular flavor or suggestion of something imparting a flavor by the chemoreceptors of the gustatory system</purl:Definition>
        <rdfs:label>taste sensitivity AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0001986</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">a urinary system AE that has an outcome of excessive or abnormally large production or passage of urine.</purl:Definition>
        <obo1:IAO_0000117>LW, ML, JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyuria</obo1:IAO_0000119>
        <obo1:OAE_0001849>多尿</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">polyuria AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036142</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000577 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000577">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <purl:Definition xml:lang="en">an abnormal vision AE which has an outcome of blindness, which is loss of the sense of sight</purl:Definition>
        <rdfs:label>blindness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000618</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002001</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10005169</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0456909</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000578 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000578">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition xml:lang="en">an eye disorder AE which has an outcome of abnormal vision, which is an inability or decreased ability to see</purl:Definition>
        <rdfs:label>abnormal vision AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002090</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000579 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000579">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a behavior and neurological AE that shows a sudden surge of electrical activity in the brain.</purl:Definition>
        <obo1:IAO_0000117>YH, JX</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/symptom/seizures</obo1:IAO_0000119>
        <obo1:OAE_0001849>突然发作</obo1:OAE_0001849>
        <rdfs:label>seizure AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002064; MDR: 10039910</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that has an outcome of abnormal behavior and neurological phenotype</purl:Definition>
        <rdfs:comment xml:lang="en">any anomaly in the actions, reactions, or performance of an organism in response to external or internal stimuli compared to controls</rdfs:comment>
        <rdfs:label>behavior and neurological AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004924</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000581 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000581">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a behavior and neurological AE that has an outcome of altered ability to coordinate voluntary movement or repetitive, compulsive movements</purl:Definition>
        <rdfs:label>movement disorder AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100022</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002066</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028035</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026650</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000582 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000582">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <rdfs:comment xml:lang="en">a behavior and neurological AE that has an outcome of inability or altered ability to respond to a sensory stimulus</rdfs:comment>
        <rdfs:label>sensory capability AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition xml:lang="en">a homeostasis AE which has an outcome of glucose homeostasis, which is an anomaly in the processes involved in the maintenance of an internal equilibrium of glucose in the fluids and tissues</purl:Definition>
        <rdfs:label>glucose homeostasis AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002078</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>Hypersensitivity AE is a immune system AE that is a set of undesirable reactions produced by the normal immune system, including allergies and autoimmunity. These reactions may be damaging, uncomfortable, or occasionally fatal.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypersensitivity reaction AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypersensitivity</obo1:IAO_0000119>
        <obo1:OAE_0001849>超敏反应</obo1:OAE_0001849>
        <rdfs:label>hypersensitivity AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100326</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002148</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10020751</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10020751</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020517</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000585 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000585">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Muscle atrophy is a wasting of muscle tissue resulting in a derangement of the muscle fibers; occurs with age, immobilization, weightlessness, malnutrition or denervation.</rdfs:comment>
        <rdfs:comment xml:lang="en">a muscle adverse event AE which has an outcome of muscular atrophy. </rdfs:comment>
        <rdfs:label>muscular atrophy AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002269</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <purl:Definition xml:lang="en">an abnormal respiration AE which has an outcome of hyperventilation, i.e., increased alveolar ventilation relative to metabolic carbon dioxide production; results in carbon dioxide pressure decreasing below normal</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;Petechiae&apos; was mentioned in 510 VAERS reports (0.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>hyperventilation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002883</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002320</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10020910</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020578</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000587 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000587">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <purl:Definition xml:lang="en">an abnormal respiration AE which has an outcome of hypoventilation AE is reduced alveolar ventilation relative to metabolic carbon dioxide production; results in alveolar carbon dioxide pressure increasing above normal</purl:Definition>
        <purl:Definition xml:lang="en">an abnormal respiration AE which has an outcome of hypoventilation, i.e., reduced alveolar ventilation relative to metabolic carbon dioxide production; results in alveolar carbon dioxide pressure increasing above normal</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;hypoventilation&apos; is an adverse event that was mentioned in 321 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>hypoventilation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0007110</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002321</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10021133</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0398353</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition xml:lang="en">an adverse event which occurs in a hematopoietic system, which is any structural or developmental anomaly of the blood cells or the organs associated with the development and formation of blood cells</purl:Definition>
        <rdfs:label>hematopoietic system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002396</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000589 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000589">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition xml:lang="en">an eye disorder AE which has an outcome of mydriasis, which is dilation of one or both pupils regardless of light conditions</purl:Definition>
        <rdfs:label>mydriasis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011499</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002546</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028521</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026961</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000590 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition xml:lang="en">an arrhythmia AE that has an outcome of greater than average resting heart beats per minute, usually measured by the number of times the heart ventricles contract per unit of time, usually per minute</purl:Definition>
        <obo1:IAO_0000118>tachycardia</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tachycardia</obo1:IAO_0000119>
        <rdfs:label>increased heart rate AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002626</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10019303</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000591 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000591">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a behavior and neurological AE that has an outcome of exaggerated reflex action</purl:Definition>
        <rdfs:label>hyperresponsive to tactile stimuli AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002738</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000592 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a muscle spasm AE that has an outcome of opisthotonus</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment xml:lang="en">opisthotonus is a form of tetanic spasm in which the head, neck and spine are bent backward and the body is bowed forward</rdfs:comment>
        <rdfs:label>opisthotonus AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002179</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002880</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10030899</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151818</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000593 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition xml:lang="en">An joint disorder AE that has an outcome of joint inflammation, which is local accumulation of fluid, plasma proteins, and leukocytes in the joints</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>joint inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002933</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000594 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000620"/>
        <purl:Definition xml:lang="en">an abnormal enzyme level AE which has an outcome of incraesed lactate dehydrogenase level, which is greater than the normal concentration of this enzyme, which catalyzes the interconversion of lactate and pyruvate</purl:Definition>
        <rdfs:label>increased lactate dehydrogenase level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002944</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000595 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000620"/>
        <purl:Definition xml:lang="en">an abnormal enzyme level AE which has an outcome of increased circulating alkaline phophatase level, which is an elevated activity of this enzyme, which hydrolyzes orthophosphoric monoesters, found in the blood</purl:Definition>
        <rdfs:label>increased circulating alkaline phosphatase level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0002968</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000596 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000593"/>
        <purl:Definition xml:lang="en">A joint inflammation AE that has an outcome of arthritis, marked by changes in the synovial membranes and thickening of articular structures, widespread degeneration of the collagen fibers in connective tissues, and by atrophy and rarefaction of bony structures</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>关节炎</obo1:OAE_0001849>
        <rdfs:label>arthritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001369</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0002993</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003246</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003864</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000597 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition xml:lang="en">a digestive system AE which has an outcome of dysphagia, which is a behavior and neurological AE that has an outcome of difficulty in swallowing food or liquid</purl:Definition>
        <rdfs:label>dysphagia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002015</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003158</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10013950</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10013950</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0011168</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000598 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000598">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition xml:lang="en">an ear disorder AE which has an outcome of decreased lateral semicircular canal size, which is small size of the lateral long bony tube of the labyrinth that is involved in the sense of balance</purl:Definition>
        <rdfs:label>decreased lateral semicircular canal size AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0003162</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001731"/>
        <purl:Definition xml:lang="en">a hematopoietic system AE which has an outcome of decreased platelet count, which is fewer than the normal numbers of the non-nucleated cells found in the blood and involved in blood coagulation</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>decreased platelet cell number AE</obo1:IAO_0000118>
        <rdfs:label>platelet count decreased AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001873</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003179</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10035528</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0392386</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000554"/>
        <purl:Definition xml:lang="en">an abnormal digestion AE which has an outcome of nausea, a gastric discomfort associated with the inclination to vomit</purl:Definition>
        <rdfs:label>nausea AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002018</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003259; MDR: 10028813</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028813</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10028813</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0027497</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000601 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000554"/>
        <obo1:IAO_0000118>regurgitation AE</obo1:IAO_0000118>
        <rdfs:comment xml:lang="en">an abnormal digestion AE which has an outcome of vomiting, the retrograde expulsion of gastric contents through the oral cavity</rdfs:comment>
        <rdfs:label>vomiting AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002013</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003260; MDR: 10047700</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10047700</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047700</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042963</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <purl:Definition xml:lang="en">an abnormal defecation AE that has an outcome of constipation, which is incomplete, infrequent or difficult evacuation of fecal matter</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;constipation&apos;; is an adverse event that was mentioned in 242 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000118>infrequent bowel movements AE</obo1:IAO_0000118>
        <rdfs:label>constipation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002019</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003267</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10010774</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0009806</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000603 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000603">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition xml:lang="en">a digestive system AE that has an outcome of abnormal defecation, an anomaly in the production and excretion of feces</purl:Definition>
        <rdfs:label>abnormal defecation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0003866</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000604 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">a urinary system AE that has an outcome of the symptom of urinary incontinence, which is the inability to control the urinary excretory functions.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/urinaryincontinence.html</obo1:IAO_0000119>
        <rdfs:label>urinary incontinence AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000020</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003280</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042024</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000605 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000605">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>clonus AE is  a series of involuntary, rhythmic, muscular contractions and relaxations. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Clonus</obo1:IAO_0000119>
        <rdfs:comment>clonus AE causes large motions that are usually initiated by a reflex. </rdfs:comment>
        <rdfs:label xml:lang="en">clonus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10009346</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000606 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000606">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition xml:lang="en">a skin discoloration AE which has an outcome of pallor, an unnatural paleness to the skin, generally attributable to anemia</purl:Definition>
        <rdfs:label>pallor AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0008361</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003717</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10033546</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0030232</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000607 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000607">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition xml:lang="en">an ear disorder AE which has an outcome of tinnitus, which is a persistent sensation of buzzing, ringing, clicking, or other noises in the ear</purl:Definition>
        <rdfs:label>tinnitus AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000360</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003741</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10043882</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0040264</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000608 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000608">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition xml:lang="en">a digestive system AE which has an outcome of stomatitis, which is an inflammation of the mucous lining of the mouth</purl:Definition>
        <obo1:IAO_0000118>This is a type of inflammation.</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/stomatitis</obo1:IAO_0000119>
        <rdfs:label>stomatitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010280</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0003746</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10042128</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10042128</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0038362</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000609 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000609">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition xml:lang="en">a digestive system AE which has an outcome of mouth mucosal ulceration, which is lesions through the mucous membrane of the mouth, usually associated with loss of tissue</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;mouth ulceration&apos; was mentioned in 246 VAERS reports (0.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:label>mouth mucosal ulceration AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0003747</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition xml:lang="en">a muscle adverse event AE that has an outcome of abnormal muscle tone, which is  an anomaly in the resting tautness or laxity of a muscle, normally somewhere in the middle of the range between total contraction and total relaxation</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>abnormal muscle tone AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004142</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000611 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000611">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <purl:Definition xml:lang="en">an abnormal muscle tone AE which has an outcome of hypertonia, which is increased muscle tension resulting in stiffness of the muscles in the resting state</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>hypertonia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001276</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0004143</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10020852</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026826</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <purl:Definition xml:lang="en">an abnormal muscle tone AE which has an outcome of hypotonia, which is decreased muscle tension resulting in limpness of the muscles in the resting state, not to be confused with weakness</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>hypotonia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009062</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0004144</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10021118</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026827</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000613 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000613">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000614"/>
        <purl:Definition xml:lang="en">a muscle inflammation AE which has an outcome of myositis, which is an inflammation of skeletal muscle; local accumulation of fluid, plasma proteins, and leukocytes in the striated muscle</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>myositis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009071</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0004510</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028653</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10028653</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0027121</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition xml:lang="en">a muscle adverse event which has an outcome of muscle inflammation, which is a local accumulation of fluid, plasma proteins, and leukocytes in muscle</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>muscle inflammation AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0004511</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000615 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000615">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001676"/>
        <purl:Definition xml:lang="en">a lymphocyte count abnormal AE that has an outcome of greater than normal number of the cells involved in adaptive immune reactions of the body in most inflammatory and autoimmune diseases, including B cells, T cells and natural killer cells</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS), &apos;lymphocytosis&apos;; is an adverse event that was mentioned in 129 VAERS reports (0.1%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>EB</obo1:IAO_0000117>
        <obo1:IAO_0000118>increased lymphocyte cell number AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>lymphocyte cell number increased AE</obo1:IAO_0000118>
        <rdfs:label>lymphocyte count increased AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005013</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10025258</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000603"/>
        <purl:Definition xml:lang="en">an abnormal defecation AE that has an outcome of diarrhea, which is abnormally frequent discharge of semi-solid or fluid fecal matter from the bowel</purl:Definition>
        <obo1:IAO_0000118>diarrhoea AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/diarrhea</obo1:IAO_0000119>
        <rdfs:label>diarrhea AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005036</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10012735</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000617 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000617">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition xml:lang="en">a homeostasis AE which has an outcome of hypoxia, which is a reduced concentration of O2 in the blood, alveoli or other tissues resulting in the decreased pressure of this component of body gases</purl:Definition>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypoxia</obo1:IAO_0000119>
        <rdfs:label>hypoxia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002795</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0005039</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10021143</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10021143</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0242184</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000618 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000618">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition xml:lang="en">an infectious adverse event which has an outcome of the presence of various pathogenic organisms, or their toxins, in the blood or tissues that results in the infections in blood stream.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;sepsis&apos; was mentioned in 416 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label>sepsis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002718</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0005044</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10040047</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10040047</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0243026</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000619 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">a urinary system AE that results in the presence of blood in the urine</purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>blood urine </obo1:IAO_0000118>
        <obo1:IAO_0000118>haematuria AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://kidney.niddk.nih.gov/kudiseases/pubs/hematuria/</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hematuria</obo1:IAO_0000119>
        <rdfs:comment>Hematuria AE can be caused by menstruation, vigorous exercise, sexual activity, viral illness, trauma, or infection, such as a urinary tract infection (UTI), along with more serious disorders such as cancer, disease, and clotting.</rdfs:comment>
        <rdfs:label>hematuria AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005161</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10018867</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10018870</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000620 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000620">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition xml:lang="en">a homeostasis AE which has an outcome of abnormal enzyme level, which is an altered level of any enzyme or their cofactors, that act as catalysts to induce chemical changes in other substances</purl:Definition>
        <rdfs:label>abnormal enzyme level AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005319</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000621 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000621">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>an arrhythmia AE that has an outcome of fewer than average resting heart beats per minute, usually measured by the number of times the heart ventricles contract per unit of time, usually per minute</purl:Definition>
        <obo1:IAO_0000232>Added MedDRA term LB</obo1:IAO_0000232>
        <rdfs:label>decreased heart rate AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005333</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10019301</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000622 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000622">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition xml:lang="en">an adverse event that has an outcome of urinary system AE is a functional anomaly of any of the organs involved in the production or excretion of urine</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>urinary system AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005502</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000623 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000623">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000624"/>
        <purl:Definition xml:lang="en">an abnormal body temperature AE which has an outcome of decreased body temperature, which is less than the level of heat natural to a living being</purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>decreased body temperature AE</obo1:IAO_0000118>
        <rdfs:comment>Hypothermia AE is a medical emergency that occurs when your body loses heat faster than it can produce heat, causing a dangerously low body temperature. </rdfs:comment>
        <rdfs:label>hypothermia AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005534</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10021113</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000624 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000555"/>
        <purl:Definition xml:lang="en">a homeostasis AE whic has an outcome of abnomal body temperature, which is a deviation in the level of heat natural to a living being</purl:Definition>
        <rdfs:label>abnormal body temperature AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0005535</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000625 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000625">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition xml:lang="en">a peripheral neuropathy AE which has an outcome of neuritis,  the local accumulation of fluid, plasma proteins, and leukocytes in the brain and/or spinal cord</purl:Definition>
        <rdfs:label>neuritis AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0006082</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10029240</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <obo1:IAO_0000118>diplopia AE</obo1:IAO_0000118>
        <rdfs:comment xml:lang="en">an abnormal vision AE which has an outcome of double vision, which is two images  perceived when only a single object is present</rdfs:comment>
        <rdfs:label>double vision AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0006150</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10013036</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <purl:Definition xml:lang="en">an anemia AE which has an outcome of hypochromic anemia, which is a hemoglobin deficiency resulting from a reduction in the concentration of hemoglobin in red cells, resulting in insufficient oxygenation of tissues and organs</purl:Definition>
        <rdfs:label>hypochromic anemia AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0008387</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000628 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000628">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that is indicated by an abnormal result of an investigation that uses some laboratory equipment, device, or medical technology.  </purl:Definition>
        <obo1:IAO_0000116>This term is used to replace &apos;lab test abnormal AE&apos;. The reason for this is that some test, like X-ray test, is not considered by many physicians as a lab test. Therefore, we have used this new term to cover a broader scope. All terms asserted under this term represent the investigation results without defined conclusion of disease. </obo1:IAO_0000116>
        <obo1:IAO_0000117>EB, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>laboratory test abnormal</obo1:IAO_0000118>
        <rdfs:label xml:lang="en">investigation result abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061253</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000629 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of nervous</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;nervousness&apos; is an adverse event that was mentioned in 583 VAERS reports (0.5%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <rdfs:comment xml:lang="en">increased, skittish, behavior induced by stimulation such as handling, touching or noise</rdfs:comment>
        <rdfs:label>nervous AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0008912</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000630 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000630">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of ecchymosis</purl:Definition>
        <rdfs:comment xml:lang="en">an ecchymosis is a spot caused by loss of blood from a vessel; it implies a larger size than a petechiae, and has a more diffuse border than purpura; an ecchymosis can be caused by a bruise (which implies trauma), but can also be caused by bleeding diathesis</rdfs:comment>
        <rdfs:label>ecchymosis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000978</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0009276</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10014080</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013491</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>serious adverse event is an adverse event that requires in-patient hospitalization, or prolongation of existing hospitalization, or that causes congenital malformation, or that results in persistent or significant disability or incapacity, or that is life threatening or results in death.</purl:Definition>
        <obo1:IAO_0000117>YH, MC</obo1:IAO_0000117>
        <obo1:IAO_0000118>serious adverse event</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Serious_adverse_event</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.google.ca/url?sa=t&amp;source=web&amp;ct=res&amp;cd=1&amp;ved=0CA4QFjAA&amp;url=http%3A%2F%2Fwww.irrd.ca%2Fethics%2Fimages%2FAdverse-event-definition.doc&amp;ei=eqFMS-yFNZSoswOt6siKAQ&amp;usg=AFQjCNGnQcwI8OXH7dqxwo4RgZEEn8X6lg&amp;sig2=UNngkCdO5ZTFvbIB1pKuaA</obo1:IAO_0000119>
        <rdfs:label>severe adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000632">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event that has an outcome of death. </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <rdfs:label>death AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001645</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10011906</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C1306577</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event that is life-threatening. This adverse event occurs when a patient was at substantial risk of dying or it is suspected that the use or continued use of the product would result in the patient&apos;s death.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <rdfs:label>life-threating adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000634 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000634">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event that leads to hospitalization. </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <rdfs:label>adverse event leading to hospitalization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event that leads to disability or permanent damage. </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <rdfs:label>adverse event leading to disability</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000636 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000636">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event that is an adverse event leading to congenital anomaly leads to suspicions that exposure to a medical product prior to conception or during pregnancy resulted in an adverse outcome in the child.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.thefreedictionary.com/birth+defect</obo1:IAO_0000119>
        <rdfs:label>adverse event leading to congenital anomaly</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010356</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000637 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000637">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000631"/>
        <purl:Definition>a serious adverse event which is an adverse event that requires intervention to prevent permanent impairment or damage leads to suspicions that the use of a medical product may result in a condition which required medical or surgical intervention to preclude permanent impairment or damage to a patient.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/Safety/MedWatch/HowToReport/ucm053087.htm</obo1:IAO_0000119>
        <rdfs:label>adverse event that requires intervention to prevent permanent impairment or damage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000638 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000638">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that is considered not serious.</purl:Definition>
        <obo1:IAO_0000117>YH, MC</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.google.ca/url?sa=t&amp;source=web&amp;ct=res&amp;cd=1&amp;ved=0CA4QFjAA&amp;url=http%3A%2F%2Fwww.irrd.ca%2Fethics%2Fimages%2FAdverse-event-definition.doc&amp;ei=eqFMS-yFNZSoswOt6siKAQ&amp;usg=AFQjCNGnQcwI8OXH7dqxwo4RgZEEn8X6lg&amp;sig2=UNngkCdO5ZTFvbIB1pKuaA</obo1:IAO_0000119>
        <rdfs:label>non-serious adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000639 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000639">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <purl:Definition>low-grade fever AE is a fever adverse event with a temperature between 100° F and 102.2° F (37.8° C and 39° C).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.toyourhealth.com/mpacms/tyh/article.php?id=1521</obo1:IAO_0000119>
        <rdfs:comment>The low-grade level of fever is beneficial. With most microbes/&quot;bugs&quot; that a child will be exposed to, this fever will assist the body in repelling the invader.</rdfs:comment>
        <rdfs:label>low-grade fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000640 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <purl:Definition>moderate-grade fever AE is a fever adverse event with a temperature typically between 102.2° F and 104.5° F (39° C and 40° C).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.toyourhealth.com/mpacms/tyh/article.php?id=1521</obo1:IAO_0000119>
        <rdfs:comment>This moderate-grade fever temperature is still considered beneficial. If a child&apos;s body has reached this temperature, it&apos;s what&apos;s needed to kill whatever bacteria or virus their body is attempting to fight.</rdfs:comment>
        <rdfs:label>moderate-grade fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000641 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000641">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <purl:Definition>high-grade fever AE is a fever adverse event with a fever temperature greater than 104.5° F (40° C).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.toyourhealth.com/mpacms/tyh/article.php?id=1521</obo1:IAO_0000119>
        <rdfs:comment>This fever may cause the child some discomfort and result in crankiness. Generally indicative of a bacterial infection, this fever means that the body is fighting something more serious than the common cold. </rdfs:comment>
        <rdfs:label>high-grade fever AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000642 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000642">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <purl:Definition>hyperpyrexia AE is a fever adverse event that has an outcome of an excessive and unusual elevation of set body temperature greater than or equal to 41 °C. It is an extremely high fever. Such a high temperature is considered a medical emergency as it may indicate a serious underlying condition such as sepsis.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>extreme pyrexia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>Axelrod YK1, Diringer MN. Temperature management in acute neurologic disorders. Neurol Clin. 2008 May;26(2):585-603, xi. doi: 10.1016/j.ncl.2008.02.005. PMID: 18514828.</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperpyrexia</obo1:IAO_0000119>
        <rdfs:label>hyperpyrexia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001945</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10020741</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0392676</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000643 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000643">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of musculoskeletal pain</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/pain-management/guide/musculoskeletal-pain</obo1:IAO_0000119>
        <rdfs:comment>Musculoskeletal pain is pain that affects the muscles, ligaments and tendons, along with the bones.</rdfs:comment>
        <rdfs:label>musculoskeletal pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003326</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028391</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026858</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000644 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000644">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <purl:Definition>injection-site erythema AE is an erythema AE that results in redness of skin, caused by hyperermia of the capillaries in the lower layers of the skin at the physical area of injection</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/erythema</obo1:IAO_0000119>
        <rdfs:label>injection-site erythema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022061</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000645 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Erythema AE is a skin adverse event that showns redness of the skin caused by hyperemia of the capillaries in the lower layers of the skin.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>reddish skin</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema</obo1:IAO_0000119>
        <rdfs:label>erythema AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010783</rdfs:seeAlso>
        <rdfs:seeAlso>MP:0001190</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10015150</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10015150</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0041834</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000646 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000646">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <purl:Definition>a headache AE that has an outcome of sinus headache</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://american-rhinologic.org/patientinfo.headache.phtml</obo1:IAO_0000119>
        <rdfs:comment>sinus headache is a headache located over the sinuses, (forehead, corners of the eye, and cheek areas). On occasion, the pain will be felt behind the eyes, in the back of the neck, or may extend into the upper teeth.</rdfs:comment>
        <rdfs:label>sinus headache AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002315</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0037195</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000647 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <purl:Definition>pneumonia AE is a respiratory system AE that results in an abnormal inflammatory condition of the lung. It is often characterized as including inflammation of the parenchyma of the lung (that is, the alveoli) and abnormal alveolar filling with fluid (consolidation and exudation).</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pneumonia</obo1:IAO_0000119>
        <rdfs:label>pneumonia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002090</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10035664</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10035664</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0032285</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000648 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000648">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <purl:Definition>lobar pneumonia is pneumonia AE that affects a large and continuous area of the lobe of a lung</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Lobar_pneumonia</obo1:IAO_0000119>
        <rdfs:label>lobar pneumonia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002090</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10024738</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0032300</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000649 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000649">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>axillary pain AE is a pain AE that occurs in the underarm (the area on the human body directly under the join where the arm connects to the shoulder)</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>axillary pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000650 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000650">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>an cardiovascular adverse event that is a collection of blood outside the blood vessels, generally the result of hemorrhage, or more specifically, internal bleeding. It is commonly called a bruise.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>bruise AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>ecchymoses AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>haematoma AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hematoma</obo1:IAO_0000119>
        <rdfs:label>hematoma AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001892</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10018852</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0018944</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000651 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000651">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>reproductive system AE is an AE that occurs in the reproductive system.</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <rdfs:label>reproductive system AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>an immune system disorder AE which has an outcome of antinuclear antibody negative</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>antinuclear antibody negative AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000653 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000653">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000293"/>
        <purl:Definition>a CSF test result abnormal AE that has an outcome of CSF white blood cell count negative</purl:Definition>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>CSF white blood cell count negative AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061099</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000654 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001605"/>
        <purl:Definition>a microbiology and serology investigation result abnormal AE that has an outcome of positive influenza serology test result</purl:Definition>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>influenza serology positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10060078</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000655 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000655">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000117>a paralysis AE that has an outcome of VIIth nerve paralysis</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">VIIth nerve paralysis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0006824</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10050040</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0919980</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000656 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001697"/>
        <purl:Definition>an aspartate aminotransferase level abnormal AE that has an outcome of an increased amount of AST, an enzyme normally present in body tissues especially of the heart and liver</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aspartate+aminotransferase</obo1:IAO_0000119>
        <rdfs:label>aspartate aminotransferase level increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003481</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000658 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000658">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <purl:Definition>an immune system disorder AE which has an outcome of acute disseminated encephalomyelitis</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_disseminated_encephalomyelitis</obo1:IAO_0000119>
        <rdfs:comment>Acute disseminated encephalomyelitis (ADEM) is an immune mediated disease of the brain. It usually occurs following a viral infection but may appear following vaccination, bacterial or parasitic infection, or even appear spontaneously. As it involves autoimmune demyelination, it is similar to multiple sclerosis, and is considered part of the Multiple sclerosis borderline diseases.</rdfs:comment>
        <rdfs:label>acute disseminated encephalomyelitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10000709</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000659 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>an arrhythmia AE that involves the two upper chambers (atria) of the heart</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>AF</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Atrial_fibrillation</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/atrial+fibrillation</obo1:IAO_0000119>
        <rdfs:comment>Atrial fibrillation (AF or A-fib) is the most common cardiac arrhythmia (abnormal heart rhythm), and involves the two upper chambers (atria) of the heart. Its name comes from the fibrillating (i.e., quivering) of the heart muscles of the atria, instead of a coordinated contraction.</rdfs:comment>
        <rdfs:label>atrial fibrillation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005110</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003658</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003658</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004238</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE which has an outcome of abnormal heart rhythm</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>abnormal heartbeat AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>cardiac arrhythmia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/arr/</obo1:IAO_0000119>
        <rdfs:label>arrhythmia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0011675</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0004085</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003119</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003811</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000661 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <purl:Definition>a cardiac valve disease AE that is characterized by a condition of the heart in which one of the valve openings has become narrow and restricts the flow of blood from the upper left chamber (left atrium) to the lower left chamber (left ventricle).</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/mitral+valve+stenosis</obo1:IAO_0000119>
        <rdfs:label>mitral valve stenosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027733</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000662 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000662">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001588"/>
        <purl:Definition>a blood creatinine level abnormal AE that has an outcome of decreased blood creatine</purl:Definition>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>blood creatinine level decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005482</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000663 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000663">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001624"/>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>carbon dioxide decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007223</rdfs:seeAlso>
        <owl:backwardCompatibleWith>a carbon dioxide abnormal AE that has an outcome of a decreased level of carbon dioxide in the blood</owl:backwardCompatibleWith>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000665 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000665">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection adverse event that has an outcome of croup infection</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/croup/article.htm</obo1:IAO_0000119>
        <rdfs:comment>Croup is an infectious illness of the respiratory system involving the vocal cords (larynx), the windpipe (trachea), and the upper airways of the lungs (bronchial tubes). The majority of a child&apos;s symptoms reflect involvement of the larynx. Croup is usually a viral infection and maybe caused by many different viruses, including those responsible for the common cold and influenza. Rarely, croup is caused by a bacterial infection.</rdfs:comment>
        <rdfs:label>croup infection AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000666 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000666">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE that has an outcome of the drawing of a foreign substance into the respiratory tract during inhalation</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aspiration</obo1:IAO_0000119>
        <rdfs:label>aspiration AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002835</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003504</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0700198</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000667 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000667">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE that has an outcome of the removal of gas or fluid from the pleural cavity of the lungs</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aspiration</obo1:IAO_0000119>
        <rdfs:label>aspiration pleural cavity AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003522</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000668 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event which has an outcome of excoriation AE is an injury to a surface of the body caused by trauma, such as scratching, abrasion, or a chemical or thermal burn.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/excoriation</obo1:IAO_0000119>
        <rdfs:label>excoriation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10049796</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000669 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000669">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of facial pain</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.bettermedicine.com/article/facial-pain</obo1:IAO_0000119>
        <rdfs:comment>facial pain is a pain in facial area (eyes, eyebrows, forehead, nose, cheeks, mouth, teeth and chin). Facial pain may include injuries to the nerves or bones that coordinate many of your face’s actions.</rdfs:comment>
        <rdfs:label>facial pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0100661</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10016059</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015468</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000670 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000670">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001664"/>
        <purl:Definition>a hematology investigation result abnormal AE that has an outcome of abnormal full blood count</purl:Definition>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>full blood count abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10017412</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10064198</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000671 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000671">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000504"/>
        <purl:Definition>a reflexes decreased AE that has an outcome of hyporeflexia</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyporeflexia</obo1:IAO_0000119>
        <rdfs:comment>hyporeflexia is the condition of below normal or absent reflexes. Hyporeflexia is generally associated with a lower motor neuron deficit (at the alpha motor neurons from the spinal cord to muscle).</rdfs:comment>
        <rdfs:label>hyporeflexia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009072</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10021089</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151888</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000672 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000672">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>a tumor AE that is characterized by cancer in the brain</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/astrocytoma</obo1:IAO_0000119>
        <rdfs:label>astrocytoma AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009592</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003571</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004114</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000674 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000674">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <purl:Definition>a lung disorder AE that has an outcome of collapse in part of or all of a lung</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001130/</obo1:IAO_0000119>
        <rdfs:label>atelectasis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001642</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003598</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004144</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000675 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000654"/>
        <purl:Definition>an influenza serology positive AE that has an outcome of positive result in an influenza virus test</purl:Definition>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>influenza virus test positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10070717</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000676 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000676">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000332"/>
        <purl:Definition>joint range of motion decreased AE is a mobility decreased AE that results in limited or decreased range of joint motion</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>joint range of motion decreased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <purl:Definition>a muscle spasm AE which has an outcome of laryngospasm, which is an uncontrolled/involuntary muscular contraction (spasm) of the laryngeal cords. The condition typically lasts less than 60 seconds, and causes a partial blocking of breathing in, while breathing out remains easier. It may be triggered when the vocal cords or the area of the trachea below the cords detects the entry of water, mucus, blood, or other substance. It is characterized by stridor and or retractions.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Laryngospasm</obo1:IAO_0000119>
        <rdfs:label>laryngospasm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0006511</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10023891</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0023066</rdfs:seeAlso>
    </owl:Class>
    


