        <rdfs:subPropertyOf rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/otherProperties"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
