    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin AE with the outcome of skin tightness</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
