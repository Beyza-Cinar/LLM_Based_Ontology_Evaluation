        <rdfs:seeAlso>SIDER: C0020557</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>an arthritis AE that has an outcome of uric acid building up in blood and causes joint inflammation</purl:Definition>
