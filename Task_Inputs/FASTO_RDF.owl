        <rdfs:seeAlso>SIDER: C0277884</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <purl:Definition>a cardiac ventricular disorder AE that is a condition in nwhich the right ventricle of the heart was functionally impaired. This condition usually leads to heart failure or myocardial infarction, and other cardiovascular complicationns.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/mesh/?term=right%20ventricular%20dysfunction</obo1:IAO_0000119>
        <rdfs:label>right ventricular dysfunction AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10058597</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001877"/>
        <purl:Definition>an arrhythmia AE that is characterized by a premature contraction of the ventricle</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>infranodal extrasystoles AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://dictionary.reference.com/browse/ventricular+extrasystole</obo1:IAO_0000119>
        <rdfs:label>ventricular extrasystoles AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0006696</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047289</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151636</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001743 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001743">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism disorder AE that is a result of an obstruction in a cardiac vessel due to a blood clot or other foreign matters</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>heart embolism AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Heart+embolism</obo1:IAO_0000119>
        <rdfs:label>cardiac embolism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001744 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001744">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>a vascular disorder AE that is characterized by an obstruction in a blood vessel due to a blood clot or other foreign matter that gets stuck while traveling through the bloodstream.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/embolism</obo1:IAO_0000119>
        <rdfs:label>embolism AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001907</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10014523</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0013922</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001746 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001746">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001742"/>
        <purl:Definition>an arrhythmia AE that results in extra, abnormal heartbeats that begin in one of the heart&apos;s two lower pumping chambers (ventricles). These extra beats disrupt the regular heart rhythm, sometimes causing the patient to feel a flip-flop or skipped beat in the chest.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>PVCs</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.com/health/premature-ventricular-contractions/DS00949</obo1:IAO_0000119>
        <rdfs:label>premature ventricular contractions AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036614</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001747 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001747">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <purl:Definition>a cardiac valve disease AE that is charaterized by the backflow of blood from the pulmonary artery into the right ventricle, owing to imperfect functioning of the pulmonary valve</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>pulmonic incompetence AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/medical/pulmonary_valve_incompetence.htm</obo1:IAO_0000119>
        <rdfs:label>pulmonary valve incompetence AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010444</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10037448</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0034088</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001748 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001748">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <purl:Definition>a cardiac vavle disease AE that is characterized by a congenital heart defect in which blood flow from the heart to the pulmonary artery is blocked</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>pulmonic stenosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Pulmonary+Valve+Stenosis</obo1:IAO_0000119>
        <rdfs:label>pulmonary valve stenosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037450</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001749 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001749">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <purl:Definition>a vasculitis AE that is an inflammation specific to an artery or arteries</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/arteritis</obo1:IAO_0000119>
        <rdfs:label>arteritis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005291</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10003230</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003860</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001751 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001751">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>a vascular disorder AE that results in an abnormal widening or ballooning of a portion of an artery due to weakness in the wall of the blood vessel</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001122.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aneurysm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002617</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002329</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002940</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>a vascular disorder that affects the veins or blood circulation of the veins</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">venous disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001753 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001753">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <purl:Definition>an aneurysm AE that results in the weakening of the balloon-like bulge that the blood pressure causes the artery wall to leak or burst</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>SAH</obo1:IAO_0000118>
        <obo1:IAO_0000118>ruptured aneurysm AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>subarachnoid hemorrhage AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayfieldclinic.com/PE-AneurRupt.htm#.Uor4tI3QHh0</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aneurysm ruptured AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002617</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10048380</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0162869</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <purl:Definition>an aneurysm AE that refers to an aneurysm involving cardiac tissue. This most often occurs as a ventricular aneurysm following a myocardial infarction</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>aneurysm of heart AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>heart aneurysm AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/19239694</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cardiac aneurysm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007513</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001755 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001755">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <purl:Definition>an aneurysm AE that occurs in the aorta</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/heart-disease/tc/aortic-aneurysm-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aortic aneurysm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004942</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002882</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003486</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001756 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001756">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001753"/>
        <purl:Definition>an aneurysm ruptured AE that occurs in the aorta</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>ruptured aortic aneurysm AE</obo1:IAO_0000118>
        <rdfs:label xml:lang="en">aortic aneurysm rupture AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002622</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002886</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0741160</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001757 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001757">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000284"/>
        <purl:Definition>an aortic disorder AE in which there is a separation of the aorta walls. The small tear can become larger. It can lead to bleeding into and along the wall of the aorta, the major artery carrying blood out of the heart.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000181.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aortic dissection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004933</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002895</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0340643</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001758 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001758">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001753"/>
        <purl:Definition>an aneurysm ruptured AE that occurs in the brain where blood spurts into the subarachnoid space under arterial pressure, continuing until increased local or generalized intracranial pressure stops the bleeding.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://ether.stanford.edu/library/neuroanesthesia/Journal%20Articles/Ruptured%20cerebral%20aneurysms.pdf</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/15647574</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">ruptured cerebral aneurysm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039330</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001759 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001759">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001751"/>
        <purl:Definition>an aneurysm AE that occurs in the brain</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>brain aneurysm AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>cerebral aneurysm AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>intracerebral aneurysm AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ninds.nih.gov/disorders/cerebral_aneurysm/detail_cerebral_aneurysms.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">intracranial aneurysm AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004944</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10022758</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007766</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001760 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001760">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that is a rare lesion and may be defined as a thrombosis of a vessel without any obvious underlying cause that occurs in the aorta</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://circ.ahajournals.org/content/17/5/941.full.pdf</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aortic thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002910</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001761 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001761">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <purl:Definition>an arterial thrombosis AE that is characterized by the occurrence of a thrombus in the carotid arteries (two large blood vessels that supply oxygenated blood to the large, front part of the brain)</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/heart-disease/carotid-artery-disease-causes-symptoms-tests-and-treatment</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">carotid artery thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007688</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001762 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001762">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <purl:Definition>an arterial embolism AE that occurs in the cerebral artery</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>cerebral embolism AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>embolic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>thrombotic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/cerebral+embolism</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cerebral artery embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008088</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10014498</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10043647</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001763 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001763">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <purl:Definition>an arterial thrombosis AE that occurs in the cerebral artery, also referred to as an embolism AE</purl:Definition>
        <obo1:IAO_0000116>[SS] Per DRA and KKB&apos;s comment, this term may also be characterized as a type of embolism even though labeled thrombosis.</obo1:IAO_0000116>
        <obo1:IAO_0000118>cerebral thrombosis AE</obo1:IAO_0000118>
        <rdfs:label xml:lang="en">cerebral artery thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008092</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10008132</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001764 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <purl:Definition>a venous thrombosis AE that is characterized by thrombosis of the venous channels in the brain. It is an uncommon cause of cerebral infarction relative to arterial disease, but it is an important consideration because of its potential morbidity.</purl:Definition>
        <obo1:IAO_0000116>[SS] From http://medical-dictionary.thefreedictionary.com/cerebral+venous+thrombosis, Merwarth syndrome - progressive hemiplegia due to venous occlusion. Synonym(s): cerebral venous thrombosis</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/1162804-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cerebral venous thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008138</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001765 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <purl:Definition>a venous thrombosis AE that occurs when a blood clot forms in the brain’s venous sinuses that prevents blood from draining out of the brain. As a result, blood cells may break and leak blood into the brain tissues, forming a hemorrhage.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>CVST</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/cerebral_venous_sinus_thrombosis_134,69/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">intracranial venous sinus thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061251</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001766 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001766">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism AE that is caused by a gas bubble that enters the vein</purl:Definition>
        <obo1:IAO_0000116>[SS] The term &apos;gas embolism&apos; is listed as a unique term, and not a superset or a synonym of &apos;air embolism&apos; due to the different pathology reconized by physicians that air embolism is mostly recognized when an air bubble caused by IV or other injection device enters the vein, while a gas embolism is mostly caused by a gas bubble released as a product of an infection, or other devices such as nitrogen tank.</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label>gas embolilsm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis that is characterized by a clot that blocks blood flow a mesenteric vein, one of two veins through which blood leaves the intestine. The condition interrupts the blood supply to the intestine and can result in damage to the intestines.</purl:Definition>
        <obo1:IAO_0000116>[SS] http://emedicine.medscape.com/article/193921-overview, Mesenteric venous thrombosis (also known as visceral venous thrombosis) is a rare but lethal form of mesenteric ischemia (see the image below). Antonio Hodgson first described mesenteric ischemia in the latter part of the 15th century. In 1895, Elliot first described mesenteric venous thrombosis as a cause of mesenteric ischemia. By the turn of the 19th century, many review articles and texts were describing the recent advances in the characterization and treatment of mesenteric ischemia, particularly venous thrombosis. In 1935, Warren and Eberhard reported that intestinal infarction resulted from ischemia due to venous thrombosis, and they reported a mortality rate of 34% in patients with venous thrombosis after resection. Unfortunately, despite improvements in therapy, this mortality rate still holds.
</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>mesenteric venous thrombosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>visceral venous thrombosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001157.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">mesenteric vein thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027402</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001768 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001768">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that is an uncommon condition induced by thrombotic or nonthrombotic obstruction of hepatic venous outflow and characterized by hepatomegaly, ascites, and abdominal pain. </purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/184430-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">Budd-Chiari syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006537</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that occurs in the vein carrying the blood away from the retina</purl:Definition>
        <obo1:IAO_0000116>[SS] The term &apos;retinal vein thrombosis&apos; is listed as a different class from &apos;retinal vein occlusion&apos; for the difference in the pathological process of how the blockage occurs in the vein.</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label>retinal vein thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038908</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism AE that occurs in the artery. It is a sudden interruption of blood flow to an organ or body part due to a clot (embolus).</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>embolism arterial AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001102.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arterial embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014513</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001772 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001772">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>a thrombosis AE* that is a result of when a blood vessel is obstructed by a blood clot (embolus) that has been carried in the bloodstream from the site of its formation. Thromboembolic disease includes both venous thromboembolism (VTE) and arterial thrombosis. VTE is an general term which refers to mainly two conditions: deep vein thrombosis (DVT) and its potentially fatal acute complication, pulmonary embolism (PE). Arterial embolism is a frequent complication in patients with atrial fibrillation (AF) and can lead to stroke or systemic embolism.

* see editor note</purl:Definition>
        <obo1:IAO_0000116>[SS] Per DRA and KKB&apos;s comment, this term is synonymous to venous thrombosis even though labeled embolism. Cross-reference is made via seeAlso.</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>VTE</obo1:IAO_0000118>
        <obo1:IAO_0000118>embolism venous AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>venous thromboembolism AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.boehringer-ingelheim.com/products/prescription_medicines/thromboembolic_diseases.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">venous embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014522</rdfs:seeAlso>
        <rdfs:seeAlso>OAE: 0001505</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001773 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001773">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism AE that is characterized by the obstruction of blood vessel by fat droplets</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/460524-overview#showall</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">fat embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016246</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>a embolism AE that is infected with bacteria containing pus</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>septic embolism AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medicalnewstoday.com/articles/153704.php</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">septic embolus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that occurs in or may be caused by an implanted device in the body</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">thrombosis in device AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062546</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001777 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000318"/>
        <purl:Definition>an arterial thrombosis AE that occurs in the limb(s) of the body</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">arterial thrombosis limb AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003180</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <rdfs:label xml:lang="en">behavioral AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">injection site thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022104</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001780 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001780">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000861"/>
        <purl:Definition>a deep vein thrombosis AE that occurs in the pelvis. Ovarian vein thrombosis arises out of the coincident conditions of venous stasis and hypercoagulability, which are commonly present in the recently postpartum patient. </purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>ovarian vein thrombosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/404364-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">pelvic venous thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034272</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001781 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism AE that is charaterized by a sudden blockage in a lung artery. The blockage usually is caused by a blood clot that travels to the lung from a vein in the leg.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>PE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/pe/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">peripheral embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061340</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001782 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001782">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that occurs in subclavian vein. Among patients with effort-induced thrombosis with subclavian vein stenosis, the thrombosis occurs in the dominant arm in 80% of cases. </purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/424777-overview#showall</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">subclavian vein thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049446</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001783 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001783">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001449"/>
        <purl:Definition>a thrombophlebitis AE that is characterized by an inflammation of a vein due to a blood clot in a vein located just below the skin&apos;s surface.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>superficial thrombophlebitis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000199.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">thrombophlebitis superficial AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043595</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001784 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001784">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001505"/>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">venous thrombosis limb AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061408</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001785 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis that is characterized by a blockage of the small veins that carry blood away from the retina. The retina is the layer of tissue at the back of the inner eye that converts light images to nerve signals and sends them to the brain. </purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>RVO</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007330.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">retinal vein occlusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038907</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001786 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001786">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000185"/>
        <purl:Definition>a thrombosis AE that occurs in the atrium (left or right)</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://ehjcimaging.oxfordjournals.org/content/9/1/204.full</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">atrial thrombosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048632</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001787 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001787">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001771"/>
        <purl:Definition>an arterial embolism AE that occurs in the coronary artery</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>coronary artery thrombosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>coronary embolism AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Coronary+embolism</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary artery embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011084</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10011091</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001789 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001789">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <rdfs:label xml:lang="en">neurological AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001790 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001790">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001789"/>
        <purl:Definition>Stroke AE is a neurological AE that occurs when flow of oxygen-rich blood to a portion of the brain is blocked</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cardiovascular accident AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/stroke/
           http://en.wikipedia.org/wiki/Stroke</obo1:IAO_0000119>
        <obo1:OAE_0001849>中风</obo1:OAE_0001849>
        <rdfs:label>stroke AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10042244</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001791 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001791">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <purl:Definition>a stroke AE that occurs when a blood vessel that supplies the brain becomes blocked or &quot;clogged&quot; and impairs blood flow to part of the brain.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>ischaemic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">ischemic stroke AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061256</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001792 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001792">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <purl:Definition>a stroke AE that occurs when a blood vessel that supplies the brain ruptures and bleeds causing the deficiency of oxygen and nutrients to brain cells and tissues</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>haemorrhagic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">hemorrhagic stroke AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019016</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001793 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001793">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001792"/>
        <purl:Definition>a haemorrhagic stroke AE that is cuased by hypertension (high blood pressure), and bleeding occurs suddenly and rapidly.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>intracerebral haemorrhagic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">intracerebral hemorrhagic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001794 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001794">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001792"/>
        <purl:Definition>a haemorrhagic stroke AE that is cuased by the bleeding (haemorrhage) between the brain and the meninges (the membrane that covers the brain) in the subarachnoid space.</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>subarachnoid haemorrhagic stroke AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">subarachnoid hemorrhagic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001795 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001795">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <purl:Definition>an ischaemic stroke AE that is caused by a thrombus (blood clot) that develops in the arteries supplying blood to the brain</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">thrombotic stroke AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043647</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001796 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001796">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <purl:Definition>an ischaemic stroke AE that is caused by an embolus (a blood clot that formms elsewhere in the body and travels through the bloodstream to the brain).</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/healthlibrary/conditions/nervous_system_disorders/types_of_stroke_85,P00813/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">embolic stroke AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014498</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001797 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001797">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of a mental illness or psychiatiric disorder. The mental illness is a mental or behavioral pattern or anomaly that causes either suffering or an impaired ability to function in ordinary life (disability), and which is not developmentally or socially normative.</purl:Definition>
        <obo1:IAO_0000117>YH, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000118>psychiatric disorder AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Mental_disorder</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">mental disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10037175</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001798 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001798">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>a mental disorder AE that has an outcome of a adjustment disorder. An adjustment disorder is an unexpectedly strong emotional or behavioral reaction that occurs in response to an identifiable stressful life event or life change that occurred within the previous three months.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/adjustment-disorder</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">adjustment disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10001302; MedDRA ID:  10001301</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001799 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001799">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001798"/>
        <purl:Definition>an adjustment disorder AE that has an additional depressed mood. The person is more depressed than would be expected after a stressful event.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.summitmedicalgroup.com/library/adult_health/bha_adjustment_disorder_with_depressed_mood/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">adjustment disorder with depressed mood AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10001297</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001800 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001800">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of bleeding from anastomosis site. Anastomosis: pathological formation of an opening between two normally distinct spaces or organs.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/anastomosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">anastomotic bleeding AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10071781</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001801 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000822"/>
        <purl:Definition>a clostridial infection AE that is caused by C. difficule. </purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/c-difficile/basics/definition/CON-20029664?p=1</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">Clostridium difficile infection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054236</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001802 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001802">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000699"/>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000117>a bacteraemia AE that is more specifically associated with a Gram-negative bacterium.</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">Gram-negative bacteremia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054228</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001805 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of massive amounts of blood loss. A typical Intraoperative hemorrhage has a blood loss exceeding 1000 mL or requires a blood transfusion</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.uptodate.com/contents/management-of-hemorrhage-in-gynecologic-surgery</obo1:IAO_0000119>
        <rdfs:label>Intraoperative hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10055298</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001806 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001806">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <purl:Definition>an abscess AE that shows a cavity of pus within the pancreas</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000270.htm </obo1:IAO_0000119>
        <rdfs:label>pancreatic abscess AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048984</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001807 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001807">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <purl:Definition>a sugery AE that has an adverse outcome where the recipient’s body rejects the pancreas transplantation.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medscape.com/viewarticle/436542_13 </obo1:IAO_0000119>
        <rdfs:label>pancreas transplant rejection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049169</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001808 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001808">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection AE that has an outcome of a severe local inflammation, usually with pus formation, generally caused by one of the pyogenic bacteria.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=44396 </obo1:IAO_0000119>
        <rdfs:label>pyogenic infection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021861</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001809 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001809">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000361"/>
        <purl:Definition>a fever AE that has unknown origin.</purl:Definition>
        <obo1:IAO_0000117>Yongqun He, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medicine.academic.ru/123590/fever_of_unknown_origin</obo1:IAO_0000119>
        <rdfs:label>fever of unknown origin AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016563</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <purl:Definition>a respiratory distress AE that has an outcome of insufficient oxygen flow in the heart and respiratory system.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medicalcenter.osu.edu/patientcare/healthcare_services/lung_diseases/about/signs/Pages/index.aspx, http://www.merriam-webster.com/dictionary/cardiorespiratory</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cardio-respiratory distress AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049874</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>A joint disorder AE that has the presence of increased intra-articular fluid. It can be caused by trauma, arthritis, or gout and often affects the knee.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>PMID: 19915432</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_effusion</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">joint effusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10023215</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001845">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE that shows a problem with the stomach, ranging from indigestion and heartburn to peptic ulcers and GERD.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>stomach disorder AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/stomachdisorders.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">gastric disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056819</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001847 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition xml:lang="en">An inflammation AE that displays an inflammation (not an infection) of the thyroid gland.</purl:Definition>
        <obo1:IAO_0000119 rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.endocrineweb.com/conditions/thyroid/thyroiditis</obo1:IAO_0000119>
        <dc:creator>yongqun he, liwei wang</dc:creator>
        <rdfs:label xml:lang="en">thyroiditis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001848 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001848">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">a urinary system AE that has an outcome of the excretion of glucose into the urine.</purl:Definition>
        <obo1:IAO_0000119>web: http://en.wikipedia.org/wiki/glycosuria</obo1:IAO_0000119>
        <rdfs:comment>LW, YH</rdfs:comment>
        <rdfs:label xml:lang="en">glucosuria AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001850 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001850">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE that shows localized nodular inflammation found in tissues.</purl:Definition>
        <obo1:IAO_0000117>KM, JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Granuloma</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/granuloma/expert-answers/faq-20057838</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=3629</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">granuloma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018691</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001851 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001851">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000771"/>
        <purl:Definition>a burning sensation AE that occurs at the skin.</purl:Definition>
        <obo1:IAO_0000117>KM, JX, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">skin burning sensation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054786</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001852 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001852">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of numbness, a loss of sensation of feeling in a part of the body.  </purl:Definition>
        <obo1:IAO_0000117>YH, JS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/symptoms/numbness/basics/definition/sym-20050938</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">numbness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10029829</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001853 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <purl:Definition>a pneumonia AE that occurs at the interstitial lung. Interstitial pneumonia is often caused by an infection of bacteria, viruses, or fungii. A bacterium called Mycoplasma pneumonia is the most common cause.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/lung/interstitial-lung-disease</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">interstitial pneumonia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022617</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001852"/>
        <purl:Definition>a numbness AE that occurs around the mouth.</purl:Definition>
        <obo1:IAO_0000116>The terms &apos;circumoral numbness AE&apos; and &apos;circumoral paresthesia AE&apos; appear to be synonyms. </obo1:IAO_0000116>
        <obo1:IAO_0000117>YH, JS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://link.springer.com/referenceworkentry/10.1007%2F3-540-29623-9_6515</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">circumoral numbness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10049339</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001855 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <purl:Definition>Skin necrosis AE is a necrosis AE that results in the death of the skin tissue. Skin necrosis often occurs when not enough blood and oxygen are supplied to a given skin region.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>皮肤坏死</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">skin necrosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040893</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS ID: C0151799</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001856 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001856">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000509"/>
        <purl:Definition>Systemic lupus erythematosus (SLE) syndrome AE is a lupus syndrome AE that is systemic and disseminated. SLE most often harms the heart, joints, skin, lungs, blood vessels, liver, kidneys, and nervous system. Although “lupus” actually includes a number of different diseases, SLE is the most common type of lupus, and when people say “lupus,” they are often referring to SLE. </purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>SLE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Systemic_lupus_erythematosus</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/systemic-lupus-erythematosus#Overview1</obo1:IAO_0000119>
        <obo1:OAE_0001849>系统性红斑狼疮综合征</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">systemic lupus erythematosus syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001857 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001857">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">Urgent urination AE is a urinary system AE that has an outcome of a sudden, compelling urge to urinate, along with discomfort in the bladder.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>micturition urgency</obo1:IAO_0000118>
        <obo1:IAO_0000118>urinary urgency</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://sideeffects.embl.de/se/C0085606/</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003140.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>尿急</obo1:OAE_0001849>
        <rdfs:label>urgent urination AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0439609</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001858 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001858">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Precordialgia AE is a pain AE that pain located in the precordial region.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.drugs.com/dict/precordialgia.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>心前痛</obo1:OAE_0001849>
        <rdfs:label>precordialgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001859 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001859">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Dyshidrosis AE is a skin AE that shows a disorder of eccrine sweat glands, characterized by small blisters on the hands or feet.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Dyshidrosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>汗疱疹</obo1:OAE_0001849>
        <rdfs:label>dyshidrosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013912</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001860 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001860">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Ankle swelling AE is an edema AE that shows abnormal buildup of fluid in the ankles. Ankle swelling is a sign of fluid buildup or inflammation of the joint and tissues of the ankle. Mild ankle swelling is a common occurrence after standing for a long period.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/ankle-swelling</obo1:IAO_0000119>
        <obo1:OAE_0001849>踝部水肿</obo1:OAE_0001849>
        <rdfs:label>ankle swelling AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002554</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS ID: C0235439</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001861 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001861">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>Renal dysfunction AE is a kidney AE that has an outcome of reduced capacity to excrete metabolic products which accumulate systemically and are detectable clinicopathologically by renal function tests. The early stage of uremia.</purl:Definition>
        <obo1:IAO_0000116>This term appears to be a synonym to the &apos;renal failure AE&apos;.</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hepatic and renal function disorder AE</obo1:IAO_0000118>
        <obo1:OAE_0001849>肾功能障碍</obo1:OAE_0001849>
        <rdfs:label>renal dysfunction AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0859242</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001862 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Epiphora AE is a eye AE that shows an overflow of tears onto the face. In this case, there is insufficient tear film drainage from the eyes, and the tears will drain down the face rather than through the nasolacrimal system.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epiphora_(medicine)</obo1:IAO_0000119>
        <obo1:OAE_0001849>泪溢</obo1:OAE_0001849>
        <rdfs:label>epiphora AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015068</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS ID: C0152227</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001863 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001863">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <purl:Definition>Hemolytic anemia AE is an anemia AE associated with hemolysis, the abnormal breakdown of red blood cells (RBCs), either in the blood vessels (intravascular hemolysis) or elsewhere in the human body (extravascular). Such an AE can be relatively harmless or life-threatening.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hemolytic_anemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>溶血性贫血</obo1:OAE_0001849>
        <rdfs:label>hemolytic anemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019493</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001864 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001864">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001778"/>
        <purl:Definition>Somniloquy AE is a behavioral AE where somniloquy also is called sleep-talking, a parasomnia that refers to talking aloud while asleep. Somniloquy can be quite loud, ranging from simple mumbling sounds to loud shouts and long frequently inarticulate speeches, and can occur many times during a sleep cycle. As with sleepwalking and night terrors, sleeptalking usually occurs during the less-deep delta-wave NREM sleep stages or during temporary arousals therefrom.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Somniloquy</obo1:IAO_0000119>
        <obo1:OAE_0001849>梦呓</obo1:OAE_0001849>
        <rdfs:label>somniloquy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001865 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001865">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <purl:Definition>Cholelithiasis AE is a liver, biliary, and pancreatic AE that shows hard deposits forming inside the gallbladder. Gallstones may be as small as a grain of sand or as large as a golf ball.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Gallstone</obo1:IAO_0000119>
        <rdfs:label>cholelithiasis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008629</rdfs:seeAlso>
        <rdfs:seeAlso>UMLS ID: C1328486</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001866 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Blepharoptosis AE is an eye AE that shows droopy upper eyelid or ptosis that presents with substantial blockage upper part of field of vision, risk of amblyopia among young children, and dramatic change in the facial appearance.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://eyewiki.aao.org/Blepharoptosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>眼睑下垂</obo1:OAE_0001849>
        <rdfs:label>blepharoptosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005157</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001874 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001874">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002552"/>
        <purl:Definition>an epileptic seizure AE that is characterized by tonic-clonic seizures, involving two phases -- the tonic phase in which the body becomes rigid, and clonic phase in which there is uncontrolled jerking.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=32957</obo1:IAO_0000119>
        <obo1:OAE_0001849>癫痫大发作</obo1:OAE_0001849>
        <rdfs:label>grand mal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018658</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001875 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001875">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <purl:Definition>Erythema simplex AE is an erythema AE that accompany with blushing or redness of the skin caused by a toxic reaction or a neurovascular phenomenon.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/erythema+simplex</obo1:IAO_0000119>
        <obo1:OAE_0001849>单纯性红斑</obo1:OAE_0001849>
        <rdfs:label>erythema simplex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001876 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001876">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Pelvic pain AE is a pain AE that occurs in the lower abdomen area. The pain might be steady, or it might come and go. If the pain is severe, it might get in the way of people&apos;s daily activities.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/pelvicpain.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>骨盆痛</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">pelvic pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034263</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001877 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001877">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Extrasystoles AE is an arrhythmia AE that shows a premature contraction of the heart that is independent of the normal rhythm of the heart and arises in response to an impulse in some part of the heart other than the normal impulse from the sinoatrial node. The extrasystole is followed by a pause, as the heart electrical system &quot;resets&quot; itself and the contraction following the pause is usually more forceful than normal.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=32159</obo1:IAO_0000119>
        <obo1:OAE_0001849>早搏（额外收缩）</obo1:OAE_0001849>
        <rdfs:label>extrasystoles AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015856</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001878 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001878">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>An increased upper airway secretion AE is a respiratory system AE characterized by an increased secretion at the upper airway location.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">increased upper airway secretion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062717</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001879 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001879">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000945"/>
        <purl:Definition>Feeling of body temperature change AE is a feeling abnormal AE that a patient feels a change in body temperature. </purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">feeling of body temperature change AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061458</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001880 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001880">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <purl:Definition>Heartburn AE is a gastric disorder AE that also known as pyrosis, cardialgia, or acid indigestion. It&apos;s a burning sensation in the chest, just behind the breastbone or in the epigastrium, the upper central abdomen. The pain often rises in the chest and may radiate to the neck, throat, or angle of the jaw.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Heartburn</obo1:IAO_0000119>
        <obo1:OAE_0001849>胃灼热（烧心）</obo1:OAE_0001849>
        <rdfs:label>heartburn AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019326</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001881 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001881">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Tonsillitis AE is an inflammation AE that is inflammation of the tonsils most commonly caused by viral or bacterial infection. Symptoms may include sore throat and fever.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tonsillitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>扁桃体炎</obo1:OAE_0001849>
        <rdfs:label>tonsillitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044008</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001882 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <purl:Definition>Non-insulin-dependent diabetes mellitus AE is a diabetes mellitus AE which is also called diabetes mellitus type 2, it&apos;s characterized by hyperglycemia (high blood sugar) in the context of insulin resistance and relative lack of insulin.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diabetes_mellitus_type_2</obo1:IAO_0000119>
        <obo1:OAE_0001849>非胰岛素依赖型糖尿病</obo1:OAE_0001849>
        <rdfs:label>non-insulin-dependent diabetes mellitus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029505</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001883 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001883">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <purl:Definition>Insulin dependent diabetes mellitus AE is a diabetes mellitus AE which is also called diabetes mellitus type 1. It results from the autoimmune destruction of the insulin-producing beta cells in the pancreas.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diabetes_mellitus_type_1</obo1:IAO_0000119>
        <obo1:OAE_0001849>胰岛素依赖型糖尿病</obo1:OAE_0001849>
        <rdfs:label xml:lang="zh">insulin dependent diabetes mellitus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022497</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001884 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001884">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>Areflexia AE is a nervous system AE that shows absence of neurologic reflexes such as the knee jerk reaction.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=20423</obo1:IAO_0000119>
        <obo1:OAE_0001849>反射消失</obo1:OAE_0001849>
        <rdfs:label>areflexia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003084</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001885 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001885">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>Mastauxea AE is a reproductive system AE that shows enlargement of the breast.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/mastauxe</obo1:IAO_0000119>
        <obo1:OAE_0001849>乳房增大</obo1:OAE_0001849>
        <rdfs:label xml:lang="zh">mastauxe AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001886 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001886">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Uveitis AE is an inflammation AE that is inflammation of the uvea, which lines the inside of the eye behind the cornea.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Uveitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>色素层炎</obo1:OAE_0001849>
        <rdfs:label xml:lang="zh">uveitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10046851</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001887">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>Sexual dysfunctions AE is a reproductive system AE that is difficulty experienced by an individual or a couple during any stage of a normal sexual activity, including physical pleasure, desire, preference, arousal or orgasm.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>sexual malfunction AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sexual_dysfunction</obo1:IAO_0000119>
        <obo1:OAE_0001849>性功能障碍</obo1:OAE_0001849>
        <rdfs:label>sexual dysfunctions AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040477</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001888 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001888">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Hypomnesia AE is a behavior and neurological AE that is an archaic term applied to poor memory, the impaired ability to recall information previously memorized.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://psychology.wikia.com/wiki/Hypomnesia</obo1:IAO_0000119>
        <obo1:OAE_0001849>记忆减退</obo1:OAE_0001849>
        <rdfs:label>hypomnesia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10021035</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001889 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001889">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Phobia AE is a behavior and neurological AE that is a type of anxiety disorder, usually defined as a persistent fear of an object or situation in which the sufferer commits to great lengths in avoiding, typically disproportional to the actual danger posed, often being recognized as irrational.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Phobia</obo1:IAO_0000119>
        <obo1:OAE_0001849>恐惧症</obo1:OAE_0001849>
        <rdfs:label>phobia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10034912</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001890 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Lymphadenectasis AE is an edema AE that shows enlargement of the lymph node.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/lymphadenectasis</obo1:IAO_0000119>
        <obo1:OAE_0001849>淋巴结肿大</obo1:OAE_0001849>
        <rdfs:label>lymphadenectasis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10025282</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001891 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <purl:Definition>Asterixis AE is a tremor AE that also called the flapping tremor, or liver flap, which is a tremor of the hand when the wrist is extended, sometimes said to resemble a bird flapping its wings. This motor disorder is characterized by an inability to actively maintain a position, which is demonstrated by jerking movements of the outstretched hands when bent upward at the wrist. The tremor is caused by abnormal function of the diencephalic motor centers in the brain, which regulate the muscles involved in maintaining position.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Asterixis</obo1:IAO_0000119>
        <obo1:OAE_0001849>扑翼样震颤</obo1:OAE_0001849>
        <rdfs:label>asterixis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003547</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001892 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001892">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition>Parageusia AE is a gustatory system AE which is the medical term for a bad taste in the mouth. One common form of parageusia is a metallic taste of food. This can be a side effect of several medications, such as acetazolamide, eszopiclone, zopiclone, metronidazole, or etoposide. Metallic taste is also a type of dysgeusia which is frequently associated with infections in the mouth or upper airways.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parageusia</obo1:IAO_0000119>
        <obo1:OAE_0001849>味觉颠倒</obo1:OAE_0001849>
        <rdfs:label>parageusia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10033793</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001893 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001893">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>Brain damage AE is a brain AE that also called brain injury is the destruction or degeneration of brain cells. In general, brain damage refers to significant, undiscriminating trauma-induced damage.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Brain_damage</obo1:IAO_0000119>
        <obo1:OAE_0001849>脑损伤</obo1:OAE_0001849>
        <rdfs:label>brain damage AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056389</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001894 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001894">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <purl:Definition>Frequent bowel movements AE is a abnormal stool AE that people are having more bowel movements than is normal for them. Often, frequent bowel movements are accompanied by diarrhea, the passage of loosely formed stool.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/frequent-bowel-movements</obo1:IAO_0000119>
        <obo1:OAE_0001849>大便频繁</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">frequent bowel movements AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10017367</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001895 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001895">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001647"/>
        <purl:Definition>Hyperprolactinemia AE is an endocrine investigation result abnormal AE that is the presence of abnormally high levels of prolactin in the blood. Normal levels are less than 500 mIU/L [20 ng/mL or µg/L] for women, and less than 450 mIU/L for men.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperprolactinaemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>高泌乳素血症</obo1:OAE_0001849>
        <rdfs:label>hyperprolactinemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020739</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001896 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001896">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>Galactorrhea AE is a reproductive system AE that is the spontaneous flow of milk from the breast, unassociated with childbirth or nursing.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Galactorrhea</obo1:IAO_0000119>
        <obo1:OAE_0001849>乳溢</obo1:OAE_0001849>
        <rdfs:label>galactorrhea AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10017592</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001897 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001897">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Sitophobia AE is a behavior and neurological AE that shows a morbid or insane dread of eating.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/sitophobia</obo1:IAO_0000119>
        <obo1:OAE_0001849>畏食</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">sitophobia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001898 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001898">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>Ejection murmur AE is a cardiac disorder AE which is due to turbulent forward flow across the right and left ventricular outflow tract, aortic or pulmonary valve, or through the aorta or pulmonary artery.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.cardiologysite.com/auscultation/html/ejection_murmurs.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>收缩期喷射性杂音</obo1:OAE_0001849>
        <rdfs:label>ejection murmur AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001899 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001130"/>
        <purl:Definition>Hypoactive sexual desire disorder AE is a libido disorder AE that is considered a sexual dysfunction and is characterized as a lack or absence of sexual fantasies and desire for sexual activity, as judged by a clinician.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hyposexuality AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypoactive_sexual_desire_disorder</obo1:IAO_0000119>
        <obo1:OAE_0001849>性欲减退</obo1:OAE_0001849>
        <rdfs:label>hypoactive sexual desire disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020933</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001900 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001900">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Bigotry AE is a behavior and neurological AE that is a state of mind where a person strongly and unfairly dislikes other people, ideas, etc.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bigotry</obo1:IAO_0000119>
        <obo1:OAE_0001849>偏执</obo1:OAE_0001849>
        <rdfs:label>bigotry AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001901 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Somnambulisma AE is a behavior and neurological AE that also known as sleepwalking or noctambulism, which is a sleep disorder belonging to the parasomnia family. It arise from the slow wave sleep stage in a state of low consciousness and perform activities that are usually performed during a state of full consciousness. These activities can be as benign as sitting up in bed, walking to the bathroom, and cleaning, or as hazardous as cooking, driving, violent gestures, grabbing at hallucinated objects, or even homicide.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>noctambulism AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>sleepwalking AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sleepwalking</obo1:IAO_0000119>
        <obo1:OAE_0001849>梦游症</obo1:OAE_0001849>
        <rdfs:label>somnambulism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10041347</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001902 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001902">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000903"/>
        <purl:Definition>Hyperphagia AE is an eating disorder AE that also called polyphagia. It&apos;s a medical sign meaning excessive hunger and abnormally large intake of solids by mouth. It can be caused by disorders such as diabetes, Kleine–Levin syndrome (a malfunction in the hypothalamus), the genetic disorders Prader–Willi syndrome, and Bardet–Biedl syndrome.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>polyphagia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>食欲过盛</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyphagia</obo1:IAO_0000119>
        <rdfs:label>hyperphagia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020710</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001903 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001903">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Corneal pigmentation is a eye AE shows that  the melanin is in the superficial stroma and the basal layer of the corneal epithelium.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/corneal+pigmentation</obo1:IAO_0000119>
        <obo1:OAE_0001849>角膜色素沉着</obo1:OAE_0001849>
        <rdfs:label>corneal pigmentation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011040</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001904 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001904">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Chromatos AE is a skin AE shows that deposit of pigment in a normally unpigmented area or excessive pigmentation in a normally pigmented site.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/medical/chromatosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>色素沉着</obo1:OAE_0001849>
        <rdfs:label>chromatosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001905 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001905">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <purl:Definition>Subclavian steal syndrome AE is an ischaemia AE that is a constellation of signs and symptoms that arise from retrograde (reversed) flow of blood in the vertebral artery or the internal thoracic artery, due to a proximal stenosis (narrowing) and/or occlusion of the subclavian artery. The arm may be supplied by blood flowing in a retrograde direction down the vertebral artery at the expense of the vertebrobasilar circulation. This is called the subclavian steal.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>subclavian steal phenomenon AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>subclavian steal steno-occlusive disease AE</obo1:IAO_0000118>
        <obo1:OAE_0001849>锁骨下动脉盗血综合征</obo1:OAE_0001849>
        <rdfs:label>subclavian steal syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10042335</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001906 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001906">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000350"/>
        <purl:Definition>Allergic rhinitis AE is a rhinitis AE that is an allergic inflammation of the nasal airways. It occurs when an allergen, such as pollen, dust, or animal dander (particles of shed skin and hair) is inhaled by an individual with a sensitized immune system.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Allergic_rhinitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>过敏性鼻炎</obo1:OAE_0001849>
        <rdfs:label>allergic rhinitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001723</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001907 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001907">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000783"/>
        <purl:Definition>Ventricular ectopic beats AE is a cardiac ventricular disorder AE that is a disturbance of the cardiac rhythm frequently related to the electrical conduction system of the heart, in which beats arise from fiber or group of fibers outside the region in the heart muscle ordinarily responsible for impulse formation.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ectopic_beat</obo1:IAO_0000119>
        <obo1:OAE_0001849>心室异位搏动</obo1:OAE_0001849>
        <rdfs:label>ventricular ectopic beats AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10058291</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001908 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001908">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Sjogren syndrome AE is a eye AE that  is a chronic autoimmune disease in which the body&apos;s white blood cells destroy the exocrine glands, specifically the salivary and lacrimal glands, that produce saliva and tears, respectively.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sj%C3%B6gren&apos;s_syndrome</obo1:IAO_0000119>
        <obo1:OAE_0001849>干燥综合症</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">sjogren syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040767</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001909 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001909">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <purl:Definition>Nocturia AE is a urine abnormality AE that is defined by the International Continence Society as “the complaint that the individual has to wake at night one or more times for voiding”.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>nycturia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nocturia</obo1:IAO_0000119>
        <obo1:OAE_0001849>夜尿症</obo1:OAE_0001849>
        <rdfs:label>nocturia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029446</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001910 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000401"/>
        <purl:Definition>Night sweat is a sweating AE that is the occurrence of excessive sweating (hyperhidrosis and focal hyperhidrosis) during sleep. The sufferer may or may not also suffer from excessive perspiration while awake.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>sleep hyperhidrosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Night_sweats</obo1:IAO_0000119>
        <obo1:OAE_0001849>夜汗</obo1:OAE_0001849>
        <rdfs:label>night sweat AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029409</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition>Increased appetite AE is a gustatory system AE that is when people want to eat much more often or in larger quantities than their body requires.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/symptom/increased-appetite</obo1:IAO_0000119>
        <obo1:OAE_0001849>食欲增加</obo1:OAE_0001849>
        <rdfs:label>increased appetite AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021654</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <purl:Definition>Vascular dilatation headache AE is a headache AE that shows headache which caused by vascular dilatation.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.headaches.org/education/Headache_Topic_Sheets/Vascular_Headaches</obo1:IAO_0000119>
        <obo1:OAE_0001849>血管扩张性头痛</obo1:OAE_0001849>
        <rdfs:label>vascular dilatation headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>Bundle-branch block AE is a conduction system disorder AE that refers to a defect of the heart&apos;s electrical conduction system.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bundle_branch_block</obo1:IAO_0000119>
        <obo1:OAE_0001849>束支传导阻滞</obo1:OAE_0001849>
        <rdfs:label>bundle-branch block AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006578</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001914 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001914">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000501"/>
        <purl:Definition>Unstable diabetes AE is a diabetes mellitus AE that is a type of diabetes when a person&apos;s blood glucose level often swings quickly from high to low and from low to high.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>brittle diabetes AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>labile diabetes AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=7271</obo1:IAO_0000119>
        <obo1:OAE_0001849>不稳定型糖尿病</obo1:OAE_0001849>
        <rdfs:label>unstable diabetes AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006372</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001915 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001915">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <purl:Definition>Tendon rupture AE is a tendon disorder AE shows a tearing of the tendon that occurs when the forces placed upon the tendon exceed its tensile strength.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Tendon+rupture</obo1:IAO_0000119>
        <obo1:OAE_0001849>肌腱断裂</obo1:OAE_0001849>
        <rdfs:label>tendon rupture AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043248</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001916 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001916">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Tendovaginitis AE is an inflammation AE that is an acute or chronic inflammation of the tendon sheath, occurring in the region of the hand, the wrist joint, the forearm (radial and ulnar tenobursitis), the foot, the ankle joint, and the Achilles tendon (achillobursitis).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>tenovaginitis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://encyclopedia2.thefreedictionary.com/Tendovaginitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>腱鞘炎</obo1:OAE_0001849>
        <rdfs:label>tendovaginitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10067216</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001917 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001917">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <purl:Definition>Loose stools AE is a abnormal stool AE that is usually a form of diarrhea and many conditions causing loose stool will be listed under diarrhea. It may also be related to watery stool (also within the spectrum of diarrhea).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/loose_stool.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>稀便</obo1:OAE_0001849>
        <rdfs:label>loose stools AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10024840</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001918 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001918">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Cystitis AE is an inflammation AE that is the medical term for inflammation of the bladder. Most of the time, the inflammation is caused by a bacterial infection, and it&apos;s called a urinary tract infection.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/cystitis/basics/definition/con-20024076</obo1:IAO_0000119>
        <obo1:OAE_0001849>膀胱炎</obo1:OAE_0001849>
        <rdfs:label>cystitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011781</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001919 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001919">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Eructation AE is a digestive system AE that is the release of gas from the digestive tract (mainly esophagus and stomach) through the mouth. It is usually accompanied with a typical sound and, at times, an odor.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>belching AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>burping AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>ructus AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Burping</obo1:IAO_0000119>
        <obo1:OAE_0001849>嗳气</obo1:OAE_0001849>
        <rdfs:label>eructation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015137</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001920 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001920">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <purl:Definition>Glossolalia AE is a speech disorder AE that is the fluid vocalizing of speech-like syllables that lack any readily comprehended meaning.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glossolalia</obo1:IAO_0000119>
        <obo1:OAE_0001849>语言不清</obo1:OAE_0001849>
        <rdfs:label>glossolalia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001921 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001921">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Leg pain AE is a pain AE that  is a common problem in leg, it can be due to a cramp, injury, or other cause.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003182.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>腿痛</obo1:OAE_0001849>
        <rdfs:label>leg pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10024130</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001922 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001922">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Stomachache AE is a pain AE that  the pain in or near your stomach. It is a common symptom associated with transient disorders or serious disease.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>abdominal pain AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abdominal_pain
http://www.nhs.uk/conditions/stomach-ache-abdominal-pain/Pages/Introduction.aspx</obo1:IAO_0000119>
        <obo1:OAE_0001849>胃痛</obo1:OAE_0001849>
        <rdfs:label>stomachache AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10042126</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001923 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001923">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>Conduction block AE is a conduction system disorder AE that shows failure of impulse transmission at some point along a nerve fiber, although conduction along the segments proximal and distal to it are unaffected.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=10757</obo1:IAO_0000119>
        <obo1:OAE_0001849>传导阻滞</obo1:OAE_0001849>
        <rdfs:label>conduction block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001924 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <purl:Definition>Photodermatitis AE is a dermatitis AE that referred to as sun poisoning or photoallergy, is a form of allergic contact dermatitis in which the allergen must be activated by light to sensitize the allergic response, and to cause a rash or other systemic effects on subsequent exposure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Photodermatitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>光敏性皮炎</obo1:OAE_0001849>
        <rdfs:label>photodermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001925 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Pygalgia AE is a pain AE that  is a rarely used term meaning pain in the buttocks.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=74312</obo1:IAO_0000119>
        <obo1:OAE_0001849>臀痛</obo1:OAE_0001849>
        <rdfs:label>pygalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001926 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001926">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000081"/>
        <purl:Definition>Throat irritation AE is a discomfort AE that refers to a dry cough, a scratchy feeling at the back of the throat, or a sensation of a lumpy feeling or something stuck at the back of the throat.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>throat discomfort AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Throat_irritation</obo1:IAO_0000119>
        <obo1:OAE_0001849>咽喉不适</obo1:OAE_0001849>
        <rdfs:label>throat irritation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043521</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001927 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001927">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Interstitial nephritis AE is an inflammation AE that is a form of nephritis affecting the interstitium of the kidneys surrounding the tubules. This disease can be either acute, meaning it occurs suddenly, or chronic, meaning it is ongoing and eventually ends in kidney failure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>tubulointerstitial nephritis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Interstitial_nephritis</obo1:IAO_0000119>
        <obo1:OAE_0001849>间质肾炎</obo1:OAE_0001849>
        <rdfs:label>interstitial nephritis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048302</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001928 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001928">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000484"/>
        <purl:Definition>Hoarseness AE is a hoarseness AE that refers to a difficulty making sounds when trying to speak. Vocal sounds may be weak, breathy, scratchy, or husky, and the pitch or quality of the voice may change.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003054.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>声音嘶哑</obo1:OAE_0001849>
        <rdfs:label>hoarseness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020201</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001929 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <purl:Definition>Photosensitization AE is a hypersensitivity AE that refers to  development of abnormally heightened reactivity of the skin or eyes to sunlight.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/photosensitization</obo1:IAO_0000119>
        <obo1:OAE_0001849>光敏</obo1:OAE_0001849>
        <rdfs:label>photosensitization AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001930 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001930">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>Fanconi syndrome AE is a kidney AE that is a disease of the proximal renal tubules of the kidney in which glucose, amino acids, uric acid, phosphate and bicarbonate are passed into the urine, instead of being reabsorbed.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Fanconi_syndrome</obo1:IAO_0000119>
        <obo1:OAE_0001849>范可尼综合征</obo1:OAE_0001849>
        <rdfs:label>fanconi syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016219</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Keratoconjunctivitis AE is an inflammation AE that is inflammation of the cornea and conjunctiva. When only the cornea is inflamed, it is called keratitis; when only the conjunctiva is inflamed, it is called conjunctivitis.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Keratoconjunctivitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>角膜结膜炎</obo1:OAE_0001849>
        <rdfs:label>keratoconjunctivitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023348</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001932 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001932">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition>Hepatic insufficiency AE is a liver disorder AE that shows a failure or partial failure of normal liver function.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hepatic+insufficiency</obo1:IAO_0000119>
        <obo1:OAE_0001849>肝功能不全</obo1:OAE_0001849>
        <rdfs:label>hepatic insufficiency AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056542</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001623"/>
        <purl:Definition>Hypoxemia AE is a blood gas investigation result abnormal AE that is an abnormally low level of oxygen in the blood. More specifically, it is oxygen deficiency in arterial blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypoxemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>低血氧症</obo1:OAE_0001849>
        <rdfs:label>hypoxemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021142</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001934 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001934">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <purl:Definition>Irritant contact dermatitis AE is a dermatitis AE that is a form of contact dermatitis that can be divided into forms caused by chemical irritants and those caused by physical irritants.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Irritant_contact_dermatitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>刺激性接触性皮炎</obo1:OAE_0001849>
        <rdfs:label>irritant contact dermatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Pitting edema AE is an edema AE that shows observable swelling of body tissues due to fluid accumulation that may be demonstrated by applying pressure to the swollen area (such as by depressing the skin with a finger).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=88528</obo1:IAO_0000119>
        <obo1:OAE_0001849>指压性水肿</obo1:OAE_0001849>
        <rdfs:label>pitting edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054547</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001936 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000462"/>
        <purl:Definition>Acute bronchitis AE is a bronchitis AE that is an inflammation of the large bronchi (medium-size airways) in the lungs that is usually caused by viruses or bacteria and may last several days or weeks. Characteristic symptoms include cough, sputum (phlegm) production, and shortness of breath and wheezing related to the obstruction of the inflamed airways.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_bronchitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>急性支气管炎</obo1:OAE_0001849>
        <rdfs:label>acute bronchitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10000687</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001937 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>Renal calculus AE is a kidney AE that is a solid concretion or crystal aggregation formed in the kidneys from minerals in the urine. Kidney stones typically leave the body by passage in the urine stream, and many stones are formed and passed without causing symptoms. If stones grow to sufficient size (usually at least 3 millimeters (0.12 in)) they can cause blockage of the ureter. This leads to pain, most commonly beginning in the flank or lower back and often radiating to the groin or genitals.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>kidney stone AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>nephrolithiasis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Kidney_stone</obo1:IAO_0000119>
        <obo1:OAE_0001849>肾结石</obo1:OAE_0001849>
        <rdfs:label>renal calculus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038386</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001938 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001938">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>Clouding of consciousness AE is a sensory capability AE that is a term used in conventional medicine denoting an abnormality in the &quot;regulation&quot; of the &quot;overall level&quot; of consciousness that is mild and less severe than a delirium. The sufferer experiences a subjective sensation of mental clouding described as feeling &quot;foggy&quot;.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>brain fog AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>mental fog AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Clouding_of_consciousness</obo1:IAO_0000119>
        <obo1:OAE_0001849>意识模糊</obo1:OAE_0001849>
        <rdfs:label>clouding of consciousness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001939 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001939">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <purl:Definition>Reflex tachycardia AE is a tachycardia AE that shows increased heart rate in response to some stimulus conveyed through the cardiac nerves.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=89526</obo1:IAO_0000119>
        <obo1:OAE_0001849>反射性心动过速</obo1:OAE_0001849>
        <rdfs:label>reflex tachycardia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10063096</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001940 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>Joint sprain AE is a joint disorder AE that is damage to one or more ligaments in a joint, often caused by trauma or the joint being taken beyond its functional range of motion.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sprain</obo1:IAO_0000119>
        <obo1:OAE_0001849>关节扭伤</obo1:OAE_0001849>
        <rdfs:label>joint sprain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023229</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001941 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Epicondylitis AE is an inflammation AE that is a type of musculoskeletal disorder that refers to an inflammation of an epicondyle.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epicondylitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>上髁炎</obo1:OAE_0001849>
        <rdfs:label>epicondylitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014971</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000513"/>
        <purl:Definition>Melanoglosia AE is a tongue AE that shows tongue turn black. Any blackening of the tongue associated with certain disorders and diseases in animals and humans.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://encyclopedia2.thefreedictionary.com/melanoglosia</obo1:IAO_0000119>
        <obo1:OAE_0001849>舌黑</obo1:OAE_0001849>
        <rdfs:label>melanoglosia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014971</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001943 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001943">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <purl:Definition>Ventricular tachycardia AE is a tachycardia AE that is a type of tachycardia, or a rapid heart beat that arises from improper electrical activity of the heart presenting as a rapid heart rhythm, that starts in the bottom chambers of the heart, called the ventricles.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ventricular_tachycardia</obo1:IAO_0000119>
        <obo1:OAE_0001849>心室性心搏过速</obo1:OAE_0001849>
        <rdfs:label>ventricular tachycardia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10047302</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001944 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001944">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000210"/>
        <purl:Definition>Granulomatous hepatitis AE is a hepatitis AE that refers to an inflammatory liver disease associated with granuloma formation in the liver.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://radiopaedia.org/articles/granulomatous-hepatitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>肉芽肿性肝炎</obo1:OAE_0001849>
        <rdfs:label>granulomatous hepatitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition>Hypogeusia AE is a gustatory system AE that is a reduced ability to taste things (to taste sweet, sour, bitter, or salty substances).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypogeusia</obo1:IAO_0000119>
        <obo1:OAE_0001849>味觉减弱</obo1:OAE_0001849>
        <rdfs:label>hypogeusia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020989</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001946 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001946">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Dysphoria AE is a behavior and neurological AE that is a profound state of unease or dissatisfaction. In a psychiatric context, dysphoria may accompany depression, anxiety, or agitation. Common reactions to dysphoria include emotional distress or indifference.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Dysphoria</obo1:IAO_0000119>
        <obo1:OAE_0001849>烦躁不安</obo1:OAE_0001849>
        <rdfs:label>dysphoria AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013954</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001947 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Oneirism AE is a behavior and neurological AE that is a state of abnormal consciousness in which dream-like experiences and hallucinations happen while awake.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/oneirism</obo1:IAO_0000119>
        <obo1:OAE_0001849>梦幻症</obo1:OAE_0001849>
        <rdfs:label>oneirism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10030332</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Podalgia AE is a pain AE that  shows pain in the foot.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/podalgia</obo1:IAO_0000119>
        <obo1:OAE_0001849>足痛</obo1:OAE_0001849>
        <rdfs:label>podalgia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001949 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001949">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Brachialgia AE is a pain AE that  shows pain in the arm.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/brachialgia</obo1:IAO_0000119>
        <obo1:OAE_0001849>臂痛</obo1:OAE_0001849>
        <rdfs:label>brachialgia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10068901</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Coxalgia AE is a pain AE that  shows pain in the hip.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/coxalgia</obo1:IAO_0000119>
        <obo1:OAE_0001849>髋痛</obo1:OAE_0001849>
        <rdfs:label>coxalgia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011249</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001951 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001951">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <purl:Definition>Limb injury AE is an injury AE which involve damage to bones, joints, ligament, musles, the major blood vessels and nerves of the limb.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>肢体伤</obo1:OAE_0001849>
        <rdfs:label>limb injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10061225</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001952 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001952">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <purl:Definition>Polymyalgia rheumatica AE is a muscle pain AE that is a syndrome with pain or stiffness, usually in the neck, shoulders, and hips. The pain can be very sudden, or can occur gradually over a period. It may be caused by an inflammatory condition of blood vessels such as temporal arteritis.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polymyalgia_rheumatica</obo1:IAO_0000119>
        <obo1:OAE_0001849>风湿性多发性肌痛</obo1:OAE_0001849>
        <rdfs:label>polymyalgia rheumatica AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036099</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <purl:Definition>Fibromyalgia AE is a muscle pain AE that is characterised by chronic widespread pain and allodynia (a heightened and painful response to pressure). Fibromyalgia symptoms are not restricted to pain, leading to the use of the alternative term fibromyalgia syndrome for the condition. Other symptoms include debilitating fatigue, sleep disturbance, and joint stiffness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Fibromyalgia</obo1:IAO_0000119>
        <obo1:OAE_0001849>纤维肌痛</obo1:OAE_0001849>
        <rdfs:label>fibromyalgia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048439</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001954 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001954">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000494"/>
        <purl:Definition>Hepatic encephalopathy AE is an encephalopathy AE that  is the occurrence of confusion, altered level of consciousness, and coma as a result of liver failure. In the advanced stages it is called hepatic coma or coma hepaticum.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>portosystemic encephalopathy AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hepatic_encephalopathy</obo1:IAO_0000119>
        <rdfs:label>hepatic encephalopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019660</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001955 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001955">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001789"/>
        <purl:Definition>Chorea AE is a neurological AE that is an abnormal involuntary movement disorder, one of a group of neurological disorders called dyskinesias.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>choreia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chorea</obo1:IAO_0000119>
        <obo1:OAE_0001849>舞蹈症</obo1:OAE_0001849>
        <rdfs:label>chorea AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008748</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001956 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001956">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001403"/>
        <purl:Definition>Nightmare AE is a sleep disorder AE that is an unpleasant dream that can cause a strong emotional response from the mind, typically fear or horror but also despair, anxiety and great sadness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nightmare</obo1:IAO_0000119>
        <obo1:OAE_0001849>梦魇</obo1:OAE_0001849>
        <rdfs:label>nightmare AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029412</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001957 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Depersonalization AE is a mental disorder AE that is an anomaly of self-awareness. It consists of a feeling of watching oneself act, while having no control over a situation. Subjects feel they have changed, and the world has become vague, dreamlike, less real, or lacking in significance. It can be a disturbing experience, since many feel that, indeed, they are living in a &quot;dream&quot;.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>depersonalisation AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Depersonalization</obo1:IAO_0000119>
        <obo1:OAE_0001849>人格解体</obo1:OAE_0001849>
        <rdfs:label>depersonalization AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012359</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001958 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001958">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Apatheia AE is a mental disorder AE that refers to a state of mind where one is not disturbed by the passions.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>apathia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Apatheia</obo1:IAO_0000119>
        <obo1:OAE_0001849>情感冷漠</obo1:OAE_0001849>
        <rdfs:label>apatheia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001959 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001959">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>Parosmia AE is a sensory capability AE that is an olfactory dysfunction which is characterized by the inability of the brain to properly identify an odor’s “natural” smell.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cacosmia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>troposmia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>味觉倒错</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parosmia</obo1:IAO_0000119>
        <rdfs:label>parosmia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034018</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001960 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001960">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Xerophthalmia AE is an eye AE that is a medical condition in which the eye fails to produce tears.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>xerophthalmus AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Xerophthalmia</obo1:IAO_0000119>
        <obo1:OAE_0001849>干眼病</obo1:OAE_0001849>
        <rdfs:label>xerophthalmia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048221</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001961 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001961">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <purl:Definition>Chondropathy AE is a bone disorder AE that refers to a disease of the cartilage. It is frequently divided into 5 grades, with 0-2 defined as normal, and 3-4 defined as diseased.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chondropathy</obo1:IAO_0000119>
        <obo1:OAE_0001849>软骨病</obo1:OAE_0001849>
        <rdfs:label>chondropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061762</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001962 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001962">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <purl:Definition>Teratogenesis AE is a female reproductive system AE that is a prenatal toxicity characterized by structural or functional defects in the developing embryo or fetus. It also includes intrauterine growth retardation, death of the embryo or fetus, and transplacental carcinogenesis.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.britannica.com/EBchecked/topic/587782/teratogenesis</obo1:IAO_0000119>
        <obo1:OAE_0001849>畸胎</obo1:OAE_0001849>
        <rdfs:label>teratogenesis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001963 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001963">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Premature atrial contraction AE is an arrhythmia AE that is a common cardiac dysrhythmia characterized by premature heartbeats originating in the atria.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>atrial premature beats AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>atrial premature complexes AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Premature_atrial_contraction</obo1:IAO_0000119>
        <obo1:OAE_0001849>早搏</obo1:OAE_0001849>
        <rdfs:label>premature atrial contraction AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056964</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001964 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001964">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>An inflammation AE that courrs in one or both parotid glands, the major salivary glands located on either side of the face, in humans. The parotid gland is the salivary gland most commonly affected by inflammation.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parotitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>腮腺炎</obo1:OAE_0001849>
        <rdfs:label>parotitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034038</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001965 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Glossitis AE is an inflammation AE that can mean soreness of the tongue, or more usually inflammation with depapillation of the dorsal surface of the tongue, leaving a smooth and erythematous surface.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Glossitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>舌炎</obo1:OAE_0001849>
        <rdfs:label>glossitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018386</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001966 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001966">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Genital edema AE is an edema AE that can be the result of interruption to the lymphatic drainage of this area caused by tumor, surgical removal of lymph nodes, radiotherapy or infection. Congenital disorders causing inadequate lymphatics can sometimes lead to the development of this condition.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.lymphoedemanz.org.nz/About+Lymphoedema/Genital+Oedema.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>生殖器水肿</obo1:OAE_0001849>
        <rdfs:label>genital edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018146</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001967 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001967">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>Orgasm incapacity AE is a reproductive system AE that the disorder characterized by an inability to achieve orgasm.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>缺乏性高潮</obo1:OAE_0001849>
        <rdfs:label>orgasm incapacity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001968 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001968">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Sedation AE is a behavior and neurological AE that is the reduction of irritability or agitation by administration of sedative drugs, generally to facilitate a medical procedure or diagnostic procedure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sedation</obo1:IAO_0000119>
        <obo1:OAE_0001849>镇静</obo1:OAE_0001849>
        <rdfs:label>sedation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039897</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001969 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000218"/>
        <purl:Definition>Sinus bradycardia AE is a bradycardia AE that is a heart rhythm that originates from the sinus node and has a rate that is lower than normal. In humans, bradycardia is generally defined to be a rate of under 60 beats per minute.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinus_bradycardia</obo1:IAO_0000119>
        <obo1:OAE_0001849>窦性心动过缓</obo1:OAE_0001849>
        <rdfs:label>sinus bradycardia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040741</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001970 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001970">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>Cardiac output decreased AE is a cardiac disorder AE that shows a state in which the blood pumped by an individual&apos;s heart is sufficiently reduced that it is inadequate to meet the needs of the body&apos;s tissues. Cardiac output is the volume of blood being pumped by the heart, in particular by a left or right ventricle in the time interval of one minute.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www1.us.elsevierhealth.com/MERLIN/Gulanick/archive/Constructor/gulanick10.html
http://en.wikipedia.org/wiki/Cardiac_output</obo1:IAO_0000119>
        <obo1:OAE_0001849>心输出量减少</obo1:OAE_0001849>
        <rdfs:label>cardiac output decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007595</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001971 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001971">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Steatorrhea AE is a digestive system AE that is the presence of excess fat in feces. Stools may also float due to excess lipid, have an oily appearance and can be especially foul-smelling.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>steatorrhoea AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Steatorrhea</obo1:IAO_0000119>
        <obo1:OAE_0001849>脂溢</obo1:OAE_0001849>
        <rdfs:label>steatorrhea AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041968</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001972 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001972">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Malabsorption syndrome AE is a digestive system AE that refers to a number of disorders in which the intestine’s ability to absorb certain nutrients, such as vitamin B12 and iron, into the bloodstream is negatively affected.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/malabsorption#Overview1</obo1:IAO_0000119>
        <obo1:OAE_0001849>吸收不良综合症</obo1:OAE_0001849>
        <rdfs:label>malabsorption syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10025479</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001973 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001973">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Sialadenitis AE is an inflammation AE that is inflammation of a salivary gland. It may be subdivided temporally into acute, chronic and recurrent forms.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sialadenitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>唾液腺炎</obo1:OAE_0001849>
        <rdfs:label>sialadenitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040627</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001974 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001789"/>
        <purl:Definition>Parkinson&apos;s disease AE is a neurological AE that is a degenerative disorder of the central nervous system. The motor symptoms of Parkinson&apos;s disease result from the death of dopamine-generating cells in the substantia nigra, a region of the midbrain, the cause of this cell death is unknown.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>choreia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>hypokinetic rigid syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>idiopathic/primary parkinsonism AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>paralysis agitans AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Parkinson&apos;s_disease</obo1:IAO_0000119>
        <obo1:OAE_0001849>帕金森综合症</obo1:OAE_0001849>
        <rdfs:label>parkinson&apos;s disease AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061536</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001975 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001975">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition>Urinary calculus AE a urinary system AE that is solid particles in the urinary system. They may cause pain, nausea, vomiting, hematuria, and, possibly, chills and fever due to secondary infection.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>urinary calculi AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.merckmanuals.com/professional/genitourinary_disorders/urinary_calculi/urinary_calculi.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>尿结石</obo1:OAE_0001849>
        <rdfs:label>urinary calculus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10046531</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001976 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>Sinoatrial block AE is a conduction system disorder AE that shows the electrical impulse is delayed or blocked on the way to the atria, thus delaying atrial depolarization.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinoatrial_block</obo1:IAO_0000119>
        <obo1:OAE_0001849>窦房阻滞</obo1:OAE_0001849>
        <rdfs:label>sinoatrial block AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040736</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001977 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001977">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <purl:Definition>Hyperthyroidism AE is an endocrine system AE that is a condition in which the thyroid gland produces and secretes excessive amounts of the free (not protein bound circulating in the blood) thyroid hormones -triiodothyronine (T3) and/or thyroxine (T4).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperthyroidism</obo1:IAO_0000119>
        <obo1:OAE_0001849>甲状腺机能亢进</obo1:OAE_0001849>
        <rdfs:label>hyperthyroidism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020850</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001978 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001978">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Akathisia AE is a behavior and neurological AE that is a movement disorder characterized by a feeling of inner restlessness and a compelling need to be in constant motion, as well as by actions such as rocking while standing or sitting, lifting the feet as if marching on the spot, and crossing and uncrossing the legs while sitting. People with akathisia are unable to sit or keep still, complain of restlessness, fidget, rock from foot to foot, and pace.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acathisia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Akathisia</obo1:IAO_0000119>
        <obo1:OAE_0001849>静坐困难</obo1:OAE_0001849>
        <rdfs:label>akathisia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001540</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001979 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001979">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Retinopathy AE is an eye AE that is due to persistent or acute damage to the retina of the eye. Ongoing inflammation and vascular remodeling may occur over periods of time where the patient is not fully aware of the extent of the disease. Frequently, retinopathy is an ocular manifestation of systemic disease as seen in diabetes or hypertension.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Retinopathy</obo1:IAO_0000119>
        <obo1:OAE_0001849>视网膜病变</obo1:OAE_0001849>
        <rdfs:label>retinopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038923</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001980 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001980">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Sinus arrest AE is an arrhythmia AE that is a medical condition wherein the sinoatrial node of the heart transiently ceases to generate the electrical impulses that normally stimulate the myocardial tissues to contract and thus the heart to beat. It is defined as lasting from 2.0 seconds to several minutes.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>sinoatrial arrest AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>sinus pause AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sinoatrial_arrest</obo1:IAO_0000119>
        <obo1:OAE_0001849>窦性停搏</obo1:OAE_0001849>
        <rdfs:label>sinus arrest AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040738</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001981 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000909"/>
        <purl:Definition>ST segment depression AE is an electrocardiogram result abnormal AE that refers to a finding on an electrocardiogram. It may be determined by measuring the vertical distance between the patient&apos;s trace and the isoelectric line at a location 2-3 millimeters from the QRS complex. It is significant if it is more than 1 mm in V5-V6, or 1.5 mm in AVF or III.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/ST_depression</obo1:IAO_0000119>
        <obo1:OAE_0001849>ST段下降</obo1:OAE_0001849>
        <rdfs:label>ST segment depression AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041892</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001982 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001982">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000909"/>
        <purl:Definition>T-wave inversion AE is an electrocardiogram result abnormal AE that can be a sign of coronary ischemia, Wellens&apos; syndrome, left ventricular hypertrophy, or CNS disorder. In electrocardiography, the T wave represents the repolarization (or recovery) of the ventricles.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/T_wave</obo1:IAO_0000119>
        <obo1:OAE_0001849>T波倒置</obo1:OAE_0001849>
        <rdfs:label>T-wave inversion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10042966</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001983 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001983">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000624"/>
        <purl:Definition>Hyperthermia AE is an abnormal body temperature AE that is elevated body temperature due to failed thermoregulation that occurs when a body produces or absorbs more heat than it dissipates. Extreme temperature elevation then becomes a medical emergency requiring immediate treatment to prevent disability or death.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperthermia</obo1:IAO_0000119>
        <obo1:OAE_0001849>体温过高</obo1:OAE_0001849>
        <rdfs:label>hyperthermia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020843</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001984 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001984">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <purl:Definition>Priapism AE a male reproductive system AE that is a potentially painful medical condition in which the erect penis does not return to its flaccid state, despite the absence of both physical and psychological stimulation, within four hours.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Priapism</obo1:IAO_0000119>
        <obo1:OAE_0001849>阴茎持续勃起</obo1:OAE_0001849>
        <rdfs:label>priapism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036661</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001985 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001985">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>Gingival bleeding AE is a hemorrhage AE that is a term used by dentists and dental hygienists when referring to bleeding that is induced by gentle manipulation of the tissue at the depth of the gingival sulcus, or interface between the gingiva and a tooth. Bleeding on probing, often abbreviated BOP, is a sign of inflammation and indicates some sort of destruction and erosion to the lining of the sulcus or the ulceration of sulcular epithelium. The blood comes from lamina propria after the ulceration of the lining.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>bleeding gums AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>bleeding on probing AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bleeding_on_probing</obo1:IAO_0000119>
        <obo1:OAE_0001849>牙龈出血</obo1:OAE_0001849>
        <rdfs:label>gingival bleeding AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018276</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001986 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001986">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition>Hearing loss AE is an ear disorder AE that is a partial or total inability to hear. In children it may affect the development of language and can cause work related difficulties for adults.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>anacusis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>deafness AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>hard of hearing AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>hearing impairment AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hearing_loss</obo1:IAO_0000119>
        <obo1:OAE_0001849>听力下降</obo1:OAE_0001849>
        <rdfs:label>hearing loss AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019246</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001987 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001987">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>Muscle fatigue AE is a muscle adverse event that is the decline in ability of a muscle to generate force. It can be a result of vigorous exercise but abnormal fatigue may be caused by barriers to or interference with the different stages of muscle contraction.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>physical fatigue AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Muscle_fatigue</obo1:IAO_0000119>
        <obo1:OAE_0001849>肌肉疲劳</obo1:OAE_0001849>
        <rdfs:label>muscle fatigue AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049565</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Regurgitation AE is a digestive system AE that is the expulsion of material from the pharynx, or esophagus, usually characterized by the presence of undigested food or blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>http://en.wikipedia.org/wiki/Regurgitation_%28digestion%29</obo1:IAO_0000119>
        <obo1:OAE_0001849>反胃</obo1:OAE_0001849>
        <rdfs:label>regurgitation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10067171</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001989 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Skin irritation AE is a skin AE that is a mild inflammatory dermal tissue reaction, it can be caused by physical contact with an irritant or can be a local response to a systemic trigger.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>皮肤刺激</obo1:OAE_0001849>
        <rdfs:label>skin irritation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040880</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001990 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <purl:Definition>Herpes simplex AE is a viral infection AE that is a viral disease from the herpesviridae family caused by both Herpes simplex virus type 1 (HSV-1) and type 2 (HSV-2).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>herpes catarrhalis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Herpes_simplex</obo1:IAO_0000119>
        <obo1:OAE_0001849>单纯疱疹</obo1:OAE_0001849>
        <rdfs:label>herpes simplex AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019948</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001991 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001991">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <purl:Definition>Measles AE is a viral infection AE is an infection of the respiratory system, immune system and skin caused by a virus, specifically a paramyxovirus of the genus Morbillivirus.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>English measles AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>morbilli AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>rubeola AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Measles</obo1:IAO_0000119>
        <obo1:OAE_0001849>麻疹</obo1:OAE_0001849>
        <rdfs:label>measles AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027011</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001992 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001992">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001591"/>
        <purl:Definition>Hypercholesteremia AE is a blood cholesterol abnormal AE that is the presence of high levels of cholesterol in the blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>dyslipidemia</obo1:IAO_0000118>
        <obo1:IAO_0000118>hypercholesterolemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypercholesterolemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>高胆固醇血症</obo1:OAE_0001849>
        <rdfs:label>hypercholesteremia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020604</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001993 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001993">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Toxic epidermal necrolysis AE is a skin AE that is a rare, life-threatening skin condition which is usually caused by a reaction to drugs.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Lyell&apos;s syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Toxic_epidermal_necrolysis</obo1:IAO_0000119>
        <obo1:OAE_0001849>中毒性表皮坏死溶解症</obo1:OAE_0001849>
        <rdfs:label>toxic epidermal necrolysis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044223</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001994 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001994">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Atrioventricular junctional rhythm AE is an arrhythmia AE that is an electrocardiographic finding in which the pacer of the heart is located in the AV junction, presenting with a narrow QRS complex and a rate of 40-60 beats per minute.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>房室交界性心律</obo1:OAE_0001849>
        <rdfs:label>atrioventricular junctional rhythm AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001995 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001995">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>Unconsciousness AE is a sensory capability AE that is a state which occurs when the ability to maintain a awareness of self and environment is lost, it involves a complete or near-complete lack of responsiveness to people and other environmental stimuli.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>loss of consciousness AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Unconsciousness</obo1:IAO_0000119>
        <obo1:OAE_0001849>意识丧失</obo1:OAE_0001849>
        <rdfs:label>unconsciousness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10045481</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001996 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001996">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Pemphigus AE is a skin AE that is a rare group of blistering autoimmune diseases that affect the skin and mucous membranes.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pemphigus</obo1:IAO_0000119>
        <obo1:OAE_0001849>天疱疮</obo1:OAE_0001849>
        <rdfs:label>pemphigus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034280</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001997 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001203"/>
        <purl:Definition>Onychomycosis AE is a nail infection AE that is a fungal infection of the nail. It is the most common disease of the nails and constitutes about half of all nail abnormalities.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>dermatophytic onychomycosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>tinea unguium AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Onychomycosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>甲癣</obo1:OAE_0001849>
        <rdfs:label>onychomycosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001998 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Miosis AE is an eye AE that is a term with various definitions, which generally include constriction of the pupil.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>myosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Miosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>瞳孔缩小</obo1:OAE_0001849>
        <rdfs:label>miosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027646</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001999 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001999">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002553"/>
        <purl:Definition>an optic neuropathy AE that shows the loss of some or most of the nerve fibers in the optic nerve.  The effects range from visual change to severe visual loss.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.kellogg.umich.edu/patientcare/conditions/optic.atrophy.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>视神经萎缩</obo1:OAE_0001849>
        <rdfs:label>optic atrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10030910</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <purl:Definition>Albuminuria AE  is a urine abnormality AE that is a pathological condition wherein albumin is present in the urine. It is a type of proteinuria.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Albuminuria</obo1:IAO_0000119>
        <obo1:OAE_0001849>蛋白尿</obo1:OAE_0001849>
        <rdfs:label>albuminuria AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001580</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <purl:Definition>Enuresis AE  is a urine abnormality AE that refers to a repeated inability to control urination. Use of the term is usually limited to describing individuals old enough to be expected to exercise such control.</purl:Definition>
        <obo1:IAO_0000116>This term appears to be a synonym to the &apos;urinary incontinence AE&apos;.</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Enuresis</obo1:IAO_0000119>
        <obo1:OAE_0001849>遗尿</obo1:OAE_0001849>
        <rdfs:label>enuresis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014928</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Gum hypertrophy AE is a digestive system AE that is an increase in the size of the gingiva (gums). It is a common feature of gingival disease. Gingival enlargement can be caused by a number of factors, including inflammatory conditions and the side effects of certain medications.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>gingival enlargement AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>gingival hyperplasia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>gingival hypertrophy AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>gingival over-growth AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>hypertrophic gingivitis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Gingival_enlargement</obo1:IAO_0000119>
        <obo1:OAE_0001849>牙龈增生</obo1:OAE_0001849>
        <rdfs:label>gum hypertrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018781</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000086"/>
        <purl:Definition>Contact dermatitis AE is a dermatitis AE that is a type of skin inflammation.It results from exposure to allergens (allergic contact dermatitis) or irritants (irritant contact dermatitis). Phototoxic dermatitis occurs when the allergen or irritant is activated by sunlight.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Contact_dermatitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>接触性皮炎</obo1:OAE_0001849>
        <rdfs:label>contact dermatitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010790</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000565"/>
        <purl:Definition>Necrotizing vasculitis AE is a vasculitis AE that is a rare condition which involves inflammation of the blood vessel walls.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000432.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>坏死性血管炎</obo1:OAE_0001849>
        <rdfs:label>necrotizing vasculitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028892</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <purl:Definition>Carpal tunnel syndrome AE is a peripheral neuropathy AE that is a median entrapment neuropathy that causes paresthesia, pain, numbness, and other symptoms in the distribution of the median nerve due to its compression at the wrist in the carpal tunnel.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>median nerve neuropathy AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/1141168-clinical#showall</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Carpal_tunnel_syndrome</obo1:IAO_0000119>
        <obo1:OAE_0001849>腕管综合征</obo1:OAE_0001849>
        <rdfs:label>carpal tunnel syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007697</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000237"/>
        <purl:Definition>Erythromelalgia AE is a peripheral arterial disease AE that is a rare neurovascular peripheral pain disorder in which blood vessels, usually in the lower extremities or hands, are episodically blocked (frequently on and off daily), then become hyperemic and inflamed.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Mitchell&apos;s disease AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>acromelalgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>erythermalgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>red neuralgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythromelalgia</obo1:IAO_0000119>
        <obo1:OAE_0001849>红斑性肢痛症</obo1:OAE_0001849>
        <rdfs:label>erythromelalgia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015284</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000497"/>
        <purl:Definition>Raynaud&apos;s syndrome AE is a peripheral vascular disorder AE which is a rare disorder that affects the arteries. Arteries are blood vessels that carry blood from your heart to different parts of your body.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Raynaud&apos;s disease AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>Raynaud&apos;s phenomenon AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nhlbi.nih.gov/health/health-topics/topics/raynaud/</obo1:IAO_0000119>
        <obo1:OAE_0001849>雷诺综合症</obo1:OAE_0001849>
        <rdfs:label>Raynaud&apos;s syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037914</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>Extrapyramidal syndrome AE is a nervous system AE that is drug induced movement disorders which include acute and tardive symptoms.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>extrapyramidal side effects AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>vertebral body outside the beam syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Extrapyramidal_symptoms</obo1:IAO_0000119>
        <obo1:OAE_0001849>椎体外系综合征</obo1:OAE_0001849>
        <rdfs:label>extrapyramidal syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015836</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001579"/>
        <purl:Definition>Sodium retention AE is a blood sodium abnormal AE that  is when the kidneys hold on to more sodium and do not excrete it with the kidneys. This tends to expand the blood volume, which can elevate the blood pressure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: https://answers.yahoo.com/question/index?qid=20100823074826AAcg7WV</obo1:IAO_0000119>
        <obo1:OAE_0001849>钠潴留</obo1:OAE_0001849>
        <rdfs:label>sodium retention AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041277</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>complex regional pain syndrome AE is a pain AE that results in an uncommon form of chronic pain that usually affects an extremity. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/complex-regional-pain-syndrome/basics/definition/con-20022844</obo1:IAO_0000119>
        <rdfs:comment>Complex regional pain syndrome typically develops after an injury, surgery, stroke or heart attack, but the pain is out of proportion to the severity of the initial injury.</rdfs:comment>
        <rdfs:label xml:lang="en">complex regional pain syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10064332</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Sciatica AE is a pain AE that  is a set of symptoms including pain caused by general compression or irritation of one of five spinal nerve roots of each sciatic nerve or by compression or irritation of the left or right or both sciatic nerves.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>lumbar radiculopathy AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>sciatic neuralgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>sciatic neuritis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Sciatica</obo1:IAO_0000119>
        <obo1:OAE_0001849>坐骨神经痛</obo1:OAE_0001849>
        <rdfs:label>sciatica AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039674</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>Joint stiffness AE is a joint disorder AE that may be either the symptom of pain on moving a joint, the symptom of loss of range of motion or the physical sign of reduced range of motion.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_stiffness</obo1:IAO_0000119>
        <obo1:OAE_0001849>关节僵硬</obo1:OAE_0001849>
        <rdfs:label>joint stiffness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>Breast engorgement AE is a reproductive system AE that occurs in the mammary glands due to expansion and pressure exerted by the synthesis and storage of breast milk.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Breast_engorgement</obo1:IAO_0000119>
        <obo1:OAE_0001849>乳房充盈</obo1:OAE_0001849>
        <rdfs:label>breast engorgement AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006240</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Nervous tension AE is a behavior and neurological AE that might be said to be a physical expression of how people deal with negatively experienced emotion.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://helpmetosleep.org/featured-articles/how-to-relieve-nervous-tension/</obo1:IAO_0000119>
        <obo1:OAE_0001849>神经紧张</obo1:OAE_0001849>
        <rdfs:label>nervous tension AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029214</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Nervousness AE is a behavior and neurological AE that shows an uneasy psychological state which including anxiety, neurosis, neuroticism, and worry, etc.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nervousness</obo1:IAO_0000119>
        <obo1:OAE_0001849>神经过敏</obo1:OAE_0001849>
        <rdfs:label>nervousness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029216</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>Osteoarthritis AE is an arthritis AE that is a group of mechanical abnormalities involving degradation of joints, including articular cartilage and subchondral bone. Osteoarthritis is not an inflammatory disease even-though the name suggest one. Symptoms may include joint pain, tenderness, stiffness, locking, and sometimes an effusion.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>degenerative arthritis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>degenerative joint disease AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>osteoarthrosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Osteoarthritis</obo1:IAO_0000119>
        <obo1:OAE_0001849>骨关节炎</obo1:OAE_0001849>
        <rdfs:label>osteoarthritis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031161</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001665"/>
        <purl:Definition>Methemoglobinemia AE is a red blood cell profile abnormal AE that is a disorder characterized by the presence of a higher than normal level of methemoglobin (metHb, i.e., ferric [Fe3+] rather than ferrous [Fe2+] haemoglobin) in the blood. It&apos;s a form of hemoglobin that contains ferric [Fe3+] iron and has a decreased ability to bind oxygen.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>methaemoglobinaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Methemoglobinemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>高铁血红蛋白症</obo1:OAE_0001849>
        <rdfs:label>methemoglobinemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027506</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000297"/>
        <purl:Definition>Hemiageusia AE is a ageusia AE that shows loss of taste from one side of the tongue.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hemiageustia AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>hemigeusia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=39885</obo1:IAO_0000119>
        <obo1:OAE_0001849>偏侧味觉缺失</obo1:OAE_0001849>
        <rdfs:label>hemiageusia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Skin swelling AE is an edema AE that has an outcome of the occurrence of swelling which is located on the skin.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/skin_swelling.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>胕肿</obo1:OAE_0001849>
        <rdfs:label>skin swelling AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053262</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000563"/>
        <purl:Definition>Fibrosing alveolitis AE is a lung  inflammation AE that is a disease of unknown cause mainly involving the gas-exchanging portions of the lungs. It may occur in isolation and be called cryptogenic or idiopathic, in which case the clinical manifestations are mainly respiratory, or it may be associated with other disorders, such as rheumatoid arthritis.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1818528/</obo1:IAO_0000119>
        <obo1:OAE_0001849>纤维化肺泡炎</obo1:OAE_0001849>
        <rdfs:label>fibrosing alveolitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016640</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000726"/>
        <purl:Definition>Hypochloremic alkalosis AE is a blood chloride decreased AE that is a medical condition in which the patient&apos;s body has abnormally low levels of chloride. This condition usually results from an extremely high loss of chloride, rather than a low intake of it.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.wisegeek.com/what-is-hypochloremic-alkalosis.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>低氯性碱中毒</obo1:OAE_0001849>
        <rdfs:label>hypochloremic alkalosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020958</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000645"/>
        <purl:Definition>Erythema annulare centrifugum AE is an erythema AE that is a descriptive term for a skin lesion. The lesions form consists of redness (erythema) in a ring form (anulare) that spreads from the center (centrifugum).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>MedDRA: 10015154</obo1:IAO_0000118>
        <obo1:IAO_0000118>deep gyrate erythema AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>erythema perstans AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>palpable migrating erythema AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>superficial gyrate erythema AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema_annulare_centrifugum</obo1:IAO_0000119>
        <obo1:OAE_0001849>离心性环形红斑</obo1:OAE_0001849>
        <rdfs:label>erythema annulare centrifugum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Irritation is a behavior and neurological AE that is a state of inflammation or painful reaction to allergy or cell-lining damage.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Irritation</obo1:IAO_0000119>
        <obo1:OAE_0001849>刺激</obo1:OAE_0001849>
        <rdfs:label>irritation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029216</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Neuroticism AE is a mental disorder AE that is a fundamental personality trait in the study of psychology characterized by anxiety, fear, moodiness, worry, envy, frustration, jealousy, and loneliness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Neuroticism</obo1:IAO_0000119>
        <obo1:OAE_0001849>神经质</obo1:OAE_0001849>
        <rdfs:label>neuroticism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Hyperirritability AE is a behavior and neurological AE that shows abnormally great or uninhibited response to stimuli.</purl:Definition>
        <obo1:IAO_0000116>This term appears to be a synonym to the &apos;irritability AE&apos;.</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/medical/hyperirritability; http://en.wikipedia.org/wiki/Irritability</obo1:IAO_0000119>
        <obo1:OAE_0001849>过激</obo1:OAE_0001849>
        <rdfs:label>hyperirritability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>Rhinostenosis AE is a respiratory system AE that shows narrowing or obliteration of the nasal airway by scar formation</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.drugs.com/dict/rhinostenosis.html</obo1:IAO_0000119>
        <rdfs:comment>鼻道狭窄</rdfs:comment>
        <rdfs:label>rhinostenosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>Sino-auricular heart-block AE is a conduction system disorder AE that refers to a rare heart condition caused by abnormalities in the heart&apos;s electrical system rather than arterial disease.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/s/sino_auricular_heart_block/intro.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>窦房传导阻滞</obo1:OAE_0001849>
        <rdfs:label>sino-auricular heart-block AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>Anisosphygmia AE is a cardiovascular disorder AE that shows difference in volume, force, or time of the pulse in the corresponding arteries on two sides of the body, the two radials, or femorals.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=4352</obo1:IAO_0000119>
        <obo1:OAE_0001849>脉搏不规则</obo1:OAE_0001849>
        <rdfs:label>anisosphygmia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Rubefaction AE is a skin AE that refers to erythema of the skin caused by local application of a counterirritant.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=79112</obo1:IAO_0000119>
        <obo1:OAE_0001849>发红</obo1:OAE_0001849>
        <rdfs:label>rubefaction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000610"/>
        <purl:Definition>Myodystony AE is an abnormal muscle tone AE that refers to a condition of slow relaxation, interrupted by a succession of slight contractions, following electrical stimulation of a muscle.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.drugs.com/dict/myodystony.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>肌张力不全</obo1:OAE_0001849>
        <rdfs:label>myodystony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Allotriosmia is a behavior and neurological AE that shows incorrect recognition of odors.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>heterosmia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=2401</obo1:IAO_0000119>
        <obo1:OAE_0001849>嗅觉异常</obo1:OAE_0001849>
        <rdfs:label>allotriosmia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029216</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Pharyngotonsillitis is an inflammation AE that is a medical condition characterized by an inflammation of both the tonsils and the pharynx (located at the back of the throat). It occurs due to viral or bacterial infections.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.persify.com/en/perspectives/medical-conditions-diseases/pharyngotonsillitis-_-951000101807</obo1:IAO_0000119>
        <obo1:OAE_0001849>咽扁桃体炎</obo1:OAE_0001849>
        <rdfs:label>pharyngotonsillitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049140</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000647"/>
        <purl:Definition>Hypersensitivity pneumonitis AE is a pneumonia AE that is an inflammation of the alveoli within the lung caused by hypersensitivity to inhaled organic dusts. Sufferers are commonly exposed to the dust by their occupation or hobbies.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>extrinsic allergic alveolitis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypersensitivity_pneumonitis</obo1:IAO_0000119>
        <obo1:OAE_0001849>过敏性肺炎</obo1:OAE_0001849>
        <rdfs:label>hypersensitivity pneumonitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015887</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>Stagger AE is a movement disorder AE that shows an unsteady movement of the body in walking or standing, as if one were about to fall.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wiktionary.org/wiki/stagger</obo1:IAO_0000119>
        <obo1:OAE_0001849>蹒跚</obo1:OAE_0001849>
        <rdfs:label>stagger AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <purl:Definition>Myocardial anoxia AE is a hypoxia AE that shows a reduced concentration of O2 in the myocardium.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>心肌缺氧</obo1:OAE_0001849>
        <rdfs:label>myocardial anoxia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002036 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002036">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Biliary colic AE is a pain AE that is the term used to describe a type of pain related to the gallbladder that occurs when a gallstone transiently obstructs the cystic duct and the gallbladder contracts.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cholecystalgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Biliary_colic</obo1:IAO_0000119>
        <obo1:OAE_0001849>胆绞痛</obo1:OAE_0001849>
        <rdfs:label>biliary colic AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10004663</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>Hyperemia AE is a cardiovascular disorder AE that is the increase of blood flow to different tissues in the body. It can have medical implications, but is also a regulatory response, allowing change in blood supply to different tissues through vasodilation.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hyperaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hyperaemia</obo1:IAO_0000119>
        <obo1:OAE_0001849>充血</obo1:OAE_0001849>
        <rdfs:label>hyperemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome increased sensitivity to pain in a patient</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.oxforddictionaries.com/us/definition/american_english/tenderness</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">tenderness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043224</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin AE with the outcome of induration, which is an increase in the fibrous elements in tissue commonly associated with inflammation and marked by loss of elasticity and pliability or a hardened mass or formation</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/medical/induration</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">induration AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10060708</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition xml:lang="en">an eye AE which has an outcome of a foreign body sensation in the eye, or the sensation that something is in or scratching the eye</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
