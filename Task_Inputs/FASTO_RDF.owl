    <!-- http://purl.obolibrary.org/obo/OAE_0000775 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000775">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that has an outcome of self-reversing episodes during which the endothelial cells which line the capillaries are thought to separate for a few days, allowing for a leakage of fluid from the circulatory system to the interstitial space, resulting in hypotension, hemoconcentration, and hypoalbuminemia</purl:Definition>
