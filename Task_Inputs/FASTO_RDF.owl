        <rdfs:seeAlso>HPO: HP_0008066</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10005191</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005191</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0005758</rdfs:seeAlso>
    </owl:Class>
    


