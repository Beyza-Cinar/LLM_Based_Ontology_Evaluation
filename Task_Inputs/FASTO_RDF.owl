    <!-- http://purl.obolibrary.org/obo/OAE_0000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000017"/>
        <purl:Definition>an X-ray result abnormal AE that has an outcome of an abnormality in chest X-ray test</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>chest X-ray abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10008499</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000650"/>
        <purl:Definition>a haematoma AE that has an outcome of contusion. </purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bruise</obo1:IAO_0000119>
        <rdfs:comment>Contusion is a type of relatively minor hematoma of tissue in which capillaries and sometimes venules are damaged by trauma, allowing blood to seep into the surrounding interstitial tissues.</rdfs:comment>
        <rdfs:label>contusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10050584</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE which has an outcome of dry throat, which is a sensation of dryness in the throat.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>dry throat AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10013789</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition>a skin discoloration AE which has an outcome of flushing, a sudden reddening of the face, neck, or upper chest</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003241.htm</obo1:IAO_0000119>
        <rdfs:label>flushing AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001033</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10016825</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0016382</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of extreme pain</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>pain in extremity AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009763</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0030196</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE which has an outcome of postnasal drip, which occurs when excessive mucus is produced by the nasal Mucosa. The excess mucus accumulates in the throat or back of the nose.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>PDN</obo1:IAO_0000118>
        <obo1:IAO_0000118>UACS</obo1:IAO_0000118>
        <obo1:IAO_0000118>Upper Airway Cough Syndrome</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Post-nasal_drip</obo1:IAO_0000119>
        <rdfs:label>postnasal drip AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>a syndrome AE that is subclassified as five defined entities which represent clinical circumstances in which both the heart and the kidney are involved in a bidirectional injury and dysfunction via a final common pathway of cell-to-cell death and accelerated apoptosis mediated by oxidative stress. Types 1 and 2 involve acute and chronic cardiovascular disease (CVD) scenarios leading to acute kidney injury or accelerated chronic kidney disease. Types 2 and 3 describe acute and chronic kidney disease leading primarily to heart failure, although it is possible that acute coronary syndromes, stroke, and arrhythmias could be CVD outcomes in these forms of CRS. Finally, CRS type 5 describes a simultaneous insult to both heart and kidneys, such as sepsis, where both organs are injured simultaneously.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>CRS</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3030731/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cardiorenal syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10068230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000029"/>
        <purl:Definition>A bursal disorder AE that has an outcome of the symptom of bursitis.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>bursa inflammation</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001456/</obo1:IAO_0000119>
        <rdfs:label>bursitis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that has an outcome of abnormal sign in  musculoskeletal and connective tissue.</purl:Definition>
        <obo1:IAO_0000117>YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.cdc.gov/niosh/programs/msd/</obo1:IAO_0000119>
        <rdfs:comment>A musculoskeletal disorder is an injury or disorder of the muscles, nerves, tendons, joints, cartilage, or supporting structures of the upper or lower limbs, neck, or lower back that are caused, precipitated, or exacerbated by sudden exertion or prolonged exposure to physical factors such as repetition, force, vibration, or awkward posture</rdfs:comment>
        <rdfs:label>musculoskeletal and connective tissue AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028395</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE which has an outcome of bursal disorder</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>bursal disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000097"/>
        <purl:Definition>a vaccine adverse event that is induced by an influenza vaccine.</purl:Definition>
        <obo1:IAO_0000116>YH: This term is just used as an example of vaccine induced adverse events. Specific vaccine-associated and vaccine-induced adverse events are now represented with the Ontology of Vaccine Adverse Events (OVAE).: http://www.violinet.org/ovae/. </obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>influenza vaccine-induced adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000030"/>
        <purl:Definition>an influenza vaccine adverse event that is induced by a killed influenza vaccine (KIV).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>KIV-induced adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000031"/>
        <purl:Definition>A KIV-induced AE that results in a GBS.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>VAERS statistical data analysis</obo1:IAO_0000119>
        <rdfs:comment>There is little evidence to support a causal association between GBS and most vaccines. The evidence for a causal association is strongest for the swine influenza vaccine that was used in 1976-77. Studies of influenza vaccines used in subsequent years, however, have found small or no increased risk of GBS.  
Reference: http://www.ncbi.nlm.nih.gov/pubmed?term=19388722.</rdfs:comment>
        <rdfs:label>KIV-induced GBS averse event in 1976-1977</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000033 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000051"/>
        <purl:Definition>a muscle pain AE that is induced by Afluria influenza vaccine administration</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.fda.gov/downloads/BiologicsBloodVaccines/Vaccines/ApprovedProducts/UCM220730.pdf</obo1:IAO_0000119>
        <rdfs:label>Afluria-induced muscle ache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000034 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of fatigue, which is a state of awareness describing a range of afflictions, usually associated with physical and/or mental weakness, though varying from a general state of lethargy to a specific work-induced burning sensation within one&apos;s muscles. Physical fatigue is the inability to continue functioning at the level of one&apos;s normal abilities.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>lethargy AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Fatigue_%28medical%29</obo1:IAO_0000119>
        <rdfs:label>fatigue AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003388</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10016256</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10024264</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015672</rdfs:seeAlso>
    </owl:Class>
    


