                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/ObservationComponentComponent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.context"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/encounter"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.interpretation"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
