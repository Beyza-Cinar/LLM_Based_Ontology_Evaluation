        <obo1:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/000357.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">acute adrenal crisis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001389</rdfs:seeAlso>
    </owl:Class>
    


