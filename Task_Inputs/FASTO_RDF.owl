        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>an investigation result abnormal AE that involves an abnormal result of an investigation involving the cardiac and vascular systems</purl:Definition>
        <obo1:IAO_0000117>EB</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">cardiac and vascular investigation result abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007512</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001297"/>
        <purl:Definition>an atrioventricular block AE that some but not all atrial impulses fail to reach the ventricles, thus some ventricular beats are dropped. Electrical signals between the atria and ventricles are slowed to a large degree. Some signals don&apos;t reach the ventricles. On an EKG, the pattern of QRS waves doesn&apos;t follow each P wave as it normally would. </purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>atrioventricular block second degree</obo1:IAO_0000118>
        <obo1:IAO_0000118>second degree heart block</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=10751
WEB: http://www.nhlbi.nih.gov/health//dci/Diseases/hb/hb_types.html</obo1:IAO_0000119>
        <rdfs:label>second degree atrioventricular block AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003677</rdfs:seeAlso>
    </owl:Class>
    


