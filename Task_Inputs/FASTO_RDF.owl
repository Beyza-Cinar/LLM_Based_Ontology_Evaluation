        <obo1:IAO_0000117>YH, LT</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/drug+interaction</obo1:IAO_0000119>
        <rdfs:label>causal adverse drug event due to drug-drug interaction</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013710</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000095"/>
        <purl:Definition>a causal adverse drug event that is induced by a food-drug interaction.</purl:Definition>
        <obo1:IAO_0000117>YH, LT</obo1:IAO_0000117>
        <rdfs:label>causal adverse drug event due to food-drug interaction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000095"/>
        <purl:Definition>a causal adverse drug event that is induced bygenetic predisposition.</purl:Definition>
        <obo1:IAO_0000117>YH, LT</obo1:IAO_0000117>
        <rdfs:label>causal adverse drug event due to genetic predisposition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000181"/>
        <purl:Definition>a causal adverse drug event due to genetic predisposition that is specifically induced by SNP.</purl:Definition>
        <obo1:IAO_0000117>YH, LT</obo1:IAO_0000117>
        <rdfs:label>causal adverse drug event due to SNP</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that is a result of insufficient blood flow throughout the body. Shock often accompanies severe injury or illness.</purl:Definition>
        <obo1:IAO_0000118>physiological shock AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>shock</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Shock_%28circulatory%29</obo1:IAO_0000119>
        <obo1:OAE_0001849>休克</obo1:OAE_0001849>
        <rdfs:comment>Circulatory shock is not related to the emotional state of shock.</rdfs:comment>
        <rdfs:label>circulatory shock AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040560</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of a loss of brain function.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Dementia is a loss of brain function that occurs with certain diseases or pathological processes. Reference: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001748/</rdfs:comment>
        <rdfs:label>dementia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000726</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10012272</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0497327</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>A vascular disorder AE that results in the presence of blood clot along the wall of a blood vessel, frequently causing vascular obstruction. Some authorities differentiate thrombus formation from simple coagulation or clot formation.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>thrombosis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004419</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10043607</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0040053</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <purl:Definition xml:lang="en">a metabolic disorder AE that has an outcome of cell death. </purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">cell death AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010885</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10057248</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007587</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE which has an outcome of some respiratory tract neoplasm.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">respiratory tract neoplasm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10029107</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE that shows the result of an inflammation located in a vein, usually in the legs.</purl:Definition>
        <rdfs:label>phlebitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004419</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10034879</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0031542</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000436"/>
        <purl:Definition>a liver, biliary, and pancreatic AE that has an outcome of pancreatitis. </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>pancreatitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001733</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10033646</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0030305</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000187"/>
        <purl:Definition xml:lang="en">a cell death AE that has an outcome of apoptosis. </purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>apoptosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059512</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000187"/>
        <purl:Definition xml:lang="en">a cell death AE that has an outcome of necrosis</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>necrosis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003713</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0027540</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>A cardiovascular disorder AE that results in Insufficient blood supply for the need of a part of the body, usually as a result of a disease of the blood vessels supplying that part.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>ischaemia AE</obo1:IAO_0000118>
        <rdfs:comment> Note: also spelt ischemia.</rdfs:comment>
