    <!-- http://hl7.org/fhir/communication -->

    <owl:Class rdf:about="http://hl7.org/fhir/communication">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000011"/>
        <rdfs:comment>An occurrence of information being transmitted; e.g. an alert that was sent to a responsible provider.</rdfs:comment>
        <rdfs:comment>This resource is a record of a communication. A communication is a conveyance of information from one entity, a sender, to another entity, a receiver. The sender and receivers may be patients, practitioners, related persons, organizations, or devices.</rdfs:comment>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/contactCode -->

    <owl:Class rdf:about="http://hl7.org/fhir/contactCode">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/code"/>
        <rdfs:comment>Code	Description
BP 	Billing contact person
C 	Emergency Contact
CP 	Contact person
E 	Employer
EP 	Emergency contact person
F 	Federal Agency
I 	Insurance Company
N 	Next-of-Kin
O 	Other
PR 	Person preparing referral
S 	State Agency
U 	Unknown</rdfs:comment>
    </owl:Class>
    


