    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye AE with an outcome of an abnormal sensation in the eye</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">abnormal sensation in eye AE</rdfs:label>
