        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000762"/>
        <purl:Definition>Increase breast cancer occurrence AE is a breast cancer AE that shows increase breast cancer occurrence.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>乳腺癌发生增加</obo1:OAE_0001849>
        <rdfs:label>increase breast cancer occurrence AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002335 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>Anticholinergic effect AE is a conduction system disorder AE that is physical symptoms resulting from agents that counter the action of acetylcholine, a neurotransmitter (chemical within the nervous system) that is involved in many major bodily functions. These anticholinergic effects typically include constipation, dry mouth, blurred vision, dizziness, and slowing of urination.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://ibs.about.com/od/glossary/g/Anticholeffect.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>经讯号传导阻断效应</obo1:OAE_0001849>
        <rdfs:label>anticholinergic effect AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE that has an outcome of diaphragmatic muscle replaced by fibroelestic tissue. The diaphragm retains its continuity and attachments to the costal margin. However, the weakened hemidiaphragm is displaced into the thorax, which can compromise breathing.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.uptodate.com/contents/eventration-of-the-diaphragm-in-infants</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">acquired diaphragmatic eventration AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10000486</rdfs:seeAlso>
    </owl:Class>
    


