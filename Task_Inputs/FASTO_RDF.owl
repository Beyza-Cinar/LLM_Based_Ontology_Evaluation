        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE that has an outcome of expectoration of blood or blood-stained sputum from the bronchi, larynx, trachea or lungs</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>haemoptysis AE</obo1:IAO_0000118>
