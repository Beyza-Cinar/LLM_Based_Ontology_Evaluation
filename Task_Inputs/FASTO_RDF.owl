        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000316"/>
        <purl:Definition>a conduction system disorder AE that results in an abnormal accessory electrical conduction pathway between the atria and ventricles</purl:Definition>
        <obo1:IAO_0000117>SZ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001206/</obo1:IAO_0000119>
        <rdfs:label>wolff-parkinson-white syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048015</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001517 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000040"/>
        <purl:Definition>an injury and procedural complication AE that has an outcome of complication to the wound</purl:Definition>
        <obo1:IAO_0000117>SZ, SS, YH</obo1:IAO_0000117>
        <rdfs:label>wound complication AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053692</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001518 -->

