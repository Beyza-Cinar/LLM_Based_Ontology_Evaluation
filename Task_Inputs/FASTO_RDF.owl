        <rdfs:seeAlso>MedDRA: 10000234</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0000786</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin AE that is characterized by pimples generally on the face, chest and back, caused by clogging of the pores</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/acne</obo1:IAO_0000119>
        <rdfs:label>acne AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001061</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000496</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0702166</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>a immune system disorder AE that is caused by the HIV virus</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/hivaids.html</obo1:IAO_0000119>
        <rdfs:label>acquired immunodeficiency syndrome AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002721</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000565</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0001175</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of a prolonged time taken for blood to clot. The partial thromboplastin time (PTT) is a blood test that looks at how long it takes for blood to clot. PTT measures the efficacy of the comon coagulation pathways and helps tell if bleeding or clotting problems exist.</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003653.htm</obo1:IAO_0000119>
        <rdfs:label>activated partial thromboplastin time prolonged AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003645</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000636</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0853223</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE that has an outcome of a complication during stem cell or bone marrow transplant in which the newly transplanted donor cells in the intestine attack the transplant recipient&apos;s body</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001309.htm</obo1:IAO_0000119>
        <rdfs:label>acute graft versus host disease in intestine AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10066264</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin AE that has an outcome of a complication during stem cell or bone marrow transplant in which the newly transplanted donor cells in the skin attack the transplant recipient&apos;s body</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001309.htm</obo1:IAO_0000119>
        <rdfs:label>acute graft versus host disease in skin AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10066262</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of a type of acute leukemia, characterized by anemia, fatigue, weight loss, easy bruising, thrombocytopenia, granulocytopenia with bacterial infections, and bone pain</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute lymphocytic leukaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Blast+count</obo1:IAO_0000119>
        <rdfs:label>acute lymphocytic leukemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0006721</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000846</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0023449</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of the reoccurance of fast-growing cancer of the white blood cells where abnormal blasts do not fight infections after a period of remission</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute lymphocytic leukaemia recurrent AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://marrow.org/Patient/Disease_and_Treatment/About_Your_Disease/ALL/Acute_Lymphoblastic_Leukemia_(ALL).aspx</obo1:IAO_0000119>
        <rdfs:label>acute lymphocytic leukemia recurrent AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10063620</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of cancer in the myeloid line of blood cells, characterized by the rapid growth of abnormal white blood cells that accumulate in the bone marrow and interfere with the production of normal blood cells</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute myeloid leukaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001569/</obo1:IAO_0000119>
        <rdfs:label>acute myeloid leukemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004808</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10000880</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0023467</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>an acute myeloid leukemia AE that shows an recurrence of acute myeloid leukemia</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute myeloid leukaemia recurrent AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001569/</obo1:IAO_0000119>
        <rdfs:label>acute myeloid leukemia recurrent AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059034</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <purl:Definition>a lung disorder AE that has the outcome fluid accumulation in the air spaces and parenchyma of the lungs with rapid onset</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute pulmonary oedema AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Acute+pulmonary+edema</obo1:IAO_0000119>
