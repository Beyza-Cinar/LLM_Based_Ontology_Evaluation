        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.cchi.com.hk/symposia/s3_ear_1.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">tonsilar hypertrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044003</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that results in temperature intolerance</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">temperature intolerance AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10057040</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that results in the patient being unresponsive to stimuli</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">unresponsive to stimuli AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10045555</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE that shows discolored sputum</purl:Definition>
        <obo1:IAO_0000117>RR</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">sputum discolored AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041806</rdfs:seeAlso>
