        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/sensor_related_property"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/ssn/observes"/>
    </owl:ObjectProperty>
    


