                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/PractitionerRole.availableTime.availableEndTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/time"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/PractitionerRole.availableTime.availableStartTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/time"/>
                    </owl:Restriction>
