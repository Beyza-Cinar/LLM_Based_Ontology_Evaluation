        <obo1:OAE_0001849>嗜酸性粒细胞异常</obo1:OAE_0001849>
        <rdfs:label>abnormal eosinocyte AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001733"/>
        <purl:Definition>Eosinopenia AE is an eosinophil count abnormal AE that is a form of agranulocytosis where the number of eosinophil granulocytes is lower than expected.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
