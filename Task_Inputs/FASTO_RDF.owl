        <rdfs:label xml:lang="en">joint tuberculosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056367</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002580 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002580">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
