        <obo1:IAO_0000118>haemoglobin abnormal AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hemoglobin</obo1:IAO_0000119>
        <rdfs:label>hemoglobin level abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018879</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001012 -->

