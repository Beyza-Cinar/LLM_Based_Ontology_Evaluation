    <!-- http://purl.obolibrary.org/obo/OAE_0000287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <purl:Definition>Aplastic anaemia AE is an anemia AE that occurs when the bone marrow, and the blood stem cells that reside there are damaged. This causes a deficiency of all three blood cell types (pancytopenia): red blood cells (anemia), white blood cells (leukopenia), and platelets (thrombocytopenia).</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>aplastic anemia</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/23292240</obo1:IAO_0000119>
        <obo1:OAE_0001849>再生障碍性贫血</obo1:OAE_0001849>
        <rdfs:label>aplastic anaemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001915</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002967</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002874</rdfs:seeAlso>
    </owl:Class>
    


