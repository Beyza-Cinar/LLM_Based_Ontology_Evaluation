    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001509"/>
        <purl:Definition>Instantaneous sand-blind AE is a vision blurred AE that shows in instantaneous unclear vision.</purl:Definition>
