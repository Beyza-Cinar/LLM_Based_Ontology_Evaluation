    <!-- http://purl.obolibrary.org/obo/OAE_0000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE which has an outcome of wheezing, a high-pitched whistling sound made while breathing.</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/symptoms/wheezing/basics/definition/sym-20050764</obo1:IAO_0000119>
