        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#RO_0000053"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
        <obo1:IAO_0000115>a relation between an independent continuant (the bearer) and a role, in which the role specifically depends on the bearer for its existence</obo1:IAO_0000115>
        <rdfs:label>has_role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/DDO.owl#RO_0000091 -->

