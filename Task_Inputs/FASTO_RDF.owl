    <!-- http://purl.obolibrary.org/obo/OAE_0000711 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000711">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE that has an outcome of cancer that starts in the bladder, the body part that holds and releases urine in the center of the lower belly area</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0001517/</obo1:IAO_0000119>
        <rdfs:label>bladder cancer AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0009725</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005003</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0005684</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001729"/>
        <purl:Definition>a blast cell count abnormal AE that has an outcome of an increased amount of immature precursors of either lymphocytes or granulocytes that do not normally appear in peripheral blood. May indicate acute leukemia</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://meds.queensu.ca/medicine/deptmed/hemonc/anemia/blast.htm</obo1:IAO_0000119>
        <rdfs:label>blast cell count increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062274</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000713 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000713">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of a sudden, severe change in the course of chronic granulocytic leukemia with an increase in the proportion of myeloblasts</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/blast+crisis</obo1:IAO_0000119>
        <rdfs:label>blast cell crisis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053747</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of myeloblasts or myeloid blasts. Presence of these abnormal blasts prevent production of adequate platelets, red blood cells and white blood cells, can be associated with leukemia</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://lymphoma.about.com/od/glossary/ss/Blast-Cells.htm</obo1:IAO_0000119>
        <rdfs:label>blast cells present AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10057107</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of the last stage of chronic myelogenous leukemia characterized by rapid progression and short survival with an increase of myeloblasts or lymphoblasts in the blood or bone marrow</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>blast crisis in myelogenous leukaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: Primary Source: http://medical-dictionary.thefreedictionary.com/blast+crisis , Secondary Source: http://www.ncbi.nlm.nih.gov/pubmed/23171293</obo1:IAO_0000119>
        <rdfs:label>blast crisis in myelogenous leukemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10050282</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000560"/>
        <purl:Definition>an eye inflammation AE that has an outcome of swelling in the eyelids, usually where eyelash follicles are located</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0002586/</obo1:IAO_0000119>
        <rdfs:label>blepharitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000498</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005148</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0005741</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000717 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000717">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001654"/>
        <purl:Definition>a blood albumin level abnormal AE with an outcome of a decrease in the amount of albumin, a protein made by the liver</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypoalbuminemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003480.htm</obo1:IAO_0000119>
        <rdfs:label>blood albumin level decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005287</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000718 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000718">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001694"/>
        <purl:Definition>a liver related investigation result abnormal AE that has an outcome of an abnormal level of alkaline phosphatase in the blood</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH, EB</obo1:IAO_0000117>
        <rdfs:label>blood alkaline phosphatase level abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059571</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000719 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000719">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000718"/>
        <purl:Definition>a blood alkaline phosphatase abnormal AE that has an outcome of a decreased level of alkaline phosphatase in the blood</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/alkaline+phosphatase</obo1:IAO_0000119>
        <rdfs:label>blood alkaline phosphatase decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059569</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000718"/>
        <purl:Definition>a blood alkaline phosphatase abnormal AE that has an outcome of elevated levels of alkaline phosphatase, an enzyme responsible for removing phosphate groups. a liver/biliary system AE that has an outcome of an increased amount of ALP, an isoenzyme that removes phosphate groups commonly found in the bile ducts but also found in the bone</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/alkaline+phosphatase</obo1:IAO_0000119>
        <rdfs:label>blood alkaline phosphatase increased AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003155</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10059570</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0852911</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000171"/>
        <purl:Definition>a distal neuropathy AE which shows a neurological disorder characterized by progressive weakness and impaired sensory function in the legs and arms. It is caused by the loss of myelin sheath of the peripheral nerves.</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>CIDP</obo1:IAO_0000118>
        <obo1:IAO_0000118>Chronic Inflammatory Demyelinating Polyneuropathy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ninds.nih.gov/disorders/cidp/cidp.htm</obo1:IAO_0000119>
        <rdfs:label>chronic inflammatory demyelinating neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000722 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000722">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001689"/>
        <purl:Definition>a blood amylase level abnormal AE that has an outcome of an increased amount of amylase, an enzyme that helps digest carbohydrates; may indicate disease or inflammation of the pancreas</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003464.htm</obo1:IAO_0000119>
