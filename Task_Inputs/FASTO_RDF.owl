        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002122"/>
        <purl:Definition>a cardiac disorder AE that is stable and shows the symptom of a chest pain due to ischemia of the heart</purl:Definition>
