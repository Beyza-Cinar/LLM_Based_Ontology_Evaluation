        <rdfs:seeAlso>MedDRA: 10001053</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0264490</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000400"/>
        <purl:Definition>a syncope AE that results in sudden episodes of fainting and sometimes seizures</purl:Definition>
