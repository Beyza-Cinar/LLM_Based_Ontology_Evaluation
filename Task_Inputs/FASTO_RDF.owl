    <!-- http://purl.obolibrary.org/obo/OAE_0001365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>a kidney disorder AE that results in the rapid loss or decline of kidney function</purl:Definition>
        <obo1:IAO_0000116>As shown on the renal.org website (http://www.renal.org/guidelines/modules/acute-kidney-injury), Acute kidney injury (AKI) has now replaced the term acute renal failure. </obo1:IAO_0000116>
        <obo1:IAO_0000117>SZ, SS, YH, Izabela Birsanescu</obo1:IAO_0000117>
        <obo1:IAO_0000118>AKI</obo1:IAO_0000118>
        <obo1:IAO_0000118>renal failure acute AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/acute+renal+failure</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/kidney-failure/basics/definition/con-20024029 </obo1:IAO_0000119>
        <rdfs:comment>Acute kidney failure occurs when kidneys become unable to filter waste products from blood. </rdfs:comment>
        <rdfs:label>acute kidney injury AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001919</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10038436; MedDRA: 10069339</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0022660</rdfs:seeAlso>
    </owl:Class>
    


