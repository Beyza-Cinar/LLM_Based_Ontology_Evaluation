        <purl:Definition>an abortion AE that has an outcome of expulsion of a fetus from the uterus brought on intentionally by medication or instrumentation</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/induced+abortion</obo1:IAO_0000119>
        <rdfs:label>abortion induced AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10000220</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000485"/>
        <purl:Definition>an abortion AE that results in a miscarriage</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmedhealth/PMH0002458/</obo1:IAO_0000119>
        <rdfs:label>abortion spontaneous AE</rdfs:label>
