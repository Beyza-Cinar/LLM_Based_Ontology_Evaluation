    </owl:DatatypeProperty>
    


    <!-- https://bioportal.bioontology.org/ontologies/FTDM/isPragnant -->

    <owl:DatatypeProperty rdf:about="https://bioportal.bioontology.org/ontologies/FTDM/isPragnant">
