                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.priority"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.reason"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.serviceProvider"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#organization"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.status"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/encounterStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.statusHistory.period"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.statusHistory.status"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/encounterStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.subject"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Encounter.type"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://hl7.org/fhir/encounterLocation -->

    <owl:Class rdf:about="http://hl7.org/fhir/encounterLocation">
