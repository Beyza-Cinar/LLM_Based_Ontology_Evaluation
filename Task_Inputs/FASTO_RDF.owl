        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>Arthromeningitis AE is an inflammation AE that shows inflammation of a synovial membrane, usually painful, particularly on motion, and characterized by fluctuating swelling, due to effusion in a synovial sac.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>滑膜炎</obo1:OAE_0001849>
        <rdfs:label>arthromeningitis AE</rdfs:label>
    </owl:Class>
    


