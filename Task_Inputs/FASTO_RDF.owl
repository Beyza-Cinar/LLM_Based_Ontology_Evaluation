        <rdfs:label>vaccine-induced adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000098 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <purl:Definition>a surgery adverse event that is caused by a surgery.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>surgery-induced adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000099 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000099">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000008"/>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000117>a nutritional product adverse event that has a causal assocition with the usage of the nutritional product.</obo1:IAO_0000117>
        <rdfs:label>nutritional product-induced adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000100 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>influenza like illness AE is an adverse event that has an outcome of a medical diagnosis of possible influenza or other illness causing a set of common symptoms</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>acute respiratory infection, ARI, flu-like syndrome</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Influenza-like_illness</obo1:IAO_0000119>
        <rdfs:label>influenza like illness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005376</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10022004</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0521839</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000103 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000117>a pathogen infection adverse event that has an outcome of a fungal infection.</obo1:IAO_0000117>
        <rdfs:label>fungal infection AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002841</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10017533</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0026946</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>a peripheral neuropathy AE which has an outcome of sensory neuropathy that involves damage to nerves of the peripheral nervous system.</purl:Definition>
        <obo1:IAO_0000117>YH, AG</obo1:IAO_0000117>
        <obo1:IAO_0000118>sensory neuropathy AE</obo1:IAO_0000118>
        <rdfs:label>sensory neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE which has an outcome of distal sensory neuropathy that involves damage to distal sensory nerves of the peripheral nervous system.</purl:Definition>
        <obo1:IAO_0000117>YH, AG</obo1:IAO_0000117>
        <rdfs:label>distal sensory neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000163"/>
        <purl:Definition>a distal sensory neuropathy AE that is chronic.</purl:Definition>
        <obo1:IAO_0000117>YH, AG</obo1:IAO_0000117>
        <rdfs:label>chronic distal sensory neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000165">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0000095"/>
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/OAE_0000418"/>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
