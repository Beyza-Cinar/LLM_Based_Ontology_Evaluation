                        <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM/hasInsulinRegimen"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#insulinRegimen"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.HbA1C.goal"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.activity"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/carePlanActivityComponent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.addresses"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/condition"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.author"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://hl7.org/fhir/practitioner"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/relative"/>
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#careTeam"/>
                                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#organization"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.basedOn"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/CarePlan.bloodGlucoseLevel.goal"/>
                        <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661"/>
                    </owl:Restriction>
