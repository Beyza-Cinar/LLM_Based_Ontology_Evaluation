    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <purl:Definition>a hypersensitivity AE that occurs at the site of an application of a medical intervention (e.g., drug administration or vaccination). </purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <rdfs:label>application site hypersensitivity AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10063683</rdfs:seeAlso>
    </owl:Class>
    


