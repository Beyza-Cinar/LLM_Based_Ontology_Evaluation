        <rdfs:label xml:lang="en">wound AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10052428</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002576">
