    <!-- http://purl.obolibrary.org/obo/OAE_0000297 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of loss of taste functions of the tongue, particularly the inability to detect sweetness, sourness, bitterness, saltiness, and umami (the taste of monosodium glutamate).</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ageusia</obo1:IAO_0000119>
        <rdfs:label>ageusia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10001480</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE  that has an outcome of chronic sensory neuropathy characterized by being persistent or long-lasting in nature</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>chronic sensory neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of a lack of functioning olfaction, an inability to perceive odors</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Olfaction</obo1:IAO_0000119>
        <rdfs:label>anosmia AE</rdfs:label>
