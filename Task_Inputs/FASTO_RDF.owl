        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000583"/>
        <purl:Definition>a glucose homeostasis AE that results in a abnormally diminished content of glucose in the blood</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypoglycaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypoglycemia</obo1:IAO_0000119>
