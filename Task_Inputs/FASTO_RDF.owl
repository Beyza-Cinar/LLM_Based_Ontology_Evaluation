        <purl:Definition>a systemic hypertension AE that has an outcome of hypertension with systolic blood pressure &gt;180 mm Hg or a diastolic pressure &gt;120 mm, can be further classified as hypertensive urgency or hypertensive emergency depending on end-organ involvement</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/20160537</obo1:IAO_0000119>
        <rdfs:label>hypertensive crisis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000875</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10020802</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020546</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of high blood levels of triglycerides, abundant fatty molecules</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypertriglyceridaemia AE</obo1:IAO_0000118>
