    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000741"/>
        <purl:Definition>Serum potassium concentration of moderately reduced AE is a blood potassium decreased AE that shows slightly lower than normal amount of potassium in the blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血清钾浓度的轻度降低</obo1:OAE_0001849>
        <rdfs:label>serum potassium concentration of moderately reduced AE</rdfs:label>
    </owl:Class>
    


