    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <purl:Definition>Severe dizziness AE is a dizziness AE that shows severe dizziness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>严重眩晕</obo1:OAE_0001849>
        <rdfs:label>severe dizziness AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000242"/>
        <purl:Definition>Mild abdominal discomfort AE is a abdominal discomfort AE that shows a mild stomach ache.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>轻微腹部不适</obo1:OAE_0001849>
        <rdfs:label>mild abdominal discomfort AE</rdfs:label>
    </owl:Class>
    


