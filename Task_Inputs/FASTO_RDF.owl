    <!-- http://purl.obolibrary.org/obo/OAE_0002573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002573">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
