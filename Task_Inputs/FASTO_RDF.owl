    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye disorder AE that is characterized by an excessive accumulation of blood in the eye</purl:Definition>
        <obo1:IAO_0000117>SZ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>scleral hyperaemia AE</obo1:IAO_0000118>
