    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000218"/>
        <purl:Definition>Severe bradycardia AE is a bradycardia AE that shows in a resting heart rate of under 60 beats per minutes (BPM).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>严重心动过缓</obo1:OAE_0001849>
