                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Patient.contact"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/relative"/>
                    </owl:Restriction>
