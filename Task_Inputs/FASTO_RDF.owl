        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://hl7.org/fhir/observationValue"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FASTO/basalInsulinAdjustment"/>
                    <rdf:Description rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


