        <rdfs:label xml:lang="en">anesthetic complication AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10060938</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002349 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002349">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE that results in the development of a small channel between the end of the bowel and the skin near the anus</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.boots.com/digestive-disorders/anal-fistula</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">anal fistula AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002156</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002350 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002350">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <purl:Definition>postoperative anemia  AE is an anemia AE that occurs when a patient with acute bleeding loses enough blood to become anemic</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>bleeding and acute blood loss anemia</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.acphospitalist.org/archives/2012/02/coding.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">postoperative anemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054312</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002351 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002351">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that results in antagonism toward someone or something you feel has deliberately done you wrong:  excessive anger can cause problems including increased blood pressure and other physical changes that make it difficult to think straight and can harm your physical and mental health.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://apa.org/topics/anger/index.aspx</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">anger AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002368</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <purl:Definition>a musculoskeletal system AE that results in the formation of fibrous band between tissues and organs, often as a result of injury during surgery</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://en.wikipedia.org/wiki/Adhesion_%28medicine%29</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">adhesion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059837</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002353 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000393"/>
        <purl:Definition>a crying abnormal AE that refers to a neurologic disorder characterized by involuntary crying or uncontrollable episodes of crying and/or laughing, or other emotional displays</purl:Definition>
        <obo1:IAO_0000117>YH, SJ </obo1:IAO_0000117>
        <obo1:IAO_0000118>emotional incontinence</obo1:IAO_0000118>
        <obo1:IAO_0000118>emotional lability</obo1:IAO_0000118>
        <obo1:IAO_0000118>labile affect</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pseudobulbar_affect</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">pseudobulbar affect AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054196</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002354 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition> cardiovascular AE that results in disease of the arteries, veins, and capillaries</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>macroangiopathy</obo1:IAO_0000118>
        <obo1:IAO_0000118>microangiopathy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=6853</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">angiopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059245</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002354"/>
        <purl:Definition>a cardiovascular AE that results in the walls of small blood vessels becoming so thick and weak that they bleed, leak protein, and slow the flow of blood</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=6853</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">microangiopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062198</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002354"/>
        <purl:Definition>a cardiovascualr AE that results in the build up of fat and blood clots in the large blood vessels, stick to the vessel walls, and block the flow of blood</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cerebrovascular disease</obo1:IAO_0000118>
        <obo1:IAO_0000118>coronary artery disease</obo1:IAO_0000118>
        <obo1:IAO_0000118>peripheral vascular disease</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=6853</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">macroangiopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054805</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002357 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>a muscle AE that results in a congenital anomaly in which a short, lingual frenulum or a highly-attached genioglossus muscle restricts tongue movement</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>tongue-tie</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.uptodate.com/contents/ankyloglossia-tongue-tie-in-infants-and-children</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">ankyloglossia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10049244</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE that results in a group of medical disorders that occur at the junction of the anal canal and the rectum</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Anorectal+Disorders</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">anorectal disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002644</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002359 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002359">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of  bleeding from or in to the genital tract, occurring from 24 weeks of pregnancy and prior to the birth of the baby. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: https://www.rcog.org.uk/globalassets/documents/guidelines/gtg63_05122011aph.pdf</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">antepartum hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10055228</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002360 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002360">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001893"/>
        <purl:Definition>Brain damage AE that results in a persistent vegetative state</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/a/apallic_syndrome/intro.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">apallic syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002941</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>APGAR is a quick test performed on a neonate at 1 and 5 minutes after birth. The 1-minute score determines how well the baby tolerated the birthing process. The 5-minute score tells the doctor how well the baby is doing outside the mother&apos;s womb. Any score lower than 7 is a sign that the baby needs medical attention. The lower the score, the more help the baby needs to adjusting outside the mother&apos;s womb</purl:Definition>
        <obo1:IAO_0000117>YH, SJ </obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003402.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">APGAR score low AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002944</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10062552</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002362 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain disorder AE  that causes a person to lose the ability to communicate. Aphasia can affect the ability to express and understand language, both verbal and written. Aphasia typically occurs suddenly after a stroke or a head injury, but it can also come on gradually from a slowly growing brain tumor or a degenerative disease</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/aphasia/basics/definition/con-20027061</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">aphasia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002948</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>a tumor AE that results in pouches of cerebrospinal fluid covered by arachnoidal cells and collagen that may develop between the surface of the brain and the cranial base or on the arachnoid membrane</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB:http://en.wikipedia.org/wiki/Arachnoid_cyst</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arachnoid cyst AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049005</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <purl:Definition>a brain disorder AE  that causes inflammation of the arachnoid, one of the membranes known as meninges that surround and protect the nerves of the central nervous system, including the brain and spinal cord. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Arachnoiditis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arachnoiditis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003074</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000064"/>
        <purl:Definition>A pregnancy AE that results in an interruption in the labor process that is associated with uterine contractions.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/arrested+labor</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arrested labor AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003118</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>an arrhythmia AE that is characterized by shortness of breath, heart palpitations, chest tightness, and a very fast pulse. Supraventricular arrhythmias begin in the areas above the heart’s lower chambers, such as the upper chambers (the atria) or the atrial conduction pathways.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>atrial arrhythmia</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.texasheart.org/HIC/Topics/cond/arrhycat.cfm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">supraventricular arrhythmia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003130</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE which causes a spasm of the large- or medium-sized coronary arteries</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>coronary artery spasm</obo1:IAO_0000118>
        <obo1:IAO_0000118>coronary artery vasospasm</obo1:IAO_0000118>
        <obo1:IAO_0000118>coronary vasospasm</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://sideeffects.embl.de/se/C0010073/pt</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary arteriospasm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003225</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000676"/>
        <purl:Definition>joint range of motion decreased AE caused by an excessive amount of scar tissue forming within the joint and surrounding soft tissue spaces</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Arthrofibrosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arthrofibrosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10058029</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>arteriosclerosis AE is a cardiovascular AE that results in  blood vessels and arteries becoming thick and stiff which can restrict blood flow to organs and tissues. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/arteriosclerosis-atherosclerosis/basics/definition/con-20026972</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arteriosclerosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003210</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002369"/>
        <purl:Definition>atheroslcerosis AE is a specific arteriosclerosis AE that refers to the buildup of fats, cholesterol and other substances in and on artery walls which can restrict blood flow.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/arteriosclerosis-atherosclerosis/basics/definition/con-20026972</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">atherosclerosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003601</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <purl:Definition>atrial tachycardia AE is a tachycardia AE that results in a fast heart rate beginning in the upper chambers of the heart</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>MedDRA: 10003668</obo1:IAO_0000118>
        <obo1:IAO_0000118>paroxysmal atrial tachycardia</obo1:IAO_0000118>
        <obo1:IAO_0000118>paroxysmal supraventricular tachycardia</obo1:IAO_0000118>
        <obo1:IAO_0000118>supraventricular tachycardia</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.heart.org/HEARTORG/Conditions/Arrhythmia/AboutArrhythmia/Tachycardia-Fast-Heart-Rate_UCM_302018_Article.jsp#</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">atrial tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>an endocrine system AE that results in high blood cortisol levels</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/003693.htm</obo1:IAO_0000119>
        <rdfs:comment>blood cortisol decreased AE may indicate that the patient has cushing disease, ectopic cushing syndrome, or a tumor of the adrenal gland that is producing too much cortisol. </rdfs:comment>
        <rdfs:label xml:lang="en">blood cortisol increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005458
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002373 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that results in easy or excessive bruising and bleeding. The bleeding results from unusually low levels of platelets.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>immune thrombocytopenic purpura</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/idiopathic-thrombocytopenic-purpura/basics/definition/con-20034239</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">idiopathic thrombocytopenic purpura AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10050245</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=2477
</obo1:IAO_0000119>
        <rdfs:comment>a pain AE that is observed in the bladder, usually a symptom of bladder infection.</rdfs:comment>
        <rdfs:label xml:lang="en">bladder pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10005063</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>an eye AE that results in involuntary, forcible closure of the eyelids.The spasms may leave the eyelids completely closed, causing functional blindness even though the eyes and vision are normal.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=2481</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">blepharospasm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005159</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <purl:Definition xml:lang="en">an abnormal vision AE which has an outcome of loss of vision in one eye that is not permanent.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH
</obo1:IAO_0000117>
        <obo1:IAO_0000118>blindness unilateral </obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Amaurosis_fugax</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">amaurosis fugax AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10005186</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>an endocrine system AE that results in low blood cortisol levels</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/003693.htm</obo1:IAO_0000119>
        <rdfs:comment>blood cortisol decreased AE may indicate that the patient has addison disease, hypopituitarism, suppression of normal pituitary or adrenal function. </rdfs:comment>
        <rdfs:label xml:lang="en">blood cortisol decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005457</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>an endocrine system AE that results in high blood creatine levels</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.mayoclinic.org/tests-procedures/creatinine/basics/definition/prc-20014534</obo1:IAO_0000119>
        <rdfs:comment>blood creatine increased AE may indicate that the kidneys are not fucntioning properly</rdfs:comment>
        <rdfs:label xml:lang="en">blood creatine increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005464
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>blood immunoglobin E increased  AE is an allergic response AE that signifies that a patient is allergic to a particular substance</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://kidshealth.org/parent/system/medical/test_ige.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">blood immunoglobin E increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005591</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>a male reproductive system AE that results in low levels of testosterone which can lead to infertility and a low sex drive </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/men/testosterone-15738
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">blood testosterone decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005814</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000550"/>
        <purl:Definition>A macrocytic anemia AE is an anemia AE that has an outcome of a macrocytic anemia, which is an anemia (defined as blood with an insufficient concentration of hemoglobin) in which the red blood cells (erythrocytes) are larger than their normal volume.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Macrocytic_anemia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">macrocytic anemia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002064</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <purl:Definition>a bone disorder AE that has an outcome of low bone densityl, but not low enough to be considered osteoporosis</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://nof.org/articles/9</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">low bone density AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049470
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000066"/>
        <purl:Definition> a surgical AE that occurs after a bone graftr procedure, which replaces missing bone in order to repair bone fractures that are extremely complex, pose a significant health risk to the patient, or fail to heal properly.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Bone_grafting</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">bone graft AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>bone marrow edema AE is an edema AE that occurs when excess fluids in the bone marrow buildup and cause swelling. This condition is often caused by a protective reaction of the body in response to an injury or inflammation</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.wisegeek.com/what-is-bone-marrow-edema.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">bone marrow edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10051763
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>an investigation result abnormal AE that detects areas of increased or decreased bone activity. These may indicate bone injury or disease. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH </obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mountsinai.org/patient-care/health-library/treatments-and-procedures/bone-scan</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">bone scan abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061941
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>Nervous system AE that covers a variety of conditions that may impair function of the brachial plexus nerve network, most of which are caused by trauma.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/neurology_neurosurgery/centers_clinics/peripheral_nerve_surgery/conditions/brachial_plexus_injury_bpi.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brachial plexus injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006074
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000621"/>
        <purl:Definition>a bradycardia AE that results in a disturbance in the heart rhythm in which the heart rate is abnormally slowed.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/bradyarrhythmia
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">bradyarrhythmia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049765

</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000621"/>
        <purl:Definition>a bradycardia AE that results in a fetal heart rate of less than 120 beats per minute, generally associatedwith hypoxia</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB:http://medical-dictionary.thefreedictionary.com/fetal+bradycardia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">bradycardia fetal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006094
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain disorder AE  that results in the complete and irreversible loss of brain function</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Brain_death
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain death AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049054
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain disorder AE  that results in brain tissue, cerebrospinal fluid, and blood vessels being moved or pressed away from their usual position inside the skull.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001421.htm

</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain herniation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006126
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain injury AE,  injury to the brain caused by an external force, that results in a brain AE</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Traumatic Brain Injury</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.biausa.org/FAQRetrieve.aspx?ID=43913


</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10067967

</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>a brain mass AE is a mass or growth of abnormal cells in your brain or close to your brain</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Brain Neoplasm </obo1:IAO_0000118>
        <obo1:IAO_0000118>Brain Tumor</obo1:IAO_0000118>
        <obo1:IAO_0000118>Intercranial Neosplasm</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/brain-tumor/home/ovc-20117132</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain mass AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10052334</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10061019
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001701"/>
        <purl:Definition>an imaging investigation result abnormal AE  shows how the brain and its tissues are working. Abnormal results may be due to: Alzheimer’s disease or dementia, brain tumors, epilepsy, and movement disorders. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>PET scan</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007341.htm
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain scan abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061943
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002395 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Eyelid disorder AE is a eye AE that is a condition specifically affects the eyelid. It can include drooping, twitching, inflammation, paralysis, and growths. Occasional fluttering of one eyelid is normal.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/eyelid-disorders#Overview1</obo1:IAO_0000119>
        <rdfs:label>eyelid disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061130</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001135"/>
        <purl:Definition>Hepatic steatosis AE is a liver disorder AE than popularly called as ‘fatty liver’ is a pathological aspect of liver, whose specific cells (hepatocytes) are filled with lipids (fats). It is a reversible liver disease: ‘is not still very ill, but cries for help’.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.bendomd.com/272-hepatic-steatosis-causes-symptoms-treatment.html</obo1:IAO_0000119>
        <rdfs:label>hepatic steatosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019708</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002397 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>An arthropathy AE is a joint pain AE that has an outcome of arthropahty, which is any disorder of the joints.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Arthropathy, http://medical-dictionary.thefreedictionary.com/arthropathy</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">arthropathy AE
</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10003285
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35760</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>A balantis AE is a reproductive system AE that has an outcome of a balantis, which is an infectious or non-infectious inflammatory process that affects the glans penis. Symptoms include redness and pain of the glans penis and foreskin and discharge.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000862.htm, http://en.wikipedia.org/wiki/Balanitis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">balanitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10004073
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000373"/>
        <purl:Definition>Pruritus genital AE is a pruritus AE that also called genital itching, Itching in the genital region can result from irritation, allergy, inflammation, infection or cancer. Irritation can occur as a result of exposure to chemicals in soaps, feminine hygiene products, perfumes, lubricants, douches, and creams.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000118>genital itching AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/genital-itching</obo1:IAO_0000119>
        <rdfs:label>pruritus genital AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10037093</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002400 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000959"/>
        <purl:Definition>cholecystitis AE is an gallbladder enlargement AE that has an outcome of cholecystitis, which is an acute or chronic inflammation involving the gallbladder wall. It may be associated with the presence of gallstones.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cholecystitis, http://www.mayoclinic.org/diseases-conditions/cholecystitis/basics/definition/con-20034277</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cholecystitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008612
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C34465</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <purl:Definition>Chromaturia AE is an urine abnormality AE that has an outcome of chromaturia, which is an abnormal coloration of the urine.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/chromaturia
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chromaturia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008796
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <purl:Definition>Chromosome abnormality AE is a genetic AE that has an outcome of chromsome abnormality which is a missing, extra, or irregular protion of chromosomal DNA.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chromosome_abnormality
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chromosome abnormality AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008815
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <purl:Definition>A coagulopathy AE is a blood disorder AE that has an outcome of coagulopathy, which is a condition in which there is a deviation from or interruption of the normal coagulation properties of the blood.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Coagulopathy
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coagulopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10009802
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>Combined immunodeficiency AE is an immune system AE that has an outcome of combined immunodeficiency, which represents a group of rare, sometimes fatal, congenital disorders characterized by little or no immune response.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/books/NBK22254/
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">combined immunodeficiency AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010099
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001694"/>
        <purl:Definition>Hepatic enzyme abnormal AE is a liver related investigation result abnormal AE that the lab test result of hepatic enzyme deviates from its normal value.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>hepatic enzyme abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062685</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001161"/>
        <purl:Definition>A coronary artery aneurysm AE is a coronary artery disorder AE that has an outcome of coronary artery aneurysm, which is a coronary dilatation which exceeds the diameter of normal adjacent segments or the diameter of the patient&apos;s largest coronary vessel by 1.5 times.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Coronary_artery_aneurysm</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/9247557</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary artery aneurysm AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011071
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <purl:Definition>Injection site atrophy AE is an injection-site AE that muscle atrophy occur in the injection site.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>injection site atrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022048</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <purl:Definition>A cutaneous tuberculosis AE is a tuberculosis AE that has an outcome of cutaneous tuberculosis, which is an invasion of the skin by Mycobacterium tuberculosis. </purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.dermnetnz.org/bacterial/tuberculosis.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cutaneous tuberculosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011684
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>Breath sounds abnormal AE is a respiratory system AE that is characterized by abnormal breath sound, it can indicate fluid in the lungs or asthma.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/breath-sounds#Overview1</obo1:IAO_0000119>
        <rdfs:label>breath sounds abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10064780</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Skin abrasion AE is a skin AE that is a wound caused by superficial damage to the skin, no deeper than the epidermis.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abrasion_%28medical%29</obo1:IAO_0000119>
        <rdfs:label>skin abrasion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10064990</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000514"/>
        <purl:Definition>Trigeminal neuralgia AE is a neuralgia AE that is a neuropathic disorder characterized by episodes of intense pain in the face, originating from the trigeminal nerve. The clinical association between TN and hemifacial spasm is the so-called tic douloureux.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Fothergill&apos;s disease AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>prosopalgia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Trigeminal_neuralgia</obo1:IAO_0000119>
        <rdfs:label>trigeminal neuralgia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044652</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <purl:Definition>Face injury AE is an injury AE that injury occurs in the face.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>face injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10050392</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>Muscle contrature AE is a muscle AE that can occur for many reasons, such as paralysis, muscular atrophy, and forms of muscular dystrophy. Fundamentally, the muscle and its tendons shorten, resulting in reduced flexibility.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Muscle_contracture</obo1:IAO_0000119>
        <rdfs:label>muscle contrature AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062575</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Gaze palsy AE is a behavior and neurological AE that is a symmetric limitation of the movements of both eyes in the same direction.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://one.aao.org/bcscsnippetdetail.aspx?id=f5a77965-de2a-4fb0-82fb-5f4089671ad6</obo1:IAO_0000119>
        <rdfs:label>gaze palsy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10056696</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002414"/>
        <purl:Definition>Conjugate gaze palsy AE is a gaze palsy AE that is a disorder affecting the ability to move both eyes in the same direction. These palsies can affect gaze in a horizontal, upward, or downward direction.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Conjugate_gaze_palsy</obo1:IAO_0000119>
        <rdfs:label>conjugate gaze palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002414"/>
        <purl:Definition>Horizontal gaze palsy AE is a gaze palsy AE that is the paresis of conjugate eye movements.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Horizontal_gaze_palsy</obo1:IAO_0000119>
        <rdfs:label>horizontal gaze palsy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001778"/>
        <purl:Definition>Posture abnormal AE a behavioral AE that refers to rigid body movements and chronic abnormal positions of the body. This symptom is not the same as showing poor posture or slumping over. Rather, it is often the result of a serious spinal cord or brain injury.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/symptom/posture-abnormal</obo1:IAO_0000119>
        <rdfs:label>posture abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036436</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001778"/>
        <purl:Definition>Tonic clonic movements AE a behavioral AE that shows the body becomes entire rigid and uncontrolled jerking. They may last mere seconds, or continue for several minutes.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>tonic clonic movements AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10051171</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002419 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002419">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002395"/>
        <purl:Definition>Eyelid ptosis AE is an eye disorder AE that is a drooping or falling of the upper or lower eyelid.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ptosis_%28eyelid%29</obo1:IAO_0000119>
        <rdfs:label>eyelid ptosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015995</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000205"/>
        <purl:Definition>Facial paresis AE is a paresis AE that is a common problem that involves the paralysis of any structures innervated by the facial nerve.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>facial nerve paralysis AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Facial_nerve_paralysis</obo1:IAO_0000119>
        <rdfs:label>facial paresis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10051267</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002421 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002421">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <purl:Definition>Menstrual disorder AE is an irregular condition in a woman&apos;s menstrual cycle.</purl:Definition>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Menstrual_disorder</obo1:IAO_0000119>
        <dc:creator>JX, YH</dc:creator>
        <rdfs:label>menstrual disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027327</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002422 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002422">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000546"/>
        <purl:Definition>Fluid retention AE is an abnormal fluid regulation AE that is excess fluid that collects in the tissues in your body. Most commonly, fluid retention is marked by swelling of your feet and lower legs, but swelling could also occur in your arms, hands, face, or other areas of the body.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/fluid-retention</obo1:IAO_0000119>
        <rdfs:label>fluid retention AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016807</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002423 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000914"/>
        <purl:Definition>Emotional distress AE is a emotional disorder AE that is a Mental distress or anxiety suffered as a response to a sudden, severe, and saddening experience.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Emotional_distress</obo1:IAO_0000119>
        <rdfs:label>emotional distress AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049119</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002424 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002424">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <purl:Definition>Encephalitis AE is a nervous system AE that is an acute inflammation of the brain.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Encephalitis</obo1:IAO_0000119>
        <rdfs:label>encephalitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10014581</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002425">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Cognitive disorder AE is a mental disorder AE that is a category of mental health disorders that primarily affect learning, memory, perception, and problem solving, and include amnesia, dementia, and delirium.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cognitive_disorder</obo1:IAO_0000119>
        <rdfs:label>cognitive disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10057668</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002426 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002426">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000426"/>
        <purl:Definition>Incoherent AE is a speech disorder AE that shows unable to express one&apos;s thoughts or ideas in an orderly, intelligible manner.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/incoherent</obo1:IAO_0000119>
        <rdfs:label>incoherent AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021630</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <purl:Definition>Exercise tolerance decreased AE is a systematic AE that shows exercise tolerance decreased. The exercise tolerance refers to the exercise capacity of an individual as measured by their ability to endure exercise and/or the maximum work load achieved during the exercise period.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://copd.about.com/od/glossaryofcopdterms/g/activitytoleran.htm</obo1:IAO_0000119>
        <rdfs:label>exercise tolerance decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10051301</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002569"/>
        <purl:Definition>a burn AE that is a type of burn resulted from making contact with heated objects, such as boiling water, steam, hot cooking oil, fire, and hot objects.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Thermal_burn</obo1:IAO_0000119>
        <rdfs:label>thermal burn AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053615</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Dissociation AE is a mental disorder AE that describes a wide array of experiences from mild detachment from immediate surroundings to more severe detachment from physical and emotional experience.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Dissociation_%28psychology%29</obo1:IAO_0000119>
        <rdfs:label>dissociation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013457</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002431 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002431">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000063"/>
        <purl:Definition>Mucous membrane disorder AE is a systematic AE that the diseases occur in mucous membrane, which is a lining of mostly endodermal origin.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Mucous_membrane</obo1:IAO_0000119>
        <rdfs:label>mucous membrane disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028133</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002432 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002432">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000558"/>
        <purl:Definition>Demyelinating polyneuropathy AE is a nervous system AE that is a condition that arises when the myelin sheaths around nerve cells are damaged. Myelin, the insulating layer of tissue that surrounds nerve cells, helps ensure that signals from the brain are rapidly transmitted to the proper places in the body. When myelin is damaged or destroyed, it can lead to problems with communication between the brain and the body.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/conditions/chronic-inflammatory-demyelinating-polyneuropathy</obo1:IAO_0000119>
        <rdfs:label>demyelinating polyneuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061811</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>a syndrome AE that results in increased pressure in a muscle compartment which can lead to nerve damage and impaired blood flow. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.nlm.nih.gov/medlineplus/ency/article/001224.htm</obo1:IAO_0000119>
        <rdfs:comment>Thick layers of tissue, called fascia, separate groups of muscles in the arms and legs from each other. Inside each layer of fascia is a confined space, called a compartment. The compartment includes the muscle tissue, nerves, and blood vessels.</rdfs:comment>
        <rdfs:label xml:lang="en">compartment syndrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010121</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002434 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002434">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002475"/>
        <purl:Definition>Therapeutic response decreased is found among people who take Cialis, especially for people who are male, 60+ old, have been taking the drug for &lt; 1 month, also take medication Aspirin, and have Erection problems.</purl:Definition>
        <obo1:IAO_0000117>JX, LW</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ehealthme.com/ds/cialis/therapeutic+response+decreased</obo1:IAO_0000119>
        <rdfs:label>therapeutic response decreased</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043414</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>a seizure AE that resutls in impariment of awareness and involuntary but coordinated and repeated movements. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ </obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/epilepsy/guide/types-of-seizures-their-symptoms?page=2</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">complex partial seizure AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010145</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>Autoimmune disorder AE is an immune system AE that arises from an abnormal immune response of the body against substances and tissues normally present in the body (autoimmunity).</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Autoimmune_disease</obo1:IAO_0000119>
        <rdfs:label>autoimmune disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061664</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of bleeding into the pons or mesencephalon.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/brainstem+hemorrhage</obo1:IAO_0000119>
        <rdfs:comment>brain stem hemorrhage AE is often secondary to brainstem distortion due to rapidly expanding intracranail lessions.</rdfs:comment>
        <rdfs:label xml:lang="en">brainstem hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006146</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002439 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002439">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002421"/>
        <purl:Definition>Menstruation irregular AE is a endocrine system AE that is an abnormal variation in length of menstrual cycles in a female.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Irregular_menstruation</obo1:IAO_0000119>
        <rdfs:label>menstruation irregular AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027339</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002440 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002440">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>Generalised tonic-clonic seizure AE is a seizure AE that is a type of generalized seizure that affects the entire brain. Tonic–clonic seizures are the seizure type most commonly associated with epilepsy and seizures in general, though it is a misconception that they are the only type.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tonic%E2%80%93clonic_seizure</obo1:IAO_0000119>
        <rdfs:label>generalised tonic-clonic seizure AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018100</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002441 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002441">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001797"/>
        <purl:Definition>Posturing AE is a mental disorder AE that an involuntary flexion or extension of the arms and legs, indicating severe brain injury.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abnormal_posturing</obo1:IAO_0000119>
        <rdfs:label>posturing AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036437</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>Demyelination AE is a nervous system AE that is any disease of the nervous system in which the myelin sheath of neurons is damaged.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Demyelinating_disease</obo1:IAO_0000119>
        <rdfs:label>demyelination AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012305</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002444 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002444">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001605"/>
        <purl:Definition>Gram stain negative AE is a microbiology and serology investigation result abnormal AE that has an outcome of detection of gram-negative bacteria.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Gram-negative_bacteria</obo1:IAO_0000119>
        <rdfs:label>gram stain negative AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018656</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002445 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002445">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000293"/>
        <purl:Definition>Red blood cells CSF positive AE is a CSF test result abnormal AE that has an outcome of CSF red blood cells count positive.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>red blood cells CSF positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038173</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002446 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002446">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000293"/>
        <purl:Definition>CSF white blood cell count increased AE is a CSF test result abnormal AE that has an outcome of CSF white blood cell count increased.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>CSF white blood cell count increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053805</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000675"/>
        <purl:Definition>Influenza A virus test positive AE is a influenza virus test positive AE that has an outcome of positive result in an influenza A virus test.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <rdfs:label>influenza A virus test positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10070215</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001789"/>
        <purl:Definition>Nerve conduction studies abnormal AE is a neurological AE that shows a abnormal result of nerve conduction study (NCS). NCS is a medical diagnostic test commonly used to evaluate the function, especially the ability of electrical conduction, of the motor and sensory nerves of the human body.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Nerve_conduction_study</obo1:IAO_0000119>
        <rdfs:label>nerve conduction studies abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029175</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002449 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002449">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <purl:Definition>Myocardial necrosis AE is a cardiac disorder AE that shows death of the cells of an area of the heart muscle (myocardium) as a result of oxygen deprivation, which in turn is caused by obstruction of the blood supply.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://medical-dictionary.thefreedictionary.com/myocardial+necrosis</obo1:IAO_0000119>
        <rdfs:label>myocardial necrosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028602</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002450 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002450">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001790"/>
        <purl:Definition>a brainstem infarction AE is a stroke AE that occurs when blood cannot flow to the brainstem, when oxygen cannot get to an area of the brain, tissue in that area may be damaged. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>brainstem stroke</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Brain_stem_stroke_syndrome</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.drugs.com/cg/brain-stem-infarction.html
</obo1:IAO_0000119>
        <rdfs:comment>A person may have vertigo, dizziness and severe imbalance without the hallmark of most strokes – weakness on one side of the body. But dizziness alone is not a sign of stroke. Brain stem stroke can also cause diplopia, slurred speech and decreased level of consciousness.</rdfs:comment>
        <rdfs:label xml:lang="en">brainstem infarction AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006147</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002451 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000434"/>
        <purl:Definition>a lung disorder AE that occurs when the noises produced by the structures of the lungs during breathing are decreased or absent. </purl:Definition>
        <obo1:IAO_0000117> SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007535.htm</obo1:IAO_0000119>
        <rdfs:comment>Absent or decreased breath sounds can indicate air or fluid around the lungs, increased thickness of chest wall, over-inflation of part of the lungs, or reduced airflow to part of the lungs.</rdfs:comment>
        <rdfs:label xml:lang="en">breath sounds decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006333</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002452 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002452">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000209"/>
        <purl:Definition>a genetic disorder AE that is characterised by abnormal electrocardiogram (ECG) findings and an increased risk of sudden cardiac death.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>sudden adult death syndrome (SADS)</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Brugada_syndrome</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">Brugada sydnrome AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10059027</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002453 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002453">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Buttock pain AE is a pain AE that  is a common problem in the butt, it can be due to  bursitis, bruising, piriformis syndrome, and shingles,or due to more serious diseases with long-term consequences, such as cancer, arthritis of the sacroiliac joints, and herniated disc with sciatica.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Butt Pain </obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB:http://www.medicinenet.com/buttock_pain/symptoms.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">buttock pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10048677</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002454 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002454">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>a digestive system AE with an outcome of small white calcium lumps forming under the skin that may leak a chalky white fluid. These lumps are formed becuase of too much calcium in the diet. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.sclero.org/medical/symptoms/skin/calcinosis.html</obo1:IAO_0000119>
        <rdfs:comment>These most commonly occur on the hands, or near joints such as elbows or knees, although they may appear anywhere. Calcinosis may range from one very tiny deposit, to large (and often painful) clusters.</rdfs:comment>
        <rdfs:label xml:lang="en">calcinosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10006938</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection adverse event that caused by a species of the yeast Candida. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/candidiasis</obo1:IAO_0000119>
        <rdfs:comment>This is a common cause of vaginal infections in women. Also, Candida may cause mouth infections in people with reduced immune function, or in patients taking certain antibiotics. Candida can be found in virtually all normal people but causes problems in only a fraction.</rdfs:comment>
        <rdfs:label xml:lang="en">candidiasis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007152</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>an investigation result abnormal AE that occurs when the cardaic enzymes and proteins leak out of damaged heart muscle cells, and their levels in the bloodstream rise.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://www.webmd.com/heart-disease/cardiac-enzyme-studies</obo1:IAO_0000119>
        <rdfs:comment>cardiac enzymes increased AE may indicate that the heart muscle is injured, such as from a heart attack.</rdfs:comment>
        <rdfs:label xml:lang="en">cardiac enzymes increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007548</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002457 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002457">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <purl:Definition>Acute decompensated heart failure AE is a cardiovascular disorder AE that shows  a worsening of the symptoms, typically shortness of breath (dyspnea), edema, and fatigue, in a patient with existing heart disease.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Cardiac Failure Acute</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_decompensated_heart_failure</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">acute decompensated heart failure AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007556</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10064653</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002459 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002459">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>Cardiac murmur AE  is a cardiac disorder AE that is characterised by abnormal sounds during the heartbeat cycle — such as whooshing or swishing — made by turbulent blood in or near the heart.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Heart Murmur</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/heart-murmurs/basics/definition/con-20028706</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cardiac murmur AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007586</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002460 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that is seen most frequently in schizophrenia, characterized by muscular rigidity and mental stupor, sometimes alternating with great excitement and confusion. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://dictionary.reference.com/browse/catatonia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">catatonia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007776</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002461 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001161"/>
        <purl:Definition>a coronary artery disorder AE that results in narrowing of the inner surface of the carotid atery. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Carotid_artery_stenosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">carotid artery stenosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007687</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002462 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002462">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>orbital cellulitis AE is a sudden infection of the tissues around the eye, affecting the eyelid, eyebrow, and cheek.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001012.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">orbital cellulitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10007918</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002406"/>
        <purl:Definition>Chronic cholecystitis AE the inflammation of the gallbladder persisting for a prolonged period of time or having repeated attacks.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/chronic-cholecystitis#Overview1</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chronic cholecystitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008617</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002464 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002464">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain lesion AE is an area of injury or disease within the brain.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/brain/brain-lesions-causes-symptoms-treatments

    
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">brain lesion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10051290
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>Central venous pressure increased AE is a mesaurement of the pressure of the blood within the superior and inferior vena cava and large veins of the body. Increased pressure can be the result of cardiac failure and congestion of circulation. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/central+venous+pressure</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">central venous pressure increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10007980</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002466 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002466">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001551"/>
        <purl:Definition>a brain disorder AE occurs when the brain is damaged by injury, disease, or health conditions.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/brain-disorders#Overview1

</obo1:IAO_0000119>
        <rdfs:comment>Brain disorders may affect the main areas of your brain that control how you move, think, and behave. Some tumors can constrict the blood vessels in your brain.</rdfs:comment>
        <rdfs:label xml:lang="en">brain disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10054938</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002467 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002467">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <purl:Definition>a cerebral infarction is a type of ischaemic stroke AE that is caused by a blockage in the blood vessels supplying blood to the brain.</purl:Definition>
        <obo1:IAO_0000117>SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cerebral_infarction</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cerebral infarction AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008118</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002468 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002468">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE that occurs when the cerebrospinal fluid leaks through a defect in the dura or the skull and out through the nose or ear resulting from a tear in the dura. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.hopkinsmedicine.org/neurology_neurosurgery/centers_clinics/brain_tumor/center/skull-base/types/csf-leak.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cerebrospinal fluid leak AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008164</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002469 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002469">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000082"/>
        <purl:Definition>a female reproductive system AE that refers to abnormal changes in the cells on the surface of the cervix. The changes are not cancer. But they can lead to cancer of the cervix if not treated.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001491.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cervical dysplasia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008263</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <purl:Definition>a bone disorder AE that results in pain and neurological symptoms resulting from any type of condition that irritates a nerve in the cervical spine.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.spine-health.com/conditions/neck-pain/what-cervical-radiculopathy</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cervical radiculopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008303</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002471 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002471">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>Cervical spinal stenosis AE is a nervous system AE that occurs when the spinal canal in the neck narrows. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/back-pain/tc/cervical-spinal-stenosis-topic-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cervical spinal stenosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008313</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002472 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002472">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory AE that results in the inability to breath because something gets stuck in the throat or because the air is not good for breathing</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/choke</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">choking AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10008589</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal and connective tissue AE that results in tlhe disappearance of articular cartilage as the result of disintegration or dissolution of the cartilage matrix and cells.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medilexicon.com/medicaldictionary.php?t=17184</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chondrolysis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10058112</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002474 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>A joint disorder AE in which  the cartilage on the undersurface of the patella deteriorates and softens. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthline.com/health/chondromalacia-patella#Overview1</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chondromalacia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10008729</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002475 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002475">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that occurs after a therapeutic intervention</purl:Definition>
        <obo1:IAO_0000117>YH, JX</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">therapy adverse event</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>a seizure AE that resutls in jerking and muscle rigidity, unusual sensations affecting vision, hearing, smell, taste or touch, and memory or emothional disturbances. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ </obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/epilepsy/guide/types-of-seizures-their-symptoms?page=2</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">simple partial seizure AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040703</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002478 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000837"/>
        <purl:Definition>chemosis AE is a conjunctival disorder AE that results in swelling of the conjunctiva die to exudation of abnormaly permeable capillaries. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH </obo1:IAO_0000117>
        <obo1:IAO_0000118>conjunctival edema</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Chemosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">chemosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053163</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001789"/>
        <purl:Definition>conversion disorder AE is a neurological AE that results in the expression of psychlogical stress in physical ways or a mental or emotional crises that begins to have a physical affect. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>functional neurological symptom disorder</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/conversion-disorder/basics/definition/con-20029533</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">conversion disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010893</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002481 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE which causes a thickening and loss of elasticity of the coronary arteries, leading to progressive insufficiency of the arteries.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>arteriosclerotic coronary artery disease</obo1:IAO_0000118>
        <obo1:IAO_0000118>coronary artery atherosclerosis</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://ghr.nlm.nih.gov/glossary=coronaryarteriosclerosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary arteriosclerosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011076</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002482 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE which causes a partial or complete blockage of the coronary artery which can lead to heart attack.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Coronary_occlusion</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary occlusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011086</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002483 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>a cardiac disorder AE which results in inflammation and the buildup of plaque which narrow the coronary arteries. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/coronary-artery-disease/basics/definition/con-20032038</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">coronary artery disease AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011089</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002484 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002484">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>An joint disorder AE that results in the noise produced by the rubbing together of bone or irregular cartilage surfaces. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ </obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/crepitation</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">crepitation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011376</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002485 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002485">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <purl:Definition>cryptorchidism AE is a male reproductive system AE which results in the absence of one or both testes from the scrotum. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>undescended testis </obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cryptorchidism</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cryptorchidism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011498</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002486 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002486">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000293"/>
        <purl:Definition>CSF glucose is proportional to blood glucose levels which correspond to 60-70% of the concentration in blood. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypoglycorrhachia</obo1:IAO_0000118>
        <rdfs:comment>decreased CSF glucose AE can be caused by CNS infections, inflammatory conditions, subarachnoid hemorrhage, hypoglycemia, impaired glucose transport, increased CNS glycolytic activity and metastatic carcinoma.</rdfs:comment>
        <rdfs:label xml:lang="en">decreased CSF glucose AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011537</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002487 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002487">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>wound culture positive AE is a a test to find and identify germs that may be growing on the skin or in a wound.  If something that can cause infection grows, the culture is positive. The type of organisms may be identified with a microscope, chemical tests, or both.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/a-to-z-guides/skin-and-wound-cultures</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">wound culture positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011643</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>skin cyst AE is a skin AE that occurs when  a cluster of cells that have grouped together to form a sac which may contain air, fluids, or semi-solid material.</purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>cyst</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cyst</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">skin cyst AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011732</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002489 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002489">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <purl:Definition>conductive hearing loss AE is a hearing loss AE that results from probelms with the ear canal, ear drum, or middle ear and its little bones. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>sensorineural hearing loss (SNHL)</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.hearingloss.org/content/types-causes-and-treatment</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">conductive hearing loss AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10010282</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002490 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002490">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001986"/>
        <purl:Definition>transient hearing loss AE is a hearing loss AE that results from poor ventilation of the middle ear in children. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>deafness transitory </obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3139416/
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">transient hearing loss AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011900</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that results in a persistent false psychotic belief regarding the self or objects outside the self that is maintained despite indisputable evidence to the contrary.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merriam-webster.com/dictionary/delusion</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">delusion AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012239</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001778"/>
        <purl:Definition>a behavioral AE that results in long-standing need for the person to be taken care of and a fear of being abandoned or separated from important individuals. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://psychcentral.com/disorders/dependent-personality-disorder-symptoms/</obo1:IAO_0000119>
        <rdfs:comment>Individuals with Dependent Personality Disorder are often characterized by pessimism and self-doubt, and tend to belittle their abilities and assets. This leads the person to engage in dependent and submissive behaviors that are designed to elicit care-giving behaviors in others.</rdfs:comment>
        <rdfs:label xml:lang="en">dependent personality disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012355</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002493 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002493">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Nervous system AE that results in failure to meet certain developmental milestones, such as sitting, walking, and talking, at the average age.  Developmental delay may indicate a problem in development of the central nervous system.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/developmental+delay</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">developmental delay AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012559</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>diabetic ketoacidosis AE  is a cardiovascular AE that develops when your body is unable to produce enough insulin and begins to break down fat as an alternate fuel, this process produces a buildup of toxic acids in the bloodstream called ketones. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/diabetic-ketoacidosis/basics/definition/con-20026470</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">diabetic ketoacidosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012671</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000204"/>
        <purl:Definition>congenital diaphragmatic hernia AE is a congential disorder in which an absent or partially formed diaphragm results in an abnormal opening that allows the stomach and intestines to move into the chest cavity and crowd the heart and lungs. This crowding can lead to underdevelopment of the lungs, potentially resulting in life-threatening breathing difficulties that are apparent from birth.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aspiration</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">congenital diaphragmatic hernia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061106</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000539"/>
        <purl:Definition>a paralysis AE that has an outcome of  paralysis affecting symmetrical parts of the body.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Diplegia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">diplegia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013033</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001918"/>
        <purl:Definition>cystitis interstitial AE is a cystitis AE that has an outcome of cystitis interstitial, which is a condition that causes discomfort or pain in the bladder and a need to urinate frequently and urgently.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/interstitialcystitis.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">cystitis interstitial AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011796</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001474"/>
        <purl:Definition>A disseminated tuberculosis AE is a tuberculosis AE that has an outcome of disseminated tuberculosis, which is a contagious bacterial infection in which TB bacteria has spread from the lungs to other parts of the body through the blood or lymph system.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000624.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">disseminated tuberculosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10013453
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000533"/>
        <purl:Definition>Exotosis AE is a bone pain AE that has resulted in a non-neoplastic overgrowth of bone.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Exostosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">exotosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015688</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition xml:lang="en">An exudative retinopathy AE is an eye AE that shows an outcome of exudative retinopathy marked by masses of white or yellowish exudate in the posterior part of the fundus oculi, with deposits of cholesterol and blood debris from retinal hemorrhage, that leads to destruction of the macula and blindness.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Coats&apos; disease, Coats&apos; retinitis</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/exudative+retinopathy
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">exudative retinopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10015901</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000522"/>
        <purl:Definition>A tendon disorder AE that has an outcome of tendinous which is damage to a tendon at a cellular level. It is thought to be caused by microtears in the connective tissue in and around the tendon, leading to an increase in tendon repair cells.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Tendinosis
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">tendinous AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016662</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002503 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001678"/>
        <purl:Definition>A monocyte percentage abnormal AE that results in abnormally high levels of monocytes in the blood.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Monocytosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">monocytosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027906</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35147</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
        <purl:Definition>A male reproductive system AE that has an outcome of genital candidiasis, which is a fungal infection due to any types of Candida (types of yeasts). This is a fungal infection of the genital region.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Candidiasis</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.cdc.gov/fungal/diseases/candidiasis/genital/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">genital candidiasis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018143</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/pain-management/tc/groin-problems-and-injuries-topic-overview</obo1:IAO_0000119>
        <rdfs:comment>A groin pain AE is a pain AE that shows a pain in the groin area.</rdfs:comment>
        <rdfs:label xml:lang="en">groin pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018735
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <purl:Definition>A blood disorder AE that has an outcome of the breakdown of red blood cells.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hemolysis
</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/002372.htm
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">haemolysis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10018910
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000562"/>
        <purl:Definition>A hepatosplenomegaly AE is a liver inflammation AE that has an outcome of an abnormal enlargement of the liver and spleen.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB:  http://www.nlm.nih.gov/medlineplus/ency/imagepages/17215.htm
</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=3716</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">hepatosplenomegaly AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019847</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002508 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002508">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <purl:Definition>A gastric disorder AE that occurs when part of your stomach pushes upward through your diaphragm.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/hiatal-hernia/basics/definition/con-20030640
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">hiatus hernia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020028
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002509 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002509">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000466"/>
        <purl:Definition>A viral infection AE that is caused by the human immunodeficiency virus.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">HIV infection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020161
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C3108
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002510 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002510">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>A hypertonic bladder AE is a digestive system AE that where the bladder-storage function that causes a sudden urge to urinate.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>irritable bladder</obo1:IAO_0000118>
        <obo1:IAO_0000118>overactive bladder
</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://healbladder.info/healbladder/hypertonic-bladder</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/overactive-bladder/basics/definition/con-20027632
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">hypertonic bladder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10020853
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002511 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition>A hypovitaminosis AE is a gustatory system AE which shows an insufficiency of one or more essential vitamins.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypovitaminosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">hypovitaminosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021135
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002512 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002512">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <purl:Definition>A gastrointestinal disorder AE that shows the inflammation of the ileum.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Ileitis
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">ileitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021312
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C84782
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002513 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002513">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>A joint pain AE that occurs when there is an abnormal separation in the joint, where two or more bones meet.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>dislocated joint, luxation
</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Joint_dislocation
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">joint dislocation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023204
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>A syndrome AE that shows Kawasaki&apos;s disease, a vasculitis characterized by inflammation of the arteries, particularly the coronary arteries. The vasculitis may lead to aneurysm formation and possibly, heart attacks. It affects young children who usually present with persistent high fever, redness of the mucous membranes of the mouth, redness of the palms and soles, skin rashes, lymphadenitis, and joint pain and swelling.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Mucocutaneous Lymph Node Syndrome
</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Kawasaki_disease
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">kawasaki disease AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023320
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C34825
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <purl:Definition>An abscess AE where a bacterial, parasitic, or fungal abscess that develops in the liver. It is usually the result of an abdominal infection, trauma, or surgery in the right upper quadrant. Signs and symptoms include abdominal pain, nausea, vomiting, and fever.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Liver_abscess
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">liver abscess AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10024652
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C99089
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000731"/>
        <purl:Definition>A blood disorder AE that the body&apos;s blood supply will stop moving after the heart has stopped pumping it around the inside of the deceased.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.exploreforensics.co.uk/rigor-mortis-and-lividity.html
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">lividity AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10024728
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002517 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>A lymphangitis AE is an inflammation AE that has an infection of the lymph vessels (channels).</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/007296.htm
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">lymphangitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10025226
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002518 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <obo1:IAO_0000112>An infection adverse event that results in malaria, a protozoan infection caused by the genus Plasmodium. There are four species of Plasmodium that can infect humans: Plasmodium falciparum, vivax, ovale, and malariae. It is transmitted to humans by infected mosquitoes. Signs and symptoms include paroxysmal high fever, sweating, chills, and anemia.</obo1:IAO_0000112>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Malaria</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">malaria AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10025487
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C34797
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001172"/>
        <purl:Definition>A metabolic disoder AE where there is increased acidity in the blood secondary to acid base imbalance. Causes include diabetes, kidney failure and shock.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Acidosis
</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000335.htm
</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">metabolic acidosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10027417
</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C28228
</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <purl:Definition>An abnormal stool AE that has an outcome of a significant amount of mucus in the stool. The mucus is accompanied by diarrhea, pain or blood may signify an intestinal condition such as infection or inflammation. Increased amounts of mucus in the stool can also occur with cancers of the colon or rectum or with bowel obstruction.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/mucus-in-stool</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">mucous stool AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028140</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002521 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002521">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <purl:Definition>A muscle spasm AE that has an outcome of tight or stiff muscles and an inability to control those muscles.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/pain-management/pain-management-spasticity</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">muscle spasticity AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10028335</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000347"/>
        <purl:Definition>A respiratory distress AE that has an outcome of a newborn dyspnea (i.e., impaired breathing) with cyanosis, most frequently occurring in premature infants, children of diabetic mothers and infants delivered by cesarean section, and sometimes with no predisposing cause.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Newborn Respiratory Distress Syndrome</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001563.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">neonatal respiratory distress AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001052</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C27560</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002523 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002523">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000039"/>
        <purl:Definition>A neutrophil count increased AE that has an outcome of an abnormally high level of neutrophils in the blood.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Neutrophilia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">neutrophilia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10029379</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35164</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002524 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <purl:Definition>A male reproductive system AE that results in an inflammation of one or both testes due to viral or bacterial infections. Signs and symptoms include enlargement or tenderness of the affected testis, inguinal lymphadenopathy, blood in the semen, and pain during urination, intercourse, or ejaculation.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001280.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">orchitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031064</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C97145</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE that occurs in a bone.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Osteitis fibrosa</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001252.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">osteitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031149</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000518"/>
        <purl:Definition>A bone disorder AE that has an dissolution of bone, especially the removal or loss of the calcium of bone.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Osteolysis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">osteolysis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031248</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C50681</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>An arrhythmia AE that has an outcome of palpitations, an abnormality of heartbeat characterized by simultaneous awareness of one’s pulse and discomfort.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Palpitations</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">palpitations AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10033557</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>A skin AE that shows a solid, raised spot on the skin that is up to 0.5 centimeter wide, which is a type of skin lesion.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003233.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">papule AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10033733</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000535"/>
        <purl:Definition>A parotid gladn enlargement AE that has an outcome of parotitis, the inflammation of one or more of the parotid glands.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/882461-overview</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001041.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">parotitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034038</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002530 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002530">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <purl:Definition>A male reproductive system AE that has an disorder in a penis, including priapism, Peyronie&apos;s disease, balanitis, phimosis, paraphimosis, and penile cancer.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/penis_disorders/article.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">penis disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034336</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000208"/>
        <purl:Definition>An abdominal AE that shows an inflammation of the peritoneum, the thin tissue that lines the inner wall of the abdomen and covers most of the abdominal organs.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Peritonitis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">peritonitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034674</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C26849</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>An arthritis AE that has an outcome of polyarthritis, which includes any type of arthritis that involves 5 or more joints simultaneously.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Polyarthritis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">polyarthritis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036030</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000083"/>
        <purl:Definition>A male reproductive system AE that affects prostatic gland in the male reproductive system.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.britannica.com/EBchecked/topic/479519/prostatic-disorder</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">prostatic disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036956</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002535 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002535">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000052"/>
        <purl:Definition>A tumor AE that shows a benign disorder of lymphoid cells or histiocytes that produces clinical features of a malignant lymphoma.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/pseudolymphoma</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">pseudo lymphoma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037108</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002536 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002536">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>A skin AE that shows a pyogenic skin disease. These include superficial bacterial infections such as impetigo, impetigo contagiosa, ecthyma, folliculitis, Bockhart&apos;s impetigo, furuncle, carbuncle, tropical ulcer, etc.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pyoderma</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">pyoderma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037632</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002537 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002537">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000495"/>
        <purl:Definition>A urine abnormality AE that shows the presence of white blood cells or pus in the urine, usually a sign of urinary tract infection.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pyuria</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/pyuria</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">pyuria AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037686</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>A rash AE that has an outcome of maculopapular rash, a disorder characterized by the presence of macules (flat) and papules (elevated). Also known as morbillform rash, it is one of the most common cutaneous adverse events, frequently affecting the upper trunk, spreading centripetally and associated with pruritis.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Maculopapular Lesion</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Maculopapular_rash</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">maculopapular rash AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037868</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C75579</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002539 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>A rash AE that shows a rash like measles. The rash consists of macular lesions that are red and usually 2–10 mm in diameter but may be confluent in places.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Morbilliform</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">morbilliform AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037870</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002540 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002540">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>A rash AE that shows a raised, blistery rash.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=11955</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">vesicular rash AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037898</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002541 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002541">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001712"/>
        <purl:Definition>A red blood cell count increased AE that has an increased count of reticulocytes in the blood. Reticulocytes are slightly immature red blood cells.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003637.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">reticulocyte count increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038792</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that results in impaired or inhibited ego functioning in which the ability to process reality-based information is diminished and disordered. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/acute+psychosis</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">acute psychosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001022</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>An eye AE that shows an abnormal blood vessel development in the retina of the eye and it occurs in infants that are born too early.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Terry syndrome</obo1:IAO_0000118>
        <obo1:IAO_0000118>retrolental fibroplasia</obo1:IAO_0000118>
        <obo1:IAO_0000118>retrolental fibroplasia (RLF)</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Retinopathy_of_prematurity</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/001618.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">retinopathy of prematurity AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038933</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>A skin AE that results in a scar, a mark left on the skin.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Scar</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">scar AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039580</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C34483</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002437"/>
        <purl:Definition>A skin AE that has an outcome of a localized or systemic chronic and progressive autoimmune disorder characterized by thickening of the skin and the connective tissues.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Scleroderma</obo1:IAO_0000119>
        <rdfs:comment>Localized scleroderma affects only the skin. Systemic scleroderma affects internal organs, including the heart, lungs, gastrointestinal tract, and kidneys.</rdfs:comment>
        <rdfs:label xml:lang="en">scleroderma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039710</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C26746</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>A male reproductive system AE that has an outcome of an abnormal enlargement of the scrotum, the sac surrounding the testicles.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>scrotal edema</obo1:IAO_0000118>
        <obo1:IAO_0000118>scrotal swelling</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003161.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">scrotal oedema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039755</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>A skin AE that results in the degeneration and thinning of the epidermis and dermis.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>atrophy of the skin</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.wisegeek.com/what-is-skin-atrophy.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">skin atrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10040799</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35163</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002548 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002548">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition>A skin discoloration AE that shows the lightening of the skin, or loss of pigment.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Depigmentation</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Depigmentation</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">skin depigmentation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10040825</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002549 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition>A skin discoloration AE that shows abnormal lightening of skin due to decreased melanin production or deposition.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Hypopigmentation, Pigment Dilution</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypopigmentation</obo1:IAO_0000119>
        <rdfs:comment>Vitiligo, albinism, and leukoderma are among the disorders that are associated with skin hypopigmentation.</rdfs:comment>
        <rdfs:label xml:lang="en">skin hypopigmentation AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10040868</rdfs:seeAlso>
        <rdfs:seeAlso>http://en.wikipedia.org/wiki/Hypopigmentation</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000476"/>
        <purl:Definition>An immune system disorder AE that has an disorder in spleen, the largest organ in the lymphatic system.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>splenic diseases</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Splenic_disease</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.livescience.com/44725-spleen.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">spleen disorder AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041633</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002551 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002551">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000027"/>
        <purl:Definition>a musculoskeletal system AE that results in the absence or loss of control of voluntary muscle movements.</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>URL: http://medical-dictionary.thefreedictionary.com/akinesia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">akinesia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001541</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002552">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>a seizure AE that shows a brief episode of signs and/or symptoms due to abnormal excessive or synchronous neuronal activity in the brain.</purl:Definition>
        <obo1:IAO_0000117>JX, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>epilepsy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Epileptic_seizure</obo1:IAO_0000119>
        <obo1:OAE_0001849>癫痫</obo1:OAE_0001849>
        <rdfs:label xml:lang="en">epileptic seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002553 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002553">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <purl:Definition>a peripheral neuropathy AE which shows an damage or abnormality to the nerves in the eyes.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.allaboutvision.com/conditions/optic-neuritis.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">optic neuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10061323</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002554">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002553"/>
        <purl:Definition>an optic neuropathy AE characterized by optic disc swelling, peripapillary and macular hard exudates, and vitreous cells.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/6466175</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">neuroretinitis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10060701</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002555 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002056"/>
        <purl:Definition>an optic neuropathy AE characterized by vision loss, optic disc swelling, flame hemorrhages, and cotton-wool exudates. It occurs when blood flow is interrupted to the front (anterior) part of the optic nerve (also called optic nerve head).</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>AION</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/1216891-overview</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.geteyesmart.org/eyesmart/diseases/ischemic-optic-neuropathy/</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">anterior ischemic optic neuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10068250</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002555"/>
        <purl:Definition>a type of anterior ischemic optic neuropathy AE that presents primarily with vision loss, especially upon wakening, and sectorial disc edema.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/1216891-clinical#a0217</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">non-arteritic anterior ischemic optic neuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10068249</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <purl:Definition>a peripheral neuropathy AE that shows a combination of axonal and demyelinating neuropathy.</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.aafp.org/afp/2010/0401/p887.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">mixed neuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002558 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002558">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001288"/>
        <purl:Definition>a peripheral sensory neuropathy AE that shows neuropathy in many sensory nerves at one time</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.merckmanuals.com/home/brain_spinal_cord_and_nerve_disorders/peripheral_nerve_disorders/polyneuropathy.html</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">sensory peripheral polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002559">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000337"/>
        <purl:Definition>a peripheral neuropathy AE that results from the loss of the myelin sheath on peripheral nerves roughly evenly distributed on both sides of the body</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">peripheral demyelinating polyneuropathy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002560 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002560">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000418"/>
        <purl:Definition>a neuropathy AE that shows nerve damage and occurs in a patient with diabetes</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/diabetic-neuropathy/basics/definition/con-20033336</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">diabetic neuropathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10012680</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002561 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002561">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE that is an umbrella term referring to conditions relating to the nervous system, including loss of sensation and paralysis</purl:Definition>
        <obo1:IAO_0000117>RR, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Functional_neurological_deficit</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">neurological deficit AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000469"/>
        <purl:Definition>An abscess AE that is caused by an Staphylococcus aureus infection.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>abscess</obo1:IAO_0000118>
        <obo1:IAO_0000119>http://medical-dictionary.thefreedictionary.com/staphylococcal+abscess</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">staphylococcal abscess AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10041917</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002563 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002563">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>An eye AE that results in an intermittent or constant misalignment of an eye so that its line of vision is not pointed at the same object. Strabismus is caused by an imbalance in the extraocular muscles which control the positioning of the eyes.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>cross-eyed</obo1:IAO_0000118>
        <obo1:IAO_0000118>heterotropia</obo1:IAO_0000118>
        <obo1:IAO_0000118>wall-eyed</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Strabismus</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">strabismus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10042159</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002564 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001502"/>
        <purl:Definition>A vein discoloration AE that has an outcome of local dilatation of small vessels resulting in red discoloration of the skin or mucous membranes.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>http://en.wikipedia.org/wiki/Telangiectasia</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">telangiectasia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10043189</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C28194</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002565 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002565">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000521"/>
        <purl:Definition>A muscle spasm AE that results in the lack of ability to open the mouth fully due to decreased range of motion of the muscles of mastication.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/script/main/art.asp?articlekey=40739</obo1:IAO_0000119>
        <rdfs:comment>Trismus is a symptom of tetanus.</rdfs:comment>
        <rdfs:label xml:lang="en">trismus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA：10044684</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C78651</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002566 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002566">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000488"/>
        <purl:Definition>A bacterial infection AE with an outcome of thypoid fever, a bacterial infectious disorder caused by the Salmonella typhi bacteria.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>tyhpoid</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/a-to-z-guides/typhoid-fever</obo1:IAO_0000119>
        <rdfs:comment>Typhoid fever is often contracted by consumption of food or drink contaminated with Salmonella typhi.</rdfs:comment>
        <rdfs:label xml:lang="en">typhoid fever AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10045275</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C35089</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000622"/>
        <purl:Definition xml:lang="en">a urinary system AE that results in the inflammation (swelling and irritation) of the urethra.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/000439.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">urethritis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10046480</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002568 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002568">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000423"/>
        <purl:Definition xml:lang="en">a skin discoloration AE which shows a chronic skin disease characterized by portions of the skin losing their pigment.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Vitiligo</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">vitiligo AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10047642</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C26915</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000041"/>
        <purl:Definition>an injury AE that displays a type of injury to flesh or skin caused by heat, electricity, chemicals, friction, or radiation.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Burn</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">burn AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE which has a decreased erythrocyte sedimentation rate (ESR). EST is the rate at which red blood cells sediment in a period of one hour.</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>ESR</obo1:IAO_0000118>
        <obo1:IAO_0000118>erythrocyte sedimentation rate</obo1:IAO_0000118>
        <obo1:IAO_0000118>red blood cell sedimentation rate decreased AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>Westergren ESR decreased AE</obo1:IAO_0000119>
        <obo1:IAO_0000119>http://en.wikipedia.org/wiki/Erythrocyte_sedimentation_rate</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">sedimentation rate decreased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA:10049188</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin AE that has decreased skin turgor which is the skin&apos;s ability to change shape and return to normal (elasticity).</purl:Definition>
        <obo1:IAO_0000117>KM, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003281.htm</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">skin turgor decreased AE</rdfs:label>
