    <!-- http://purl.obolibrary.org/obo/DDO_0009420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DDO_0009420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/DDO_0009418"/>
