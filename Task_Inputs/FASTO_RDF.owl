        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Apparent hypotensive reaction AE is a hypotension AE that shows apparent sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>显著的低血压反应</obo1:OAE_0001849>
