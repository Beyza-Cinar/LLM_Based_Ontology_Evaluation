                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/date"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">goal</rdfs:label>
    </owl:Class>
    


