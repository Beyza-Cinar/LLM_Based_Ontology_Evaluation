    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002344">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000202"/>
        <purl:Definition>an endocrine system AE that results in a life threatening condition due to a lack of cortisol produced by the adrenal glands</purl:Definition>
