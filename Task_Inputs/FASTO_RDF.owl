    <!-- https://bioportal.bioontology.org/ontologies/fhir.owl#hasNodeID -->

    <owl:DatatypeProperty rdf:about="https://bioportal.bioontology.org/ontologies/fhir.owl#hasNodeID">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/sensorRelatedProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
