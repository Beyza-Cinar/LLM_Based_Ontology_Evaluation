        <rdfs:seeAlso>MedDRA: 10061255</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0022116</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000199">
        <owl:equivalentClass>
            <owl:Class>
