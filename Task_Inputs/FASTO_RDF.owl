        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000012"/>
        <rdfs:label xml:lang="en">alpha glucosidase inhibitor</rdfs:label>
        <skos:note>Slow the absorption of carbohydrates (sugar) ingested</skos:note>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000917 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000917">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000012"/>
        <rdfs:label xml:lang="en">sulfonylurea</rdfs:label>
        <skos:note>Stimulate the pancreas to produce more insulin</skos:note>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000918 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000918">
        <rdfs:subClassOf rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000012"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#drugContradictDithDisease"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0001855"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0002326"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0003243"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0003408"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/DDO.owl#DDO_0009124"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">thiazolidinedione</rdfs:label>
        <skos:note>Increase insulin sensitivity of the body cells and reduce the production of glucose by the liver</skos:note>
    </owl:Class>
    


