        <rdfs:seeAlso>MedDRA ID: 10049460</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0877217</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000296 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000402"/>
        <purl:Definition>an abdominal pain AE that is observed in upper stomach</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <rdfs:label>abdominal pain upper AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002027</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10000087</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0232492</rdfs:seeAlso>
