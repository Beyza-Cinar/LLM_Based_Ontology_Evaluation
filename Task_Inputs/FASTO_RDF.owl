        <purl:Definition>a KIV-induced adverse event that has an outcome of Afluria-induced adverse event</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>Afluria-induced adverse event</rdfs:label>
    </owl:Class>
    


