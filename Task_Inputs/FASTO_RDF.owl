    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
