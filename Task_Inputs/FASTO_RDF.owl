                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/frequency"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/latency"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/measurmentRange"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/precision"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/resolution"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/responseTime"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/selectivity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/sensitivity"/>
                </owl:unionOf>
            </owl:Class>
        </owl:disjointWith>
    </owl:Class>
    


