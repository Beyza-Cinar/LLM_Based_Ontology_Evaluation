    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001222"/>
        <purl:Definition>Neutrophilopenia AE is a neutrophil count decreased AE that shows the number of neutrophil is decreased.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>中性白细胞减少</obo1:OAE_0001849>
        <rdfs:label>neutrophilopenia AE</rdfs:label>
    </owl:Class>
    


