    <!-- http://purl.obolibrary.org/obo/OAE_0000263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000651"/>
