    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001643"/>
        <purl:Definition>a neurological, special senses and psychiatric investigation result abnormal AE that is the abnormal result of the recording of the level of consciousness in a person after a brain injuiry. </purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.brainline.org/content/2010/10/what-is-the-glasgow-coma-scale.html</obo1:IAO_0000119>
        <rdfs:comment>Clinicians use the Galscow coma scale to rate the best eye opening response, the best verbal response, and the best motor response an individual makes. The final GCS score or grade is the sum of these numbers.</rdfs:comment>
        <rdfs:label xml:lang="en">Glascow coma scale abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10069709</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001059 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of an abnormal concentration of magnesium in the blood plasma, and may cause nausea, weakness and tremors.</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypomagnesaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/Hypomagnesaemia</obo1:IAO_0000119>
        <rdfs:label>hypomagnesemia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002917</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10021027</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151723</rdfs:seeAlso>
    </owl:Class>
    


