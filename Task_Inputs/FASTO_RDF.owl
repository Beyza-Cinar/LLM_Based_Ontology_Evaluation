        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>Temporarily lose consciousness AE is a sensory capability AE that shows temporarily lose consciousness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>暂时失去知觉</obo1:OAE_0001849>
