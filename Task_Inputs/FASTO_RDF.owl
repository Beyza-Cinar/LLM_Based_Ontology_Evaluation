        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000363"/>
        <purl:Definition>an infection AE that occurs at the site of drug application</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <rdfs:label>application site infection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049041</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
