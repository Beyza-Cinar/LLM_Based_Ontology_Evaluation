        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/fhir.owl#wearableSensorPlatform -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/fhir.owl#wearableSensorPlatform">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/ssn/platform"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://bioportal.bioontology.org/ontologies/fhir.owl#placedOn"/>
                <owl:allValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/fhir.owl#humanBodyPart"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://bioportal.bioontology.org/ontologies/fhir.owl#wearableSystem -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/fhir.owl#wearableSystem">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/ssn/system"/>
    </owl:Class>
    


