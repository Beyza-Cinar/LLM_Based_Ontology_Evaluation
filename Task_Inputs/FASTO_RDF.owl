        <purl:Definition>an electrolyte lab test abnormal AE that is characterized by an abnormally high level of phosphate in the blood</purl:Definition>
        <obo1:IAO_0000117>EB</obo1:IAO_0000117>
        <rdfs:label xml:lang="en">blood phosphorus increased AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002905</rdfs:seeAlso>
