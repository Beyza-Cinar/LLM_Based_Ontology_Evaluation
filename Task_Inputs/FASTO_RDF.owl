        <rdfs:seeAlso>MedDRA: 10050637</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
