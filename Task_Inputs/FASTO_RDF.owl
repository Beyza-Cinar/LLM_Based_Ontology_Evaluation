    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000047"/>
        <purl:Definition>Warm and hot feeling in the neck AE is a skini warm AE that shows warm and hot feeling in the neck.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>颈感觉温热</obo1:OAE_0001849>
        <rdfs:label>warm and hot feeling in the neck AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000047"/>
        <purl:Definition>Facial warm feeling AE is a skin warm AE that shows a warm feeling in the face.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>面部感觉温热</obo1:OAE_0001849>
        <rdfs:label>facial warm feeling AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000085"/>
        <purl:Definition>Increased peripheral vascular resistance AE is a vascular disorder AE that shows increased peripheral vascular resistance, the degree to which the blood vessels impede the flow of blood. High resistance causes an increase in blood pressure, which increases the workload of the heart.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>外周血管阻力升高</obo1:OAE_0001849>
        <rdfs:label>increased peripheral vascular resistance AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000198"/>
        <purl:Definition>Venous ischemia AE is an ischaemia AE that shows  in insufficient blood supply in the vein.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>静脉供血不足</obo1:OAE_0001849>
        <rdfs:label>venous ischemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002197 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001607"/>
        <purl:Definition>Increased blood creatine AE is a metabolic and nutritional investigation result abnormal AE that shows an increased creatine level in blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血肌酸增加</obo1:OAE_0001849>
        <rdfs:label>increased blood creatine AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002198 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000628"/>
        <purl:Definition>Increased nonprotein nitrogen AE is an investigation result abnormal AE that shows increased nonprotein nitrogen, the nitrogenous constituents of the blood exclusive of the protein bodies, consisting of the nitrogen of urea, uric acid, creatine, creatinine, amino acids, polypeptides, and an undetermined part known as rest nitrogen.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>非蛋白氮增加</obo1:OAE_0001849>
        <rdfs:label>increased nonprotein nitrogen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002199 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000532"/>
        <purl:Definition>Soft feces AE is a abnormal stool AE that shows soft and shapeless of the feces.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>软便</obo1:OAE_0001849>
        <rdfs:label>soft feces AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001463"/>
        <purl:Definition>Increased hepatic function AE is a hepatic function abnormal AE that shows the values of liver function tests (LFTs) high than the normal.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.webmd.com/a-to-z-guides/liver-function-test-lft</obo1:IAO_0000119>
        <obo1:OAE_0001849>肝功能升高</obo1:OAE_0001849>
        <rdfs:label>increased hepatic function AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Knee pain AE is a pain AE that shows discomfort in the structures of both knees. Keen pain may be due to injury, inflammation or infection.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/diseases-conditions/knee-pain/basics/definition/CON-20029534</obo1:IAO_0000119>
        <obo1:OAE_0001849>膝痛</obo1:OAE_0001849>
        <rdfs:label>knee pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023477</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002202 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001130"/>
        <purl:Definition>Loss of libido AE is a libido disorder AE that shows loss of the desire for sexual interaction.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hypoactive_sexual_desire_disorder</obo1:IAO_0000119>
        <obo1:OAE_0001849>性欲丧失</obo1:OAE_0001849>
        <rdfs:label>loss of libido AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10024870</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002203 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>Over sedation AE is a behavior and neurological AE that shows the over reduction of irritability or agitation.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>过度镇静</obo1:OAE_0001849>
        <rdfs:label>over sedation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000166"/>
        <purl:Definition>Finger tremor AE is a tremor AE that shows involuntary muscle contraction and relaxation in the finger.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>手指强硬颤动</obo1:OAE_0001849>
        <rdfs:label>finger tremor AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002205 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001192"/>
        <purl:Definition>Leg cramp AE is a muscle cramp AE that shows tightening, or spasms, of the muscles in the legs.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>腿部痉挛</obo1:OAE_0001849>
        <rdfs:label>leg cramp AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of insomnia</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Insomnia is a symptom of a sleeping disorder characterized by persistent difficulty falling asleep or staying asleep despite the opportunity. Insomnia is a symptom, not a stand-alone diagnosis or a disease.</rdfs:comment>
        <rdfs:label>insomnia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002360</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0917801</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002207 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002207">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002206"/>
        <purl:Definition>Terminal insomnia AE is a insomnia AE that is a medical condition affecting sleep patterns. Typically, people who suffer from terminal insomnia wake up after only four to five hours of sleep. For those afflicted, getting back to sleep can be difficult, resulting in fatigue, irritability, and lack of concentration.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>matutinal insomnia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.wisegeek.com/what-is-terminal-insomnia.htm</obo1:IAO_0000119>
        <obo1:IAO_0000119>早醒</obo1:IAO_0000119>
        <rdfs:label>terminal insomnia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10068932</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <purl:Definition>Bone marrow granuloma AE is a bone marrow disorder AE that shows an organized collection of macrophages in the bone marrow.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>骨髓肉芽肿</obo1:OAE_0001849>
        <rdfs:label>bone marrow granuloma AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10066816</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002209 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000537"/>
        <purl:Definition>Cholestatic liver injury AE is a liver damage AE that shows buildup of bile acids in hepatocytes, then causes hepatocellular injury.</purl:Definition>
        <obo1:IAO_0000117>JX, LW ,YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>胆汁郁积性肝损伤</obo1:OAE_0001849>
        <rdfs:label>cholestatic liver injury AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10067969</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002210 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002210">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000084"/>
        <purl:Definition>Distant heart sounds AE is a cardiac disorder AE that shows distant heart sounds.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>心音遥远</obo1:OAE_0001849>
        <rdfs:label>distant heart sounds AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002211 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002211">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Pink skin AE is a skin AE that shows pink skin.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>皮肤粉红</obo1:OAE_0001849>
        <rdfs:label>pink skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002212 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Acute laryngeal edema AE is an edema AE that shows acute laryngeal edema, abnormal accumulation of fluid in tissues of any part of the larynx, commonly associated with laryngeal injuries and allergic reactions.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>急性喉头水肿</obo1:OAE_0001849>
        <rdfs:label>acute laryngeal edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10066705</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002213 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000753"/>
        <purl:Definition>Hypoplastic bone marrow AE is a bone marrow disorder AE that shows insufficient blood stem cells in the marrow.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>骨髓发育不全</obo1:OAE_0001849>
        <rdfs:label>hypoplastic bone marrow AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002214 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>Bleeding and coagulation disorders AE is a hematopoietic system AE that shows bleeding and coagulation disorders.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>出凝血功能障碍</obo1:OAE_0001849>
        <rdfs:label>bleeding and coagulation disorders AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <purl:Definition>Polymorphic ventricular tachycardia AE is a ventricular tachycardia AE that is an abnormally fast heart rhythm starting in the ventricles, the lower chambers of the heart.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthguideinfo.com/arrhythmias-heart-palpitations/p110132/</obo1:IAO_0000119>
        <obo1:OAE_0001849>多行性室性心动过速</obo1:OAE_0001849>
        <rdfs:label>polymorphic ventricular tachycardia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10036095</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002216 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <purl:Definition>Monomorphic ventricular tachycardia AE is a ventricular tachycardia AE that is a type of tachycardia which has  a uniform beat-to-beat QRS morphology.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>单行性室性心动过速</obo1:OAE_0001849>
        <rdfs:label>monomorphic ventricular tachycardia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10058185</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>Respiratory tract symptoms AE is a respiratory system AE that is a series of discomforts which occurs in respiratory tract.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>呼吸道症状</obo1:OAE_0001849>
        <rdfs:label>respiratory tract symptoms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002218 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Clammy skin AE is a skin AE that occurs when the skin turns cooler than normal and is moist, despite a cooler surface temperature. Clammy skin is often pale.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthgrades.com/symptoms/clammy-skin</obo1:IAO_0000119>
        <obo1:OAE_0001849>皮肤湿冷</obo1:OAE_0001849>
        <rdfs:label>clammy skin AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <purl:Definition>Abnormal visual accommodation AE is an abnormal vision AE that shows abnormal visual accommodation. Accommodation is the process by which the vertebrate eye changes optical power to maintain a clear image or focus on an object as its distance varies.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Accommodation_%28eye%29</obo1:IAO_0000119>
        <obo1:OAE_0001849>视调节异常</obo1:OAE_0001849>
        <rdfs:label>abnormal visual accommodation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000568"/>
        <purl:Definition>an allergy AE that shows swelling and irritation of the skin, caused by an allergy to a substance in the environment.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>皮肤过敏</obo1:OAE_0001849>
        <rdfs:label>skin allergy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002221 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002221">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000685"/>
        <purl:Definition>Heaviness of the head AE is a sensation of heaviness AE that shows a sensation feeling of heaviness in the head.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>头重感</obo1:OAE_0001849>
        <rdfs:label>heaviness of the head AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10049121</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001602"/>
        <purl:Definition>Rheumatoid factor positive AE is an immunology and allergy investigation result abnormal AE that shows positive of the rheumatoid factor. Rheumatoid factor is a blood test that measures the amount of the RF antibody in the blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/ency/article/003548.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>类风湿因子阳性</obo1:OAE_0001849>
        <rdfs:label>rheumatoid factor positive AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10039080</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Retinal detachment AE is an eye AE that  is a separation of the retina from its attachments to the underlying tissue within the eye.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.medicinenet.com/retinal_detachment/article.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>视网膜脱离</obo1:OAE_0001849>
        <rdfs:label>retinal detachment AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10038848</rdfs:seeAlso>
        <rdfs:seeAlso>NCIT: C26874</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002224 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>Arm pain AE is a pain AE that shows discomfort in the structures of the arm. It can be caused by a wide variety of problems, ranging from joint injuries to compressed nerves.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.mayoclinic.org/symptoms/arm-pain/basics/definition/SYM-20050870</obo1:IAO_0000119>
        <obo1:OAE_0001849>手臂疼痛</obo1:OAE_0001849>
        <rdfs:label>arm pain AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000392"/>
        <purl:Definition>Peripheric paresthesia AE is a paresthesia AE that shows paresthesia in the peripheric area.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>外周感觉异常</obo1:OAE_0001849>
        <rdfs:label>peripheric paresthesia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002226 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002226">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Edema of glottis AE is an edema AE that is a swelling caused by fluid accumulation in the soft tissues of the larynx. The condition, usually inflammatory, may result from an infection, injury, allergy, or inhalation of toxic substances.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>声门肿胀</obo1:OAE_0001849>
        <rdfs:label>edema of glottis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002227 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002227">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000910"/>
        <purl:Definition>Prolonged qrs complex AE is a electrocardiogram qrs complex abnormal AE that shows qrs complex prolonged. The QRS complex is a name for the combination of three of the graphical deflections seen on a typical electrocardiogram.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>QRS时间延长</obo1:OAE_0001849>
        <rdfs:label>prolonged qrs complex AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001664"/>
        <purl:Definition>Prolonged bleeding time AE is a hematology investigation result abnormal AE that shows prolonged time for small blood vessels in the skin close to stop from bleeding.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>出血时间延长</obo1:OAE_0001849>
        <rdfs:label>prolonged bleeding time AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Acute generalized exanthematous pustulosis AE is a skin AE that is a not uncommon cutaneous reaction pattern that in 90% of cases is related to medication administration, characterized by a sudden eruption that appears on average five days after the medication is started.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>pustular drug eruption AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>toxic pustuloderma AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Acute_generalized_exanthematous_pustulosis</obo1:IAO_0000119>
        <obo1:OAE_0001849>急性全身性浓疱病</obo1:OAE_0001849>
        <rdfs:label>acute generalized exanthematous pustulosis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10062372</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Upper and lower limbs flare AE is an edema AE that shows edema in the upper and lower limbs, which is an accumulation of an excessive amount of watery fluid in cells or intercellular tissues.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>上下肢红肿</obo1:OAE_0001849>
        <rdfs:label>upper and lower limbs flare AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001612"/>
        <purl:Definition>Abnormal blood sugar with empty stomach AE is a blood glucose level abnormal AE that shows abnormal blood glucose level with empty stomach.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>空腹时血糖异常</obo1:OAE_0001849>
        <rdfs:label>abnormal blood sugar with empty stomach AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000733"/>
        <purl:Definition>Increased blood sugar with empty stomach AE is blood glucose level decreased AE that shows an increased glucose level in blood with empty stomach.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>空腹时血糖升高</obo1:OAE_0001849>
        <rdfs:label>increased blood sugar with empty stomach AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <purl:Definition>Hydrochloric acid in gastric juice secretion increased AE is a gastric disorder AE that shows increased gastric acid.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>胃酸分泌增多</obo1:OAE_0001849>
        <rdfs:label>hydrochloric acid in gastric juice secretion increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001943"/>
        <purl:Definition>Torsades de pointes AE is a ventricular tachycardia AE that is a polymorphic ventricular tachycardia that exhibits distinct characteristics on the electrocardiogram.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Torsades_de_pointes</obo1:IAO_0000119>
        <obo1:OAE_0001849>扭转性室速</obo1:OAE_0001849>
        <rdfs:label>torsades de pointes AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10044067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000405"/>
        <purl:Definition>Proximal myasthenia AE is a myasthenia AE that shows proximal myasthenia. Myasthenia represents myasthenia gravis, a neuromuscular disease leading to fluctuating muscle weakness and fatigability.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>近端肌无力</obo1:OAE_0001849>
        <rdfs:label>proximal myasthenia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000698"/>
        <purl:Definition>Dilated skin vessels AE is a vasodilatation AE that shows vasodilatation in the skin, which refers to the widening of blood vessels resulting from relaxation of smooth muscle cells within the vessel walls, particularly in the large arteries, smaller arterioles and large veins.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>皮肤血管扩张</obo1:OAE_0001849>
        <rdfs:label>dilated skin vessels AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001852"/>
        <purl:Definition>Numbness of oral mucosa AE is a numbness AE that shows an abnormal feeling or loss of sensation in the oral mucosa.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>口腔黏膜发麻</obo1:OAE_0001849>
        <rdfs:label>numbness of oral mucosa AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <purl:Definition>Orthostatic dizziness AE is a dizziness AE that shows dizziness provocation by sudden postural change.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>体位性头晕</obo1:OAE_0001849>
        <rdfs:label>orthostatic dizziness AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10031125</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Acid reflux AE is a digestive system AE that shows the acid and pepsin secreted in the stomach back up in to the esophagus.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>反酸</obo1:OAE_0001849>
        <rdfs:label>acid reflux AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10066872</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000698"/>
        <purl:Definition>Jugular phlebectasia AE is a vasodilatation AE that is an isolated saccular or fusiform dilation of a vein without tortuosity.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3708235/</obo1:IAO_0000119>
        <obo1:OAE_0001849>颈静脉扩张</obo1:OAE_0001849>
        <rdfs:label>jugular phlebectasia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>Laryngeal edema AE is an edema AE that shows abnormal accumulation of fluid in tissues of any part of the larynx, commonly associated with laryngeal injuries and allergic reactions.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>喉肿胀</obo1:OAE_0001849>
        <rdfs:label>laryngeal edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10023838</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000439"/>
        <purl:Definition>Flatus AE is a digestive system AE that shows gas or air expelled through the anus.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>排气</obo1:OAE_0001849>
        <rdfs:label>flatus AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016769</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002215"/>
        <purl:Definition>Continuous polymorphic ventricular tachycardia AE is a polymorphic ventricular tachycardia AE that shows polymorphic ventricular tachycardia is constantly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>连续性多形性室性心动过速</obo1:OAE_0001849>
        <rdfs:label>continuous polymorphic ventricular tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002215"/>
        <purl:Definition>Continuous polymorphic ventricular tachycardia AE is a polymorphic ventricular tachycardia AE that shows polymorphic ventricular tachycardia is intermittent.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>间歇性多形性室性心动过速</obo1:OAE_0001849>
        <rdfs:label>intermittent polymorphic ventricular tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000211"/>
        <purl:Definition>Aggravated ulcer AE is a ulcer AE that shows aggravated ulcer.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>溃疡加重</obo1:OAE_0001849>
        <rdfs:label>aggravated ulcer AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000779"/>
        <purl:Definition>Heart failure increased AE is a cardiovascular disorder AE that shows aggravated heart failure.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>心脏衰竭加重</obo1:OAE_0001849>
        <rdfs:label>heart failure increased AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000280"/>
        <purl:Definition>Aggravated angina symptoms AE is a angina pectoris AE that shows  aggravated angina symptoms.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>心绞痛症状加剧</obo1:OAE_0001849>
        <rdfs:label>aggravated angina symptoms AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001366"/>
        <purl:Definition>Aggravated renal injury AE is a renal impairment AE that shows aggravated renal injury.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>肾损害加剧</obo1:OAE_0001849>
        <rdfs:label>aggravated renal injury AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <purl:Definition>Aggravated fatigue AE is a fatigue AE that shows aggravated fatigue.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>脱力感加重</obo1:OAE_0001849>
        <rdfs:label>aggravated fatigue AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <purl:Definition>Persistent nausea AE is a nausea AE that shows constant nausea. Nausea is considered &quot;persistent&quot; if it continues for more than 2 days, or keeps recurring even after treatment.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.all4naturalhealth.com/persistent-nausea.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>持续恶心</obo1:OAE_0001849>
        <rdfs:label>persistent nausea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002007"/>
        <purl:Definition>Aggravated Raynaud&apos;s syndrome AE is a Raynaud&apos;s syndrome AE that shows aggravated Raynaud&apos;s syndrome.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>Raynaud综合征加重</obo1:OAE_0001849>
        <rdfs:label>aggravated Raynaud&apos;s syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001845"/>
        <purl:Definition>Increased gastric acid secretion with high dose AE is a gastric disorder AE that shows  increased gastric acid secretion with high dose.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>高剂量时胃酸分泌增加</obo1:OAE_0001849>
        <rdfs:label>increased gastric acid secretion with high dose AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000601"/>
        <purl:Definition>Persistent vomiting AE is a vomiting AE that occurs frequently throughout the day and is often triggered by even small meals.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.healthhype.com/persistent-and-recurrent-vomiting-emesis-in-adults-and-children.html</obo1:IAO_0000119>
        <obo1:OAE_0001849>持续呕吐</obo1:OAE_0001849>
        <rdfs:label>persistent vomiting AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10034716</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000465"/>
        <purl:Definition>Hypoacusis AE is a ear AE that shows partial or complete loss of the ability to detect or understand sounds resulting from damage to the outer, middle, or inner ear structures. Causes include exposure to loud noise, ear infections, injuries to the ear, genetic, and congenital disorders.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypoacusis</obo1:IAO_0000119>
        <obo1:OAE_0001849>突发听力减退</obo1:OAE_0001849>
        <rdfs:label>hypoacusis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10048865</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <purl:Definition>Lip cyanosis AE is a cyanosis AE that is a condition in which the lips have a bluish discoloration due to a lack of oxygen in the tissues.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/sym/lip_cyanosis.htm</obo1:IAO_0000119>
        <obo1:OAE_0001849>嘴唇发紫</obo1:OAE_0001849>
        <rdfs:label>lip cyanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000549"/>
        <purl:Definition>Nail cyanosis AE is a cyanosis AE that shows a dark bluish or purple nail resulting from deficient oxygenation of the blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>指甲青紫</obo1:OAE_0001849>
        <rdfs:label>nail cyanosis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002257 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002257">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>Renal dysfunction AE is a kidney AE that has an outcome of reduced capacity to excrete metabolic products which accumulate systemically and are detectable clinicopathologically by renal function tests. The early stage of uremia.</purl:Definition>
        <obo1:IAO_0000116>This term appears to be a synonym to the &apos;renal failure AE&apos;.</obo1:IAO_0000116>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hepatic and renal function disorder AE</obo1:IAO_0000118>
        <obo1:OAE_0001849>肾功能障碍</obo1:OAE_0001849>
        <rdfs:label>renal insufficiency AE</rdfs:label>
        <rdfs:seeAlso>UMLS ID: C0859242</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002258 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002258">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Hemolysis AE is a hematopoietic system AE that is the rupturing of erythrocytes (red blood cells) and the release of their contents (cytoplasm) into surrounding fluid.</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Hemolysis</obo1:IAO_0000119>
        <obo1:OAE_0001849>溶血</obo1:OAE_0001849>
        <rdfs:label>hemolysis AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10019491</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <purl:Definition>Lip angioedema AE is a angioedema AE that shows lip angioedema, which is the rapid swelling (edema) of the dermis, subcutaneous tissue, mucosa and submucosal tissues.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>唇血管神经性水肿</obo1:OAE_0001849>
        <rdfs:label>lip angioedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000474"/>
        <purl:Definition>Tongue angioedema AE is a angioedema AE that shows tongue angioedema, which is the rapid swelling (edema) of the dermis, subcutaneous tissue, mucosa and submucosal tissues.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>舌血管神经性水肿</obo1:OAE_0001849>
        <rdfs:label>tongue angioedema AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002261 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002261">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>Acousma AE is a sensory capability AE that shows a hallucinatory impression of strange sounds.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>幻听</obo1:OAE_0001849>
        <rdfs:label>acousma AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002262 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002262">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000443"/>
        <purl:Definition>Eye burning AE is a eye AE that shows a feeling of burning in the eye.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>眼睛灼烧感</obo1:OAE_0001849>
        <rdfs:label>eye burning AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000328"/>
        <purl:Definition>Worsening renal function AE is a kidney AE that shows worsening renal function.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>肾功能恶化</obo1:OAE_0001849>
        <rdfs:label>worsening renal function AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002264 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002264">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002181"/>
        <purl:Definition>Mild change of hematology AE is a change of hematology AE that shows mild change of hematology.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>轻度的血液学改变</obo1:OAE_0001849>
        <rdfs:label>mild change of hematology AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002181"/>
        <purl:Definition>Moderate change of hematology AE is a change of hematology AE that shows moderate change of hematology.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>中度的血液学改变</obo1:OAE_0001849>
        <rdfs:label>moderate change of hematology AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002266 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Severe lower blood pressure AE is a hypotension AE that shows severe sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>significantly decreased blood pressure AE</obo1:IAO_0000118>
        <obo1:OAE_0001849>严重的血压降低</obo1:OAE_0001849>
        <rdfs:label>severe lower blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001467"/>
        <purl:Definition>Elevated blood transaminase reversibility AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase reversibly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血氨基转移酶可逆性升高</obo1:OAE_0001849>
        <rdfs:label>elevated blood transaminase reversibility AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000455"/>
        <purl:Definition>Mild gastrointestinal tract reaction AE is a gastrointestinal disorder AE that shows a mild gastrointestinal disorder.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>轻度胃肠道反应</obo1:OAE_0001849>
        <rdfs:label>mild gastrointestinal tract reaction AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000243"/>
        <purl:Definition>Temporary abdominal distention AE is a abdominal distension AE that shows a temporary sensation of elevated abdominal pressure and volume.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>暂时性腹胀</obo1:OAE_0001849>
        <rdfs:label>temporary abdominal distention AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002270 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <purl:Definition>Transient nausea AE is a nausea AE that is a gastric discomfort associated with the inclination to vomit.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>暂时性恶心</obo1:OAE_0001849>
        <rdfs:label>transient nausea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000355"/>
        <purl:Definition>Persistent tachycardia AE is a tachycardia AE that is an increased heart rate that exceeds the normal range for a resting heartrate (heartrate in an inactive or sleeping individual). It&apos;s a constant process.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>持续心动过速</obo1:OAE_0001849>
        <rdfs:label>persistent tachycardia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <purl:Definition>Mild headache AE is a headache AE that shows mild headache.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>轻度头痛</obo1:OAE_0001849>
        <rdfs:label>mild headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000617"/>
        <purl:Definition>Transient hypoxemia AE is a hypoxia AE that is a reduced concentration of O2 in the blood, alveoli or other tissues resulting in the decreased pressure of this component of body gases.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬态低氧血症</obo1:OAE_0001849>
        <rdfs:label>transient hypoxemia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0002024"/>
        <purl:Definition>Transient neuroticism AE is a neuroticism AE that is a type of personality trait that contrasts adjustment or emotional stability with maladjustment. Experience of anxiety, anger, disgust, sadness, embarrassment, and a variety of other negative emotions.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬态神经质</obo1:OAE_0001849>
        <rdfs:label>transient neuroticism AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002275 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001105"/>
        <purl:Definition>Constant irritability AE is a irritability AE that shows in the patient being easily annoyed/irritated constantly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>持续烦躁</obo1:OAE_0001849>
        <rdfs:label>constant irritability AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002276 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000382"/>
        <purl:Definition>Abnormal atony AE is a asthenia AE that is a medical term denoting symptoms of physical weakness and loss of strength.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>异常无力</obo1:OAE_0001849>
        <rdfs:label>abnormal atony AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Secondary hypotension AE is a hypotension AE that is a type of hypertension which by definition is caused by an identifiable underlying secondary cause.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Secondary_hypertension</obo1:IAO_0000119>
        <obo1:OAE_0001849>继发性高血压</obo1:OAE_0001849>
        <rdfs:label>secondary hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002278 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001467"/>
        <purl:Definition>Transient elevated serum transaminase AE is a transaminase level increased AE that shows elevated levels of alanine transaminase and aspartate transaminase transiently.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬时血清转氨酶升高</obo1:OAE_0001849>
        <rdfs:label>transient elevated serum transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002279 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000747"/>
        <purl:Definition>Transient elevated blood urea nitrogen AE is a blood urea level increased AE that shows a transient increase in amount of urea in blood.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬时血尿素氮升高</obo1:OAE_0001849>
        <rdfs:label>transient elevated blood urea nitrogen AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000529"/>
        <purl:Definition>Apparent increased blood creatine phosphokinase AE is a blood creatine phosphokinase level increased AE that is characterized by an apparent increased level of creatine phosphokinase or phosphocreatine kinase.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>明显的血肌酸磷酸激酶增高</obo1:OAE_0001849>
        <rdfs:label>apparent increased blood creatine phosphokinase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002281 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002281">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001378"/>
        <purl:Definition>Severe rhabdomyolysis AE is a rhabdomyolysis AE that shows in severe damaged skeletal muscle tissue breaks down rapidly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>严重的横纹肌溶解症</obo1:OAE_0001849>
        <rdfs:label>severe rhabdomyolysis AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002282 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002282">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000416"/>
        <purl:Definition>Mild gastrointestinal bleeding AE is a gastrointestinal hemorrhage AE that shows mild gastrointestinal hemorrhage.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>胃肠道轻微出血</obo1:OAE_0001849>
        <rdfs:label>mild gastrointestinal bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002283 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002283">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000416"/>
        <purl:Definition>Occult gastrointestinal tract bleeding AE is a gastrointestinal hemorrhage AE that shows occult gastrointestinal hemorrhage.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>胃肠道隐匿性出血</obo1:OAE_0001849>
        <rdfs:label>occult gastrointestinal tract bleeding AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000377"/>
        <purl:Definition>Nitrate headache AE is a headache AE that that is a special headache induced by nitrate.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>硝酸盐性头痛</obo1:OAE_0001849>
        <rdfs:label>nitrate headache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002285 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002285">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>Pantomorphia erythema exudativum AE is a skin AE that  is a skin condition of unknown cause, possibly mediated by deposition of immune complex (mostly IgM) in the superficial microvasculature of the skin and oral mucous membrane that usually follows an infection or drug exposure. It is an uncommon disorder, with peak incidence in the second and third decades of life.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Erythema_multiforme</obo1:IAO_0000119>
        <obo1:OAE_0001849>多形性渗出性红斑</obo1:OAE_0001849>
        <rdfs:label>pantomorphia erythema exudativum AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002286 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002286">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000034"/>
        <purl:Definition>High hypodynamia AE is a fatigue AE that is a state of awareness describing a range of afflictions, usually associated with physical and/or mental weakness, though varying from a general state of lethargy to a specific work-induced burning sensation within one&apos;s muscles. Physical fatigue is the inability to continue functioning at the level of one&apos;s normal abilities.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>高度乏力</obo1:OAE_0001849>
        <rdfs:label>high hypodynamia AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000600"/>
        <purl:Definition>Short-time nausea AE is a nausea AE that shows a gastric discomfort associated with the inclination to vomit.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>短暂的恶心</obo1:OAE_0001849>
        <rdfs:label>short-time nausea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002288 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002288">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000656"/>
        <purl:Definition>Slightly increased aspartic transaminase AE is a aspartate aminotransferase level increased AE that shows a slightly increased amount of AST which is an enzyme normally present in body tissues especially of the heart and liver,</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>门冬氨酸氨基转移酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased aspartic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002289 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002289">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000272"/>
        <purl:Definition>Slightly increased alanine aminotransferase AE is a alanine aminotransferase level increased AE that shows elevated levels of alanine transaminase slightly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>丙氨酸氨基转移酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased alanine aminotransferase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002290 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000737"/>
        <purl:Definition>Slightly increased lactic dehydrogenase AE is a blood lactate dehydrogenase level increased AE that shows a slightly increased amount of LDH which is an enzyme that could indicate tissue damage.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>乳酸脱氢酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased lactic dehydrogenase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002291 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002291">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000720"/>
        <purl:Definition>Slightly increased alkaline phosphatase AE is a blood alkaline phosphatase increased AE that shows elevated levels of alkaline phosphatase slightly.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>碱性磷酸酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased alkaline phosphatase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002292 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000656"/>
        <purl:Definition>Slightly increased glutamic-oxalacetic transaminase AE is a aspartate aminotransferase level increased AE that shows a slightly increased amount of glutamic-oxalacetic transaminase in the heart and liver.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>谷草转氨酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased glutamic-oxalacetic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002293 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000272"/>
        <purl:Definition>Slightly increased glutamic pyruvic transaminase AE is a alanine aminotransferase level increased AE that shows eelevated levels of glutamic pyruvic transaminase in the liver.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>谷丙转氨酶轻度升高</obo1:OAE_0001849>
        <rdfs:label>slightly increased glutamic pyruvic transaminase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002294 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001791"/>
        <purl:Definition>Transient ischemic stroke AE is a ischemic stroke AE that occurs when a blood vessel that supplies the brain becomes blocked or &quot;clogged&quot; and impairs blood flow to part of the brain.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>暂时性缺血性中风</obo1:OAE_0001849>
        <rdfs:label>transient ischemic stroke AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002295 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001025"/>
        <purl:Definition>Evidently increased hepatic lipase AE is a hepatic enzyme increased AE that shows an evidently increase in amount of hepatic enzyme in body, commonly includes ALT and AST. It may indicate inflammation or damage to liver cells.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>肝酶显著增加</obo1:OAE_0001849>
        <rdfs:label>evidently increased hepatic lipase AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002296 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Mild decline in blood pressure AE is a hypotension AE that shows mild sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血压轻度下降</obo1:OAE_0001849>
        <rdfs:label>mild decline in blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002297 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000802"/>
        <purl:Definition>Transient cerebral ischemic attacks AE is a cerebral ischemia AE that shows the sudden death of brain cells in a localized area due to inadequate blood flow.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>短暂脑缺血发作</obo1:OAE_0001849>
        <rdfs:label>transient cerebral ischemic attacks AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Transient hypotension AE is a hypotension AE that shows transient sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬时低血压</obo1:OAE_0001849>
        <rdfs:label>transient hypotension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002299 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002299">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Obviously decreased blood pressure AE is a hypotension AE that shows obviously sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>significantly decreased blood pressure AE</obo1:IAO_0000118>
        <obo1:OAE_0001849>血压明显下降</obo1:OAE_0001849>
        <rdfs:label>obviously decreased blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000388"/>
        <purl:Definition>Transient dizzy AE is a dizziness AE that shows transient dizziness.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>瞬时头晕</obo1:OAE_0001849>
        <rdfs:label>transient dizzy AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002301 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002301">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001463"/>
        <purl:Definition>Short-time hepatic function disorder AE is a hepatic function abnormal AE that shows a short-time abnormal functionality of the liver.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>短暂肝功能异常</obo1:OAE_0001849>
        <rdfs:label>short-time hepatic function disorder AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002302 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000729"/>
        <purl:Definition>A slightly elevated plasma creatinine level AE is a blood creatinine level increased AE that shows an slightly increased level of creatinine in the blood (due to lack of kidney activity).</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血浆肌酐水平的轻微升高</obo1:OAE_0001849>
        <rdfs:label>a slightly elevated plasma creatinine level AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Sudden fall of blood pressure AE is a hypotension AE that shows sudden sustained low blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>血压突然降低</obo1:OAE_0001849>
        <rdfs:label>sudden fall of blood pressure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002304 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000551"/>
        <purl:Definition>Severe hypertension AE is a hypotension AE that shows severe sustained high blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>严重高血压</obo1:OAE_0001849>
        <rdfs:label>severe hypertension AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000660"/>
        <purl:Definition>Severe arrhythmia AE is an arrhythmia AE that shows severe abnormal heart rhythm.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>严重心律失常</obo1:OAE_0001849>
        <rdfs:label>severe arrhythmia AE</rdfs:label>
    </owl:Class>
    


