        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#DatavaluedPropertyAtom"/>
                        <swrl:propertyPredicate rdf:resource="https://bioportal.bioontology.org/ontologies/FASTO/Meal.insulinUnitsForCarbs"/>
                        <swrl:argument1 rdf:resource="urn:swrl#meal"/>
                        <swrl:argument2 rdf:resource="urn:swrl#n2"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/2003/11/swrl#AtomList"/>
