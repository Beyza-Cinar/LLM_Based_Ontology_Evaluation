    <!-- http://hl7.org/fhir/procedureRequest -->

    <owl:Class rdf:about="http://hl7.org/fhir/procedureRequest">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/carePlanQuality"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.basedOn"/>
                        <owl:someValuesFrom rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0000044"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.code"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.performer"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/practitioner"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.status"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/planStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.subject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.bodySite"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.category"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.context"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://hl7.org/fhir/encounter"/>
                                    <rdf:Description rdf:about="http://hl7.org/fhir/episodeOfCare"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.note"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.priority"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/priority"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.reasonCode"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.reasonReference"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://hl7.org/fhir/observationValue"/>
                                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/condition"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.occurrenceDateTime"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.occurrencePeriod"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/ProcedureRequest.occurrenceTiming"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/timing"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


