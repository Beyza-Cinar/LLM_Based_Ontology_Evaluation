    <!-- http://purl.obolibrary.org/obo/DDO.owl#OGMS_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/DDO.owl#OGMS_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://hl7.org/fhir/hasCode"/>
                <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo1:IAO_0000115>A quality of a patient that is observed by the patient or a processual entity experienced by the patient, either of which is hypothesized by the patient to be a realization of a disease.</obo1:IAO_0000115>
        <obo1:IAO_0000116>note: defined class</obo1:IAO_0000116>
        <obo1:IAO_0000119>http://ontology.buffalo.edu/medo/Disease_and_Diagnosis.pdf</obo1:IAO_0000119>
        <rdfs:label>symptom</rdfs:label>
    </owl:Class>
    


