                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.method"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.performer"/>
                        <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/ssn/person"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Observation.referenceRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/ObservationReferenceRangeComponent"/>
                    </owl:Restriction>
