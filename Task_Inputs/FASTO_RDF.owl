        <purl:Definition>Abnormal leucocyte neutrophil AE is a neutrophil percentage abnormal AE that shows abnormal leucocyte neutrophil.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>嗜中性白细胞异常</obo1:OAE_0001849>
        <rdfs:label>abnormal leucocyte neutrophil AE</rdfs:label>
    </owl:Class>
    


