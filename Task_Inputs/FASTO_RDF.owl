    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0001055 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000588"/>
        <purl:Definition>a hematopoietic system AE that has an outcome of low calcium levels,  can present with convulsions, arrythmias, tetany and numbness</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hypocalcaemia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/hypocalcemia</obo1:IAO_0000119>
