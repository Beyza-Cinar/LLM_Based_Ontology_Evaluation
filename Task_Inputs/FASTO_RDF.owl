    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <purl:Definition>an injection-site AE that displays injection-site cellulitis, or red, hot, swollen, tender, or painful skin at the site of injection</purl:Definition>
