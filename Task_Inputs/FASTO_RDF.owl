    <!-- http://purl.obolibrary.org/obo/OAE_0000361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000624"/>
        <purl:Definition>an abnormal body temperature AE which has an outcome of fever</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>body temperature increased AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>febrile response</obo1:IAO_0000118>
        <obo1:IAO_0000118>pyrexia AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>Axelrod YK1, Diringer MN. Temperature management in acute neurologic disorders. Neurol Clin. 2008 May;26(2):585-603, xi. doi: 10.1016/j.ncl.2008.02.005. PMID: 18514828.</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Pyrexia</obo1:IAO_0000119>
        <rdfs:comment>Fever is a frequent medical sign that describes an increase in internal body temperature to levels above normal. Fever is characterized as a temporary elevation in the body&apos;s thermoregulatory set-point, usually by about 1-2 °F).</rdfs:comment>
        <rdfs:label>fever AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10005911</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10037660</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000362 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000362">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event that has the outcome of rash</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>A rash is a change of the skin which affects its color, appearance, or texture. A rash may be localized in one part of the body, or affect all the skin. Rashes may cause the skin to change color, itch, become warm, bumpy, dry, cracked or blistered, swell and may be painful.</rdfs:comment>
        <rdfs:label>rash AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000988</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10037844</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10037844</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10037844</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0015230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000363 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000363">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an adverse event that displays a pathogen infection.</purl:Definition>
        <obo1:IAO_0000116>change of name from &apos;infection adverse event&apos; to &apos;infectious adverse event&apos; on 09/23/13 for a better clinical relevance, move &apos;infection adverse event&apos; as an alternative term - SS</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>infectious adverse event</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/infection</obo1:IAO_0000119>
        <rdfs:label>infection AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10021789</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000364 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000364">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>An AE that has an outcome of syndrome. Syndrome is the association of several clinically recognizable features, signs (observed by a physician), symptoms (reported by the patient), phenomena or characteristics that often occur together, so that the presence of one feature alerts the physician to the presence of the others.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of emotional state of excitement or restlessness</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>agitation AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000711</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10001497</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085631</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000366 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000366">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000226"/>
        <purl:Definition>injection-site AE is an AE that occurs in an injection site (e.g., during vaccination).</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>injection-site reaction</obo1:IAO_0000118>
        <obo1:IAO_0000118>local reaction AE</obo1:IAO_0000118>
        <rdfs:label>injection-site adverse event</rdfs:label>
        <rdfs:seeAlso>MDR: 10022095</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000584"/>
        <purl:Definition>a hypersensitivity AE which has an outcome of injection-site hypersensitivity</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>injection-site hypersensitivity AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000368 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000368">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>an edema AE which occurs at the injection site. In this case, a collection of fluid at the injection site is found.</purl:Definition>
        <obo1:IAO_0000117>YH, RR</obo1:IAO_0000117>
        <obo1:IAO_0000118>injection-site oedema AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>injection-site swelling AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.uptodate.com/contents/edema-swelling-beyond-the-basics</obo1:IAO_0000119>
        <rdfs:label>injection-site edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10053425</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000369 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000369">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that occurs in an injection site of a medical intervention</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>injection-site pain AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022086</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>an inflammation AE which has an outcome of injection-site inflammation</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>injection-site inflammation AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000371 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000371">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of injection-site hemorrhage</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>injection-site hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10022067</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000372 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000372">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000366"/>
        <purl:Definition>an injection-site AE that display an injection-site mass</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>injection site nodule AE</obo1:IAO_0000118>
        <rdfs:comment>injection-site mass is a mass at physical injection site</rdfs:comment>
        <rdfs:label>injection-site mass AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000373 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000373">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event that has an outcome of pruritus</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>itch</obo1:IAO_0000118>
        <obo1:IAO_0000118>itching</obo1:IAO_0000118>
        <obo1:IAO_0000118>pruritus generalised AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/sites/entrez?db=mesh&amp;cmd=DetailsSearch&amp;term=pruritus+generalised&amp;log$=activity</obo1:IAO_0000119>
        <rdfs:comment>Pruritus is an itch (Latin: pruritus), i.e., an unpleasant sensation that evokes the desire or reflex to scratch.</rdfs:comment>
        <rdfs:label>pruritus AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000989</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10037087</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10037087</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0033774</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000374 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000374">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of pain in a patient</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0010833</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0030193</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000375 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000375">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has outcome of myalgia. Myalgia means &quot;muscle pain&quot; and is a symptom of many diseases and disorders.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>muscle pain AE</obo1:IAO_0000118>
        <rdfs:label>myalgia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003326</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10028411</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10028411</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0231528</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000376">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>Urticaria AE is a rash AE notable for dark red, raised, itchy bumps.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>hives</obo1:IAO_0000118>
        <rdfs:label>urticaria AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001025</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10046735</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0042109</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of headache</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>headache AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002315</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0018681</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000378 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000378">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000001"/>
        <purl:Definition>an AE that occurs in respiratory system.</purl:Definition>
        <obo1:IAO_0000116>I created this term and make it to be an umbrella term for different disorder terms related to respiratory system. --Oliver He</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>respiratory system AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001673"/>
        <purl:Definition xml:lang="en">a leukocyte cell number abnormal AE that has an outcome of greater than normal number of leukocytes, or nucleated cells of the myeloid or lymphoid lineages, found in blood or other tissue</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;leukocytosis&apos; is an adverse event that was mentioned in 1,021 VAERS reports (0.8%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>SS, YH, EB</obo1:IAO_0000117>
        <obo1:IAO_0000118>increased leukocyte cell number AE
</obo1:IAO_0000118>
        <obo1:IAO_0000118>leukocytosis AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>white blood cell count increased AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Leukocytosis</obo1:IAO_0000119>
        <rdfs:label>leukocyte cell number increased AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000218</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10024378</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047943</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001673"/>
        <purl:Definition>a leukocyte cell number abnormal AE that has an outcome of reduction in the number of leukocytes, or of nucleated cells of the myeloid or lymphoid lineages, found in blood or other tissue</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;leukopenia&apos; is an adverse event that was mentioned in 417 VAERS reports (0.3%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000118>decreased leukocyte cell number AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>white blood cell count decreased AE</obo1:IAO_0000118>
        <rdfs:label>leukocyte cell number decreased AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000221</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10047942</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000381 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000381">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000493"/>
        <purl:Definition>a cardiovascular disorder AE that has an outcome of abnormal blood pressure, representing altered tension of the blood within the systemic arteries</purl:Definition>
        <rdfs:label>abnormal blood pressure AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000230</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000382 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000382">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000435"/>
        <purl:Definition>a muscle adverse event which has an outcome of asthenia, which is a medical term denoting symptoms of physical weakness and loss of strength.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>asthenia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001324</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003549</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004093</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000375"/>
        <purl:Definition>a muscle pain AE that has an outcome of muscle ache.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>muscle ache AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>A rash AE that shows a flat, red area on the skin overed with small confluent bumps.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Maculopapular_rash</obo1:IAO_0000119>
        <rdfs:label>maculopapular rash AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10037868</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000385">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000442"/>
        <purl:Definition>An joint disorder AE that has an outcome of arthralgia. Arthralgia means joint pain. It is a symptom of injury, infection, illnesses (in particular arthritis) or an allergic reaction to medication. According to MeSH, the term &quot;arthralgia&quot; should only be used when the condition is non-inflammatory, and the term &quot;arthritis&quot; should be used when the condition is inflammatory.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>arthralgia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002829</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10003239</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003862</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000386 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000386">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000362"/>
        <purl:Definition>vesiculobullous rash AE is a rash AE characterized by serous-fluid-filled vesicles (blisters)</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>vesiculobullous rash AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000988</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0151883</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000387 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000387">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000364"/>
        <purl:Definition>a syndrome AE which has an outcome of screaming syndrome</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>screaming syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000388 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000388">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of dizziness</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <rdfs:comment>Dizziness describes a number of subjective symptoms, which the patient may describe as feelings of lightheadedness, floating, wooziness, giddiness, confusion, disorientation or loss of balance. Medical terms include vertigo, disequilibrium, pre-syncope or syncoptic episode. Causes may stem from a variety of failures of equilibrioception, hypotension, cerebral hypoxia or a reaction to environmental chemicals or drugs.</rdfs:comment>
        <rdfs:label>dizziness AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002321</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10013573</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0012833</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000389 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000389">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>peripheral edema AE is an edema AE that results in swelling of tissues, usually in the lower limbs, due to the accumulation of fluids</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>edema peripheral AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>oedema peripheral AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Peripheral_edema</obo1:IAO_0000119>
        <rdfs:label>peripheral edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10030124</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000390 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000390">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of malaise</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Malaise is a feeling of general discomfort or uneasiness, an &quot;out of sorts&quot; feeling. Malaise is often the first indication of an infection or other disease. Vaccination may induce malaise.</rdfs:comment>
        <rdfs:label>malaise AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002321</rdfs:seeAlso>
        <rdfs:seeAlso>MDR: 10025482</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0231218</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000391 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of somnolence</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>drowsiness</obo1:IAO_0000118>
        <rdfs:comment>Somnolence (or &quot;drowsiness&quot;) is a state of near-sleep, a strong desire for sleep, or sleeping for unusually long periods (c.f. hypersomnia).</rdfs:comment>
        <rdfs:label>somnolence AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001262</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10041349</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C2830004</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE that shows a sensation of tingling, pricking, or numbness of a person&apos;s skin with no apparent long-term physical effect.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Paraesthesia</obo1:IAO_0000119>
        <rdfs:comment>Paresthesia is more generally known as the feeling of &quot;pins and needles&quot; or of a limb being &quot;asleep&quot; (although this is not directly related to the phenomenon of sleep). The manifestation of paresthesia may be transient or chronic.</rdfs:comment>
        <rdfs:label>paresthesia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10033775</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of abnormal crying in a patient</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>crying abnormal AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011469</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000394 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000394">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of chills</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>feeling cold AE</obo1:IAO_0000118>
        <rdfs:comment>Chills refers to feeling cold after an exposure to a cold environment. The word can also refer to an episode of shivering, accompanied by paleness and feeling cold.</rdfs:comment>
        <rdfs:label>chills AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001945</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10008531</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085593</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000395 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000395">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of stupor</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:comment>Stupor is the lack of critical cognitive function and level of consciousness wherein a sufferer is almost entirely unresponsive and only responds to base stimuli such as pain. The word derives from the Latin stupure, meaning insensible. Being characterised by impairments of reactions to external stimuli, in this case, vaccine immunization.</rdfs:comment>
        <rdfs:label>stupor AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0004372</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10042264</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0085628</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000574"/>
        <purl:Definition>a gustatory system AE which has an outcome of anorexia, which is the decreased sensation of appetite.</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>anorexia nervosa</obo1:IAO_0000118>
        <obo1:IAO_0000118>decreased appetite AE</obo1:IAO_0000118>
        <rdfs:label>anorexia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002039</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002649</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10061428</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003123</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000397 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000397">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000556"/>
        <purl:Definition>face edema AE is an edema AE that results in facial swelling, the build-up of fluid in the tissues of the face. Swelling may also affect the neck and upper arms</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>face oedema AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB:http://www.nlm.nih.gov/medlineplus/ency/article/003105.htm</obo1:IAO_0000119>
        <obo1:IAO_0000119>swelling face</obo1:IAO_0000119>
        <rdfs:label>face edema AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10016029</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10042682</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000571"/>
        <purl:Definition>cough increased AE is an abnormal respiration AE that results in a reflex that keeps your throat and airways clear</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>cough</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/cough</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://www.nlm.nih.gov/medlineplus/cough.html</obo1:IAO_0000119>
        <rdfs:label>cough increased AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10011224</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000399 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000399">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000490"/>
        <purl:Definition>a syndrome AE that has an outcome of a flu syndrome AE and occurs after a medical intervention.  </purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>flu-like symptom AE</obo1:IAO_0000118>
        <rdfs:label>flu syndrome AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000400 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000400">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000582"/>
        <purl:Definition>a sensory capability AE that has an outcome of loss of consciousness, fainting</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>Syncope is the medical term for fainting, a sudden, usually temporary, loss of consciousness.</obo1:IAO_0000118>
        <obo1:IAO_0000118>fainting</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Syncope_%28medicine%29</obo1:IAO_0000119>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Unconsciousness</obo1:IAO_0000119>
        <rdfs:label>syncope AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001279</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10042772</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10024855</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0039070</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000543"/>
        <purl:Definition>a skin adverse event that has an outcome of sweating</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;sweating&apos; is an adverse event that was mentioned in 2,301 VAERS reports (1.8%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>sweating AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000975</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0038990</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;abdominal pain&apos; is an adverse event that was mentioned in 2,254 VAERS reports (1.8%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Abdominal_pain</obo1:IAO_0000119>
        <rdfs:comment>a pain AE that is observed in abdominal cavity</rdfs:comment>
        <rdfs:label>abdominal pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002027</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10000081</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0000737</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000403 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000403">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000381"/>
        <purl:Definition>an abnormal blood pressure AE that has an outcome of sustained high blood pressure at a level that is likely to result in cardiovascular disease and/or other pathological states</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>blood pressure increased</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://www.ncbi.nlm.nih.gov/pubmed/21722707</obo1:IAO_0000119>
        <rdfs:label>hypertension AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000822</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000231</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10005750</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10020772</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0020538</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000404 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000404">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000782"/>
        <purl:Definition>a cardiac valve disease AE that is characterized by a condition of the heart in which the aortic valve, located between the aorta and left ventricle of the heart, is norrower than normal size</purl:Definition>
        <obo1:IAO_0000117>SS</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/aortic+valve+stenosis</obo1:IAO_0000119>
        <rdfs:label>aortic valve stenosis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0005173</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10002918</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003507</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000405 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000405">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <purl:Definition>a muscular weakness AE that has an outcome of myasthenia. Myasthenia represenats myasthenia gravis, a neuromuscular disease leading to fluctuating muscle weakness and fatiguability.</purl:Definition>
        <obo1:IAO_0000117>YH, SS</obo1:IAO_0000117>
        <obo1:IAO_0000118>myasthenia gravis</obo1:IAO_0000118>
        <obo1:IAO_0000118>myasthenia syndrome AE</obo1:IAO_0000118>
        <obo1:IAO_0000118>myasthenic syndrome AE</obo1:IAO_0000118>
        <rdfs:label>myasthenia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001324</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0947912</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of chest pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;chest pain&apos; was mentioned in 1,752 VAERS reports (1.4%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>chest pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001681</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10008479</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0008031</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000407 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000407">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000162"/>
        <purl:Definition>a sensory neuropathy AE which has an outcome of sensory axonal characterized by damage to axonas of the peripheral nervous system (PNS)</purl:Definition>
        <obo1:IAO_0000117>AG, YH</obo1:IAO_0000117>
        <rdfs:label>sensory axonal AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000408 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000408">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000578"/>
        <purl:Definition xml:lang="en">an abnormal vision AE characterised by leakage of fluid under the retina causing visual impairment, usually in one eye. </purl:Definition>
        <obo1:IAO_0000117>SJ, YH
</obo1:IAO_0000117>
        <obo1:IAO_0000118>central serous chorioretinopathy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Central_serous_retinopathy</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">central serous retinopathy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10063118</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of twitching, an involuntary sudden movement of part of the body.</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;twitching&apos; is an adverse event that was mentioned in 1,511 VAERS reports (1.2%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>twitching AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000410 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000410">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000579"/>
        <purl:Definition>a seizure AE that has an outcome of febrile seizure</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>febrile seizure AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000411 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000411">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000378"/>
        <purl:Definition>a respiratory system AE which has an outcome of asthma</purl:Definition>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>哮喘</obo1:OAE_0001849>
        <rdfs:comment>Asthma is a common chronic lung disease. It has been defined by the National Heart, Lung and Blood Institute as a common chronic disorder of the airways that is complex and characterized by variable and recurring symptoms, airflow obstruction, bronchial hyperresponsiveness (bronchospasm), and an underlying inflammation.</rdfs:comment>
        <rdfs:label>asthma AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0002099</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003553</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004096</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of neck pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;neck pain&apos; was mentioned in 1,323 VAERS reports (1.0%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>neck pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003418</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007859</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000413">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000596"/>
        <purl:Definition>an arthritis AE that has an outcome of inflammation of a joint, resulting from infectious agents, such as bacteria and viruses</purl:Definition>
        <obo1:IAO_0000117>DJ, SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://www.rightdiagnosis.com/i/infectious_arthritis/intro.htm</obo1:IAO_0000119>
        <rdfs:label>arthritis infective AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003095</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10060968</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0003869</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000414">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000374"/>
        <purl:Definition>a pain AE that has an outcome of back pain</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;back pain&apos; was mentioned in 1,277 VAERS reports (1.0%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>back pain AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003418</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10003988</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0004604</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000200"/>
        <purl:Definition>a hair AE that has an outcome of alopecia and occurs after a medical intervention.  </purl:Definition>
        <obo1:IAO_0000119>VAE</obo1:IAO_0000119>
        <rdfs:comment>alopecia means the absence of hair or loss of hair. It is not usually in reference to primary genetic hairlessness but may be due to dietary, stress, secondary to immune condition.</rdfs:comment>
        <rdfs:label>alopecia AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0001596</rdfs:seeAlso>
        <rdfs:seeAlso>MP: MP_0000414</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10001760</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0002170</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000427"/>
        <purl:Definition>a hemorrhage AE that has an outcome of gastrointestinal hemorrhage</purl:Definition>
        <obo1:IAO_0000118>gastrointestinal haemorrhage AE</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://medical-dictionary.thefreedictionary.com/gastrointestinal+hemorrhage</obo1:IAO_0000119>
        <rdfs:comment>bleeding in the stomach and/or the intestines</rdfs:comment>
        <rdfs:label>gastrointestinal hemorrhage AE</rdfs:label>
        <rdfs:seeAlso>MP: MP_0000465</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10017955</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000417 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000417">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000581"/>
        <purl:Definition>a movement disorder AE that has an outcome of eyes gaze upward</purl:Definition>
        <obo1:IAO_0000116>According to the Vaccine Adverse Event Reporting System (VAERS),  &apos;eyes gaze upward&apos; was mentioned in 1,249 VAERS reports (1.0%) during1991-2001 (Reference: PMID: 12825543).</obo1:IAO_0000116>
        <obo1:IAO_0000117>YH</obo1:IAO_0000117>
        <rdfs:label>eyes gaze upward AE</rdfs:label>
    </owl:Class>
    


