        <purl:Definition>Mild nausea AE is a nausea AE that shows mild nausea.</purl:Definition>
        <obo1:IAO_0000117>JX, LW, YH</obo1:IAO_0000117>
        <obo1:OAE_0001849>轻度恶心</obo1:OAE_0001849>
        <rdfs:label>mild nausea AE</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002319 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002319">
