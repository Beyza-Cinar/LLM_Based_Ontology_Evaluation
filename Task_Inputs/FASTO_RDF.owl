    <!-- http://purl.obolibrary.org/obo/OAE_0000294 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000487"/>
        <purl:Definition>Henoch-Schonlein purpura AE is a purpura AE, a systemic vasculitis (inflammation of blood vessels) characterized by deposition of immune complexes containing the antibody IgA  in the skin  and kidney. This results from some allergic response,</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>allergic purpura, anaphylactoid purpura, vascular purpura</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Henoch-Schonlein_purpura</obo1:IAO_0000119>
        <rdfs:label>Henoch-Schonlein purpura AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0000979</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA ID: 10019617</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0034152</rdfs:seeAlso>
    </owl:Class>
    


