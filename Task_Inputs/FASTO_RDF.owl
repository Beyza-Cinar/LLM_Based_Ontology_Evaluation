        <metadata:prefixIRI>DDO:OGMS_0000056</metadata:prefixIRI>
        <obo1:IAO_0000115>A measurement assay that has as input a patient-derived specimen, and as output a result that represents a quality of the specimen.</obo1:IAO_0000115>
        <obo1:IAO_0000119>http://ontology.buffalo.edu/medo/Disease_and_Diagnosis.pdf</obo1:IAO_0000119>
        <rdfs:label>laboratory test</rdfs:label>
    </owl:Class>
    


