    <!-- http://hl7.org/fhir/timing -->

    <owl:Class rdf:about="http://hl7.org/fhir/timing">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/element"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.code"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.event"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/dateTime"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.boundsDuration"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/duration"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.boundsPeriod"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/period"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.boundsRange"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/range"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.count"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.countMax"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.dayOfWeek"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/code"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.duration"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.durationMax"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.durationUnit"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/code"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.frequency"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.frequencyMax"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/integer"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.offset"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/unsignedInt"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.period"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.periodMax"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/decimal"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.periodUnit"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/code"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.timeOfDay"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/time"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Timing.repeat.when"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/code"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment>Specifies an event that may occur multiple times. Timing schedules are used for specifying when events are expected or requested to occur, and may also be used to represent a schedule that was followed for past events. A Timing schedule can be a list of events and/or criteria for when the event happens, which can be expressed in a structured form and/or as a code. When both event and a repeating specification are provided, the list of events should be understood as an interpretation of the information in the repeat structure.</rdfs:comment>
    </owl:Class>
    


