    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000197"/>
        <purl:Definition>Local tissue necrosis AE is a necrosis AE that shows local tissue necrosis.</purl:Definition>
