        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001570"/>
        <purl:Definition>a cardiac and vascular investigation result abnormal AE that is an abnormal result of a test that uses sound waves to create a moving picture of the heart</purl:Definition>
