    <!-- https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661 -->

    <owl:Class rdf:about="https://bioportal.bioontology.org/ontologies/FTDM.owl#DMTO_0001661">
        <rdfs:subClassOf rdf:resource="http://hl7.org/fhir/carePlanQuality"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.description"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.status"/>
                        <owl:someValuesFrom rdf:resource="http://hl7.org/fhir/goalStatus"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.addresses"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://hl7.org/fhir/medicationRequest"/>
                                    <rdf:Description rdf:about="http://hl7.org/fhir/nutritionOrder"/>
                                    <rdf:Description rdf:about="http://hl7.org/fhir/observationValue"/>
                                    <rdf:Description rdf:about="http://hl7.org/fhir/procedureRequest"/>
                                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/condition"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.category"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.expressedBy"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/practitioner"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.outcomeCode"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.outcomeReference"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/observationValue"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.priority"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/codeableConcept"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.statusDate"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/date"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.statusReason"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/string"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.subject"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/DDO.owl#DDO_0000111"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.target"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/goalTargetComponent"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Resource.Id"/>
                        <owl:allValuesFrom rdf:resource="http://hl7.org/fhir/identifier"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://hl7.org/fhir/Goal.startCodeableConcept"/>
