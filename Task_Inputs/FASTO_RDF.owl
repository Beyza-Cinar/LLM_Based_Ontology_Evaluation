        <rdfs:domain rdf:resource="http://www.w3.org/ns/ssn/system"/>
        <rdfs:range rdf:resource="https://bioportal.bioontology.org/ontologies/FTDM.owl#node"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/ssn/hasUnitOfMeasurement -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/ssn/hasUnitOfMeasurement">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/ssn/sensor_related_property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/measurmentProperty"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/ssn/sensedObservationValue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://unitsofmeasure.org/unitOfMeasure"/>
    </owl:ObjectProperty>
    


