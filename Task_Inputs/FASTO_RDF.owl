    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000557"/>
        <purl:Definition>cellulitis AE is an inflammation AE that is a diffuse inflammation of connective tissue with severe inflammation of dermal and subcutaneous layers of the skin</purl:Definition>
        <obo1:IAO_0000117>SS, YH</obo1:IAO_0000117>
        <obo1:IAO_0000119>WEB: http://en.wikipedia.org/wiki/Cellulitis</obo1:IAO_0000119>
        <rdfs:label>cellulitis AE</rdfs:label>
        <rdfs:seeAlso>HPO: HP_0003553</rdfs:seeAlso>
        <rdfs:seeAlso>MedDRA: 10007882</rdfs:seeAlso>
        <rdfs:seeAlso>SIDER: C0007642</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0000305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000580"/>
        <purl:Definition>a behavior and neurological AE that has an outcome of a type of perspiration usually associated with anxiety or fear</purl:Definition>
