        <rdfs:label xml:lang="en">allodynia AE</rdfs:label>
        <rdfs:seeAlso>MedDRA ID: 10053552</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002346 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0001744"/>
        <purl:Definition>an embolism AE in which amniotic fluid, fetal cells, hair or other debris enter the maternal circulation resulting in cardiorespiratory collapse</purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
        <obo1:IAO_0000118>Anaphylactoid Syndrome of Pregnancy</obo1:IAO_0000118>
        <obo1:IAO_0000119>WEB: http://emedicine.medscape.com/article/253068-overview</obo1:IAO_0000119>
        <rdfs:label xml:lang="en">amniotic fluid embolism AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10001977</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002347 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000333"/>
        <purl:Definition>a muscular weakness AE that has an outcome of weakness followed by wasting of muscles, and excruciating pain in the muscles of the thigh, hip, and buttocks</purl:Definition>
        <obo1:IAO_0000117>YH, SJ</obo1:IAO_0000117>
        <obo1:IAO_0000118>diabetic lumbosacral radiculoplexus neuropathy</obo1:IAO_0000118>
        <obo1:IAO_0000118>diabetic polyradiculoneuropathy</obo1:IAO_0000118>
        <obo1:IAO_0000118>proximal diabetic neuropathy</obo1:IAO_0000118>
        <rdfs:label xml:lang="en">diabetic amyotrophy AE</rdfs:label>
        <rdfs:seeAlso>MedDRA: 10002027</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OAE_0002348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0002348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000005"/>
        <purl:Definition>an adverse drug event that results in unexpected and unwanted events due to anesthetic drug treatment </purl:Definition>
        <obo1:IAO_0000117>SJ, YH</obo1:IAO_0000117>
