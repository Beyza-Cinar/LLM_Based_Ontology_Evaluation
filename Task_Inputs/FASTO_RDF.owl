    <!-- http://purl.obolibrary.org/obo/OAE_0001383 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OAE_0001383">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OAE_0000570"/>
        <purl:Definition>a nervous system AE that results in the sciatic nerve losing its sensory capabilities</purl:Definition>
